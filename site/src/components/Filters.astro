---
interface Props {
  countries: string[];
  levels: string[];
  tuitionMax: number;
}

const { countries, levels, tuitionMax } = Astro.props;
---

<form class="filters" id="catalog-filters" autocomplete="off">
  <div class="filters__row">
    <label class="filters__field filters__field--grow">
      <span class="filters__label">Поиск</span>
      <input type="search" name="q" placeholder="Например, Oxford" />
    </label>

    <label class="filters__field">
      <span class="filters__label">Страна</span>
      <select name="country">
        <option value="">Все</option>
        {countries.map((country) => <option value={country}>{country}</option>)}
      </select>
    </label>
  </div>

  <div class="filters__row">
    <fieldset class="filters__field filters__field--grow">
      <legend class="filters__label">Уровень</legend>
      <div class="filters__chips">
        {levels.map((level) => (
          <label class="filters__chip">
            <input type="checkbox" name="level" value={level} />
            <span>{level}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <label class="filters__field">
      <span class="filters__label">Стоимость до (год)</span>
      <input
        type="range"
        name="maxTuition"
        min="0"
        max={tuitionMax}
        step="1000"
        value={tuitionMax}
      />
      <output name="maxTuitionOut" class="muted">{tuitionMax.toLocaleString('ru-RU')}</output>
    </label>

    <label class="filters__field">
      <span class="filters__label">IELTS не выше</span>
      <input type="number" name="maxIelts" min="0" max="9" step="0.5" placeholder="9" />
    </label>

    <label class="filters__field filters__field--inline">
      <input type="checkbox" name="hasScholarship" />
      <span>Только со стипендией</span>
    </label>

    <button type="reset" class="btn btn-ghost filters__reset">Сбросить</button>
  </div>
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    margin-bottom: var(--space-6);
  }

  .filters__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4);
  }

  .filters__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 180px;
    border: none;
    margin: 0;
    padding: 0;
  }

  .filters__field--grow {
    flex: 1 1 240px;
  }

  .filters__field--inline {
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    min-width: auto;
  }

  .filters__label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .filters input[type='search'],
  .filters input[type='number'],
  .filters select {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font: inherit;
    background: var(--color-bg);
  }

  .filters input[type='range'] {
    width: 100%;
  }

  .filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filters__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    cursor: pointer;
    font-size: 0.9rem;
  }

  .filters__chip input {
    accent-color: var(--color-primary);
  }

  .filters__reset {
    align-self: end;
  }
</style>
