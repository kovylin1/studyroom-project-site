                {maxScholarshipApprox > 0 && (
                  <div class="calc__card">
                    <span class="calc__scenario calc__scenario--best">{t('lp.calc.scenarioBest')}</span>
                    <h4>{t('lp.calc.cardBestTitle')}</h4>
                    <div class="calc__row"><span>{t('lp.calc.tuitionHousingVisa')}</span><strong>{sym}{(tuitionMin + 7000 + 1200).toLocaleString('en')} · <span data-kzt={String(tuitionMin + 7000 + 1200)}>—</span></strong></div>
                    <div class="calc__row"><span>{t('lp.calc.typicalScholarship')}</span><strong class="calc__highlight">−{sym}{Math.min(maxScholarshipApprox, 4000).toLocaleString('en')} · <span data-kzt={String(-Math.min(maxScholarshipApprox, 4000))}>—</span></strong></div>
                    <div class="calc__row calc__row--total"><span>{t('lp.calc.totalYear')}</span><strong>≈ <span data-kzt={String(tuitionMin + 7000 + 1200 - Math.min(maxScholarshipApprox, 4000))}>—</span></strong></div>
