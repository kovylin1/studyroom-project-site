        <button class="lvl" type="button" data-level="sixth-form">{t('lp.programs.lvlSixthForm')}</button>
        <button class="lvl" type="button" data-level="foundation">{t('lp.programs.lvlFoundation')}</button>
        <button class="lvl" type="button" data-level="bachelor">{t('lp.programs.lvlBachelor')}</button>
        <button class="lvl" type="button" data-level="pathway">{t('lp.programs.lvlPreMaster')}</button>
        <button class="lvl" type="button" data-level="master">{t('lp.programs.lvlMaster')}</button>
