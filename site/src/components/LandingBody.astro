  <section class="section section--alt reveal" id="requirements">
    <div class="wrap">
      <span class="eyebrow">{t('lp.req.eyebrow')}</span>
      <h2>{t('lp.req.title')}</h2>
      <div class="req-grid">
        <div class="req-card">
          <h3 style="margin-top: 0;">{t('lp.req.docsScores')}</h3>
          <ul class="req-list">
            <li>
              <dt>{t('lp.req.diploma')}</dt>
              {u.requirements?.gpa != null ? (
                <b>{u.requirements.gpa.toFixed(1)} / 4.0 (≈{Math.round(u.requirements.gpa / 4 * 100)}%)</b>
              ) : (() => {
                const c = (u.country || '').toLowerCase();
                let hint = t('lp.req.hintGeneric');
                if (/kingdom|britain|england|scotland|wales/.test(c)) hint = t('lp.req.hintUk');
                else if (/states|usa|america/.test(c)) hint = t('lp.req.hintUs');
                else if (/canada/.test(c)) hint = t('lp.req.hintCa');
                else if (/australia|zealand/.test(c)) hint = t('lp.req.hintAu');
                return <b>{hint} <span class="req-hint">{t('lp.req.hintRef')}</span></b>;
              })()}
            </li>
            <li>
              <dt>IELTS</dt>
              {u.requirements?.language?.ielts != null ? (
                <b>{t('lp.req.from')} {u.requirements.language.ielts}</b>
              ) : (
                <b class="req-unconfirmed">{t('lp.req.tbd')}</b>
              )}
            </li>
            {u.requirements?.language?.toefl != null && (
              <li><dt>{t('lp.req.toeflLabel')}</dt><b>{t('lp.req.from')} {u.requirements.language.toefl}</b></li>
            )}
            {u.requirements?.language?.duolingo != null && (
              <li><dt>{t('lp.req.duolingoLabel')}</dt><b>{t('lp.req.from')} {u.requirements.language.duolingo}</b></li>
            )}
            {(() => {
              const entranceExams = (u.requirements?.exams ?? []).filter(
                (e) => !/^(IELTS|TOEFL|PTE|Duolingo|Cambridge|CAE|CPE|TOEIC)/i.test(e),
              );
              return entranceExams.length > 0 && (
                <li>
                  <dt>{t('lp.req.entranceExams')}</dt>
                  <b class="req-exams-wrap">
                    {entranceExams.map((e) => (
                      <span class="req-exam-chip">{e}</span>
                    ))}
                  </b>
                </li>
              );
            })()}
            <li><dt>{t('lp.req.motivation')}</dt><b>{t('lp.req.motivationVal')}</b></li>
            <li><dt>{t('lp.req.recommendations')}</dt><b>{t('lp.req.recommendationsVal')}</b></li>
            <li><dt>{t('lp.req.financial')}</dt><b>{fill('lp.req.financialVal', { amount: `${sym}${Math.max(15000, tuitionMin).toLocaleString('en')}` })}</b></li>
          </ul>
        </div>
        <div class="ielts-help">
          <h4>{fill('lp.req.ieltsHelpTitle', { ielts: u.requirements?.language?.ielts != null ? u.requirements.language.ielts : '6.0' })}</h4>
          <p style="font-size: 14px; color: var(--ink-2);" set:html={fill('lp.req.ieltsHelpText', { ielts: u.requirements?.language?.ielts ?? 5.5 })} />
          {u.requirements?.gpa == null && (
            <p style="font-size: 13px; color: var(--ink-3); margin-top: 8px;">{t('lp.req.gpaNote')}</p>
          )}
          <button class="btn btn--ghost" style="margin-top: 8px;" data-modal-open="lpConsultModal">{t('lp.req.ieltsCta')}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="reviews">
    <div class="wrap">
      <span class="eyebrow">{t('lp.reviews.eyebrow')}</span>
      <h2>{t('lp.reviews.title')}</h2>
      <div class="reviews-stub">
        <strong>{t('lp.reviews.stubStrong')}</strong>
        {t('lp.reviews.stubText')}
      </div>
    </div>
  </section>

