<script is:inline define:vars={{
  PROGRAMS_DATA: programsByFaculty,
  SCHOLARSHIPS_DATA: scholarshipsClean,
  ACCOM_DATA: accom,
  CAMP_DATA: campuses,
  CURRENCY_SYM: sym,
  UNI_NAME: u.name,
  UNI_SLUG: u.slug,
  NEXT_DEADLINE: nextDeadlineIso,
  STR: SCRIPT_STR,
}}>
(() => {
  const $ = (s, root) => (root || document).querySelector(s);
  const $$ = (s, root) => Array.from((root || document).querySelectorAll(s));
  document.body.classList.add('lp-mobile');

  const LEVEL_LABELS = { 'high-school': STR.lvlSchool, 'sixth-form': STR.lvlSixthForm, foundation: STR.lvlFoundation, pathway: STR.lvlPreMaster, master: STR.lvlMaster, bachelor: STR.lvlBachelor, phd: 'PhD', 'english-language': STR.lvlEnglish, 'short-course': STR.lvlShort };
  function levelLabel(level, programType) {
    if (level === 'master' && programType === 'pathway') return STR.lvlPreMaster;
    return LEVEL_LABELS[level] || level;
  }
  function levelClass(level, programType) {
    if (level === 'master' && programType === 'pathway') return 'pathway';
    return level;
  }

  function toast(msg, type) {
    const tray = $('#lpToast');
    if (!tray) return;
    const el = document.createElement('div');
    el.className = 'toast toast--' + (type || 'info');
    el.textContent = msg;
    tray.appendChild(el);
    setTimeout(() => { el.classList.add('is-out'); setTimeout(() => el.remove(), 250); }, 3000);
  }

  function fmtKzt(n) {
    if (Math.abs(n) >= 1000000) return (n/1000000).toFixed(2).replace('.',',') + ' ' + STR.kztMln;
    if (Math.abs(n) >= 1000) return Math.round(n/1000) + ' ' + STR.kztThou;
    return Math.round(n) + ' ₸';
  }

  const pb = $('#lpProgress');
  if (pb) {
    const h = document.documentElement;
    let maxScroll = h.scrollHeight - h.clientHeight;
    let ticking = false;
    const recalc = () => { maxScroll = h.scrollHeight - h.clientHeight; };
    window.addEventListener('resize', recalc, { passive: true });
    window.addEventListener('load', recalc, { passive: true });
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        pb.style.width = (maxScroll > 0 ? (h.scrollTop / maxScroll) * 100 : 0) + '%';
        ticking = false;
      });
    }, { passive: true });
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
  }, { threshold: .15 });
  $$('.reveal').forEach(el => io.observe(el));

  const navIo = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        $$('#lpNav a').forEach(a => a.classList.toggle('is-active', a.dataset.section === id));
      }
    });
  }, { threshold: .3, rootMargin: '-100px 0px -50% 0px' });
  ['money','programs','requirements','living','dates'].forEach(id => {
    const el = document.getElementById(id);
    if (el) navIo.observe(el);
  });

  const burger = $('#lpBurger');
  const drawer = $('#lpDrawer');
  const overlay = $('#lpDrawerOverlay');
  function toggleDrawer(open) {
    if (!drawer) return;
    drawer.classList.toggle('is-open', open);
    overlay.classList.toggle('is-open', open);
    burger.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  }
  if (burger) burger.addEventListener('click', () => toggleDrawer(!drawer.classList.contains('is-open')));
  if (overlay) overlay.addEventListener('click', () => toggleDrawer(false));
  $$('#lpDrawer a').forEach(a => a.addEventListener('click', () => toggleDrawer(false)));

  const facultyNames = Object.keys(PROGRAMS_DATA);
  let currentFaculty = facultyNames[0];
  let currentLevel = 'all';
  let modalLevel = 'all';

  function matchesLevel(p, lvl) {
    if (lvl === 'all') return true;
    if (lvl === 'pathway') return p.level === 'master' && p.programType === 'pathway';
    if (lvl === 'master') return p.level === 'master' && p.programType !== 'pathway';
    return p.level === lvl;
  }

  function filterByLevel(list, lvl) { return list.filter(p => matchesLevel(p, lvl)); }

  function esc(s) { return String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
  function progMeta(p) {
    const bits = [];
    if (p.durationYears) bits.push('<span class="program-row__chip">' + p.durationYears + ' ' + STR.yearsWord + '</span>');
    if (p.language) bits.push('<span class="program-row__chip">' + esc(p.language) + '</span>');
    if (p.intakes && p.intakes.length) bits.push('<span class="program-row__chip program-row__chip--intake">' + STR.intakesWord + ' ' + esc(p.intakes.slice(0, 3).join(', ')) + '</span>');
    if (p.unverified) bits.push('<span class="program-row__chip program-row__chip--unverified">' + STR.unverifiedWord + '</span>');
    return bits.length ? '<div class="program-row__meta">' + bits.join('') + '</div>' : '';
  }
  function progTitle(p) {
    return p.programUrl
      ? '<a class="program-row__title" href="' + esc(p.programUrl) + '" target="_blank" rel="noopener">' + p.title + '</a>'
      : '<div class="program-row__title">' + p.title + '</div>';
  }

  function renderProgramsCards(facultyKey, lvl) {
    const grid = $('#lpProgramsGrid');
    if (!grid) return;
    const all = PROGRAMS_DATA[facultyKey] || [];
    const CAP = 24;
    const matched = filterByLevel(all, lvl);
    const shown = matched.slice(0, CAP);
    // Surface the full count: when the grid is truncated, the "show all" button
    // names how many more there are and opens the searchable modal. Hidden when
    // nothing is hidden, so it never lies about completeness.
    const showAllBtn = $('#lpShowAllPrograms');
    if (showAllBtn) {
      if (matched.length > CAP) {
        showAllBtn.textContent = STR.showAllCount.replace('{count}', String(matched.length));
        showAllBtn.hidden = false;
      } else {
        showAllBtn.hidden = true;
      }
    }
    if (!shown.length) {
      grid.innerHTML = '<div class="programs-empty">' + STR.programsEmpty + '</div>';
      return;
    }
    grid.innerHTML = shown.map(p => `
      <div class="program-row" data-prog-level="${p.level}" data-prog-type="${p.programType || ''}">
        <div>
          <span class="program-row__level program-row__level--${levelClass(p.level, p.programType)}">${levelLabel(p.level, p.programType)}</span>
          ${progTitle(p)}
          ${progMeta(p)}
        </div>
        <div class="program-row__price">${p.tuition ? CURRENCY_SYM + p.tuition.toLocaleString('en') + STR.perYear : STR.tbd}</div>
      </div>
    `).join('');
  }

  function renderProgramsModal(facultyKey, lvl, q) {
    q = q || '';
    const list = filterByLevel(PROGRAMS_DATA[facultyKey] || [], lvl);
    const filtered = q ? list.filter(p => p.title.toLowerCase().includes(q.toLowerCase())) : list;
    const facHead = $('#lpProgramsModalFaculty');
    if (facHead) {
      const lvlLabels = { all: '', foundation: STR.lvlFoundation, bachelor: STR.lvlBachelor, pathway: STR.lvlPreMaster, master: STR.lvlMaster };
      facHead.textContent = facultyKey + (lvl !== 'all' ? ' · ' + (lvlLabels[lvl] || '') : '');
    }
    $$('#lpModalLevelFilter .lvl').forEach(b => b.classList.toggle('is-active', b.dataset.level === lvl));
    const ul = $('#lpProgramList');
    if (!ul) return;
    ul.innerHTML = filtered.length ? filtered.map(p => `
      <li>
        <span class="program-row__level program-row__level--${levelClass(p.level, p.programType)}">${levelLabel(p.level, p.programType)}</span>
        <span>${p.programUrl ? `<a href="${esc(p.programUrl)}" target="_blank" rel="noopener">${p.title}</a>` : p.title}${progMeta(p)}</span>
        <strong style="color: var(--green); white-space: nowrap;">${p.tuition ? CURRENCY_SYM + p.tuition.toLocaleString('en') + STR.perYear : STR.tbd}</strong>
      </li>
    `).join('') : '<li style="grid-template-columns: 1fr; color: var(--ink-3);">' + STR.programsNotFound + '</li>';
  }

  function openProgramsModalFor(facultyKey, lvl) {
    currentFaculty = facultyKey;
    modalLevel = lvl;
    const search = $('#lpProgramSearch');
    if (search) search.value = '';
    renderProgramsModal(currentFaculty, modalLevel, '');
    openModal('lpProgramsModal');
  }

  if (currentFaculty) renderProgramsCards(currentFaculty, currentLevel);

  $$('.tab').forEach(t => {
    t.addEventListener('click', () => {
      $$('.tab').forEach(x => x.classList.remove('is-active'));
      t.classList.add('is-active');
      currentFaculty = t.dataset.faculty;
      renderProgramsCards(currentFaculty, currentLevel);
    });
  });

  $$('#lpLevelFilter .lvl').forEach(b => {
    b.addEventListener('click', () => {
      $$('#lpLevelFilter .lvl').forEach(x => x.classList.remove('is-active'));
      b.classList.add('is-active');
      currentLevel = b.dataset.level;
      renderProgramsCards(currentFaculty, currentLevel);
    });
  });

  $$('#lpModalLevelFilter .lvl').forEach(b => {
    b.addEventListener('click', () => {
      modalLevel = b.dataset.level;
      const search = $('#lpProgramSearch');
      renderProgramsModal(currentFaculty, modalLevel, search ? search.value : '');
    });
  });

  document.addEventListener('click', (e) => {
    const card = e.target.closest('.program-row');
    if (!card) return;
    openProgramsModalFor(currentFaculty, currentLevel);
  });

  const showAllBtn = $('#lpShowAllPrograms');
  if (showAllBtn) showAllBtn.addEventListener('click', () => openProgramsModalFor(currentFaculty, currentLevel));

  const rate = $('#lpRate');
  const rateOut = $('#lpRateOut');
  function applyRate() {
    if (!rate) return;
    const r = +rate.value;
    if (rateOut) rateOut.textContent = r + ' ₸';
    $$('[data-kzt]').forEach(el => {
      const gbp = +el.dataset.kzt;
      el.textContent = fmtKzt(gbp * r);
    });
  }
  if (rate) rate.addEventListener('input', applyRate);
  applyRate();

  const dl = NEXT_DEADLINE ? new Date(NEXT_DEADLINE + 'T00:00:00') : (() => {
    const d = new Date();
    d.setDate(d.getDate() + 47);
    return d;
  })();
  function tickDeadline() {
    const diff = dl - new Date();
    const el = $('#lpDeadline');
    if (!el) return;
    if (diff <= 0) { el.textContent = STR.deadlinePassed; return; }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    el.textContent = d + ' ' + STR.daysShort + ' ' + h + ' ' + STR.hoursShort;
  }
  tickDeadline();
  setInterval(tickDeadline, 60000);

  function openModal(id) {
    const dlg = document.getElementById(id);
    if (!dlg) return;
    if (dlg.showModal) dlg.showModal();
    document.body.classList.add('no-scroll');
  }
  function closeModal(dlg) {
    if (!dlg || !dlg.open) return;
    dlg.close();
    document.body.classList.remove('no-scroll');
  }

  document.addEventListener('click', (e) => {
    const opener = e.target.closest('[data-modal-open]');
    if (opener) {
      e.preventDefault();
      const id = opener.dataset.modalOpen;
      $$('dialog[open]').forEach(d => closeModal(d));
      if (id === 'lpProgramsModal' && currentFaculty) renderProgramsModal(currentFaculty, modalLevel, '');
      openModal(id);
      return;
    }
    const closer = e.target.closest('[data-modal-close]');
    if (closer) closeModal(closer.closest('dialog'));
  });

  $$('dialog').forEach(dlg => {
    dlg.addEventListener('click', (e) => { if (e.target === dlg) closeModal(dlg); });
    dlg.addEventListener('close', () => document.body.classList.remove('no-scroll'));
  });

  const ps = $('#lpProgramSearch');
  if (ps) ps.addEventListener('input', (e) => renderProgramsModal(currentFaculty, modalLevel, e.target.value));

  $$('.scholar').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.scholarshipIdx;
      const s = SCHOLARSHIPS_DATA[i];
      if (!s) return;
      $('#lpSchTitle').textContent = (s.nameRu || s.name) + ' · ' + (s.amount || '');
      $('#lpSchBody').innerHTML = (s.descriptionRu || s.description || ('<p>' + STR.scholarshipDetails + '</p>'))
        + (s.url ? '<p style="margin-top:14px;"><b>' + STR.scholarshipSource + '</b> <a href="' + s.url + '" target="_blank" rel="noopener">' + s.url.replace(/^https?:\/\//, '').replace(/\/$/, '') + '</a></p>' : '');
      openModal('lpScholarshipModal');
    });
  });

  $$('[data-accom-idx]').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.accomIdx;
      const a = ACCOM_DATA[i];
      if (!a) return;
      $('#lpDetailTitle').textContent = a.name || STR.housingFallback;
      $('#lpDetailBody').innerHTML = (a.price ? '<p><b>' + a.price + '</b></p>' : '') + (a.text ? '<p>' + a.text + '</p>' : '');
      openModal('lpDetailModal');
    });
  });

  $$('[data-camp-idx]').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.campIdx;
      const c = CAMP_DATA[i];
      if (!c) return;
      $('#lpDetailTitle').textContent = c.title || STR.campusFallback;
      $('#lpDetailBody').innerHTML = (c.sub ? '<p style="color:var(--green);font-weight:700;text-transform:uppercase;font-size:12px;letter-spacing:.05em;">' + c.sub + '</p>' : '') + (c.text ? '<p>' + c.text + '</p>' : '');
      openModal('lpDetailModal');
    });
  });

  $$('[data-lightbox]').forEach(el => {
    el.addEventListener('click', () => {
      $('#lpLightboxImg').src = el.dataset.lightbox;
      openModal('lpLightbox');
    });
  });

  $$('.faq-item').forEach(item => {
    const head = item.querySelector('.faq-item__head');
    if (!head) return;
    head.addEventListener('click', () => {
      const wasOpen = item.classList.contains('is-open');
      $$('.faq-item').forEach(x => x.classList.remove('is-open'));
      if (!wasOpen) item.classList.add('is-open');
    });
  });

  const chatPanel = $('#lpChatPanel');
  const chatBody = $('#lpChatBody');
  const stickyChatBtn = $('#lpStickyChatBtn');

  function chatOpen() {
    if (chatPanel) chatPanel.classList.add('is-open');
    if (stickyChatBtn) { stickyChatBtn.classList.add('is-hidden'); stickyChatBtn.setAttribute('aria-expanded', 'true'); }
  }
  function chatClose() {
    if (chatPanel) chatPanel.classList.remove('is-open');
    if (stickyChatBtn) { stickyChatBtn.classList.remove('is-hidden'); stickyChatBtn.setAttribute('aria-expanded', 'false'); }
  }
  function chatAddMsg(text, who) {
    if (!chatBody) return;
    const m = document.createElement('div');
    m.className = 'chat-msg chat-msg--' + (who || 'bot');
    const bubble = document.createElement('div');
    bubble.className = 'chat-msg__bubble';
    if (who === 'user') bubble.textContent = text;
    else bubble.innerHTML = text;
    m.appendChild(bubble);
    chatBody.appendChild(m);
    chatBody.scrollTop = chatBody.scrollHeight;
  }
  if (stickyChatBtn) stickyChatBtn.addEventListener('click', () => {
    if (chatPanel && chatPanel.classList.contains('is-open')) chatClose(); else chatOpen();
  });
  const chatCloseBtn = $('#lpChatClose');
  if (chatCloseBtn) chatCloseBtn.addEventListener('click', chatClose);

  const QR = {
    scholarships: { user: STR.qScholarships, bot: SCHOLARSHIPS_DATA.length ? STR.botScholarshipsWith.replace('{uni}', UNI_NAME).replace('{list}', SCHOLARSHIPS_DATA.map(s => '<b>' + (s.nameRu || s.name) + '</b> (' + (s.amount || '—') + ')').join(', ')) : STR.botScholarshipsNone },
    grades: { user: STR.qGrades, bot: STR.botGrades },
    cost: { user: STR.qCost, bot: STR.botCost },
    visa: { user: STR.qVisa, bot: STR.botVisa },
  };

  $$('.chat-quick button').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = QR[btn.dataset.lpq];
      if (!q) return;
      chatAddMsg(q.user, 'user');
      setTimeout(() => chatAddMsg(q.bot, 'bot'), 600);
    });
  });

  const chatInput = $('#lpChatInput');
  if (chatInput) chatInput.addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = e.target.querySelector('input');
    const val = inp.value.trim();
    if (!val) return;
    chatAddMsg(val, 'user');
    inp.value = '';
    setTimeout(() => chatAddMsg(STR.botUser, 'bot'), 800);
  });

  const LEAD_ENDPOINT = '/api/lead';
  const FORM_CONFIG = {
    lpCtaForm:          { type: 'consultation',       name: 'lpname',   phone: 'lpphone',  email: 'lpemail',  roleName: 'lprole', timeName: 'lptime' },
    lpModalConsultForm: { type: 'consultation_modal', name: 'lpmname',  phone: 'lpmphone', email: 'lpmemail', roleName: 'lpmrole', channelName: 'lpmch', timeName: 'lpmt' },
    lpExitForm:         { type: 'guide_pdf',          name: 'lpexname', contact: 'lpexc' },
  };

  function radioLabel(form, name) {
    const r = form.querySelector('input[name="' + name + '"]:checked');
    const lbl = r && r.closest('label');
    const span = lbl && lbl.querySelector('span');
    return span ? span.textContent.trim() : '';
  }

  function handleForm(formId, msg) {
    const form = document.getElementById(formId);
    if (!form) return;
    const cfg = FORM_CONFIG[formId] || {};
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const hp = form.querySelector('input[name="company"]');
      if (hp && hp.value) { form.reset(); toast(msg, 'success'); return; }

      const val = (id) => { const el = id && document.getElementById(id); return el ? el.value.trim() : ''; };
      let phone = val(cfg.phone), email = val(cfg.email);
      const contact = val(cfg.contact);
      if (contact) { if (contact.indexOf('@') >= 0) email = contact; else phone = contact; }

      const payload = {
        name: val(cfg.name),
        phone: phone,
        email: email,
        formType: cfg.type,
        uniSlug: typeof UNI_SLUG !== 'undefined' ? UNI_SLUG : '',
        uniName: typeof UNI_NAME !== 'undefined' ? UNI_NAME : '',
        pageUrl: location.href,
        role: cfg.roleName ? radioLabel(form, cfg.roleName) : '',
        channel: cfg.channelName ? radioLabel(form, cfg.channelName) : '',
        time: cfg.timeName ? radioLabel(form, cfg.timeName) : '',
      };

      if (!payload.name || (!payload.phone && !payload.email)) {
        toast(STR.fillNamePhone, 'error');
        return;
      }

      const btn = form.querySelector('button[type="submit"]') || form.querySelector('button');
      const btnLabel = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = STR.sending; }
      try {
        const res = await fetch(LEAD_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error((data && data.error) || ('HTTP ' + res.status));
        toast(msg, 'success');
        form.reset();
        const dlg = form.closest('dialog');
        if (dlg) setTimeout(() => closeModal(dlg), 800);
      } catch (err) {
        toast(STR.sendError, 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
      }
    });
  }
  handleForm('lpCtaForm', STR.consultOk);
  handleForm('lpModalConsultForm', STR.consultOk);
  handleForm('lpExitForm', STR.guideOk);

  let exitShown = false;
  document.addEventListener('mouseout', (e) => {
    if (exitShown) return;
    if (e.clientY <= 0 && !e.relatedTarget) {
      exitShown = true;
      setTimeout(() => openModal('lpExitModal'), 100);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (chatPanel && chatPanel.classList.contains('is-open')) chatClose();
      if (drawer && drawer.classList.contains('is-open')) toggleDrawer(false);
    }
  });
})();
</script>
