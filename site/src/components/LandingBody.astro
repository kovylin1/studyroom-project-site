        <a class="lp-nav__wa" href={waLink(fill('lp.misc.waGreeting', { uni: u.name }))} aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 2.1.55 4.15 1.6 5.96L2 22l4.27-1.12a9.95 9.95 0 0 0 5.77 1.84c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01A9.83 9.83 0 0 0 12.04 2zM17.4 16.21c-.23.65-1.33 1.24-1.85 1.31-.49.07-1.11.1-1.79-.11-.41-.13-.94-.31-1.62-.6-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.26-.28.57-.35.76-.35.19 0 .38.01.54.01.17 0 .41-.07.64.49.23.56.79 1.96.86 2.1.07.14.12.31.02.49-.09.18-.14.3-.28.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.57.16.28.71 1.18 1.53 1.91 1.06.94 1.95 1.24 2.23 1.38.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.18-.28.37-.23.61-.14.24.09 1.55.73 1.81.86.27.13.44.2.51.31.06.11.06.65-.16 1.29z"/></svg>
        </a>
      </div>
      <button class="lp-burger" id="lpBurger" aria-label={t('lp.nav.menu')}><span></span></button>
    </div>
  </nav>

  <div class="drawer__overlay" id="lpDrawerOverlay"></div>
  <aside class="drawer" id="lpDrawer">
    {hasScholarships && <a href="#money">{t('lp.nav.scholarshipsPrice')}</a>}
    <a href="#programs">{t('lp.nav.programs')}</a>
    <a href="#requirements">{t('lp.nav.requirements')}</a>
    {accom.length > 0 && <a href="#living">{t('lp.nav.livingCampuses')}</a>}
    <a href="#faq">{t('lp.nav.visaDocs')}</a>
    <a href="#dates">{t('lp.nav.dates')}</a>
    <a href={telLink()}>{CONTACTS.phoneDisplay}</a>
    <div class="drawer__lang"><LangSwitcher /></div>
    <div class="drawer__cta"><button class="btn btn--primary" data-modal-open="lpConsultModal">{t('lp.nav.freeConsult')}</button></div>
  </aside>

  <section id="top" class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div>
          <div class="hero__uni-line">
            <span class="hero__logo">
              <img src={`/logos/${u.slug}.png`} alt={u.name} data-fallback={heroLogoFallback} onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback;}else{this.style.display='none';}" />
            </span>
            <span><b>{u.name}</b> · {u.city}, {u.country}</span>
          </div>
          <h1>{fill('lp.hero.title', { uni: u.name })}</h1>
          <p class="hero__lead">{t('lp.hero.lead')}</p>
          <div class="hero__facts">
            <div class="hero__fact">
              <div class="hero__fact-num">{u.requirements?.language?.ielts ? `${t('lp.req.from')} ${u.requirements.language.ielts}` : '5.5+'}</div>
              <div class="hero__fact-label">{t('lp.hero.ieltsLabel')}</div>
            </div>
            <div class="hero__fact">
              <div class="hero__fact-num">{u.programs.length}</div>
              <div class="hero__fact-label">{t('lp.hero.programsAvailable')}</div>
            </div>
            {hasScholarships ? (
              <div class="hero__fact">
                <div class="hero__fact-num">{t('lp.money.titleUpTo').replace('{amount}', `${sym}${maxScholarshipApprox.toLocaleString('en')}`)}</div>
                <div class="hero__fact-label">{t('lp.hero.scholarshipsForeign')}</div>
              </div>
            ) : (
              <div class="hero__fact">
                <div class="hero__fact-num">{tuitionMin > 0 ? `${t('lp.req.from')} ${sym}${tuitionMin.toLocaleString('en')}` : '—'}</div>
                <div class="hero__fact-label">{t('lp.hero.costPerYear')}</div>
              </div>
            )}
          </div>
          <div class="hero__ctas">
            <button class="btn btn--primary btn--lg" data-modal-open="lpConsultModal">{t('lp.hero.ctaChance')}</button>
            <a href="#programs" class="btn btn--ghost btn--lg">{t('lp.hero.ctaPrograms')}</a>
          </div>
          <div class="hero__trust">
            <span class="dot"></span>
            <span set:html={t('lp.hero.curatorOnline')} />
          </div>
        </div>
        {heroPhoto ? (
          <div class="hero__media" role="img" aria-label={fill('lp.hero.mediaAlt', { uni: u.name })} data-lightbox={heroPhoto} style={`background-image: url('${heroPhoto}')`}>
            <div class="hero__media-cap">{fill('lp.hero.mediaCap', { uni: u.name })}</div>
          </div>
        ) : (
          <div class="hero__media hero__media--placeholder"><span>{u.name}</span></div>
        )}
      </div>
      {galleryItems.length >= 4 && (
        <div class="hero__strip">
          {galleryItems.slice(1, 5).map((p: any, i: number) => (
            <div class="hero__strip-tile" data-lightbox={p.img} style={`background-image: url('${p.img}')`}>
              {galleryNotes[i + 1] && (
                <span class="photo-note photo-note--overlay">
                  {galleryNotes[i + 1]!.illustrative ? photoWords.illustrative : galleryNotes[i + 1]!.credit}
                </span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {hasScholarships && (
    <section
      class:list={["section section--alt reveal", moneyBackdrop && "section--photo-bg"]}
      id="money"
      style={moneyBackdrop ? `--photo-bg: url('${moneyBackdrop}')` : undefined}
    >
      <div class="wrap">
        <span class="eyebrow">{t('lp.money.eyebrow')}</span>
        <div class="money">
          <div class="money__head">
            <h2 class="money__title">{t('lp.money.title')}<span>{t('lp.money.titleUpTo').replace('{amount}', `${sym}${maxScholarshipApprox.toLocaleString('en')}`)}</span></h2>
            <p style="max-width: 60ch; color: var(--ink-2); margin: 0;" set:html={t('lp.money.lead')} />
          </div>
          <ul class="scholar-list">
            {scholarshipsClean.map((s, i) => (
              <li class="scholar" data-scholarship-idx={String(i)}>
                <span class="scholar__amount">{s.amount ?? '—'}</span>
                <div>
                  <div class="scholar__name">{s.nameRu ?? s.name}</div>
                  <p class="scholar__desc">{((s.descriptionRu ?? s.description ?? '')).slice(0, 140)}{((s.descriptionRu ?? s.description ?? '')).length > 140 ? '…' : ''}</p>
                  <div class="scholar__more">{t('lp.money.more')}</div>
                </div>
              </li>
            ))}
          </ul>

          {tuitionMin > 0 && (
            <>
              <div class="rate-slider">
                <label for="lpRate">{fill('lp.calc.rateLabel', { currency: u.tuition.currency })}</label>
                <input type="range" id="lpRate" min={String(Math.round(baseRate * 0.9))} max={String(Math.round(baseRate * 1.15))} step="5" value={String(baseRate)} />
                <output id="lpRateOut">{baseRate} ₸</output>
                <span style="font-size: 12px; color: var(--ink-3);">{t('lp.calc.rateHint')}</span>
              </div>

              <div class="calc">
                <div class="calc__card">
                  <span class="calc__scenario calc__scenario--base">{t('lp.calc.scenarioBase')}</span>
                  <h4>{fill('lp.calc.cardBaseTitle', { from: `${sym}${tuitionMin.toLocaleString('en')}` })}</h4>
                  <div class="calc__row"><span>{t('lp.calc.tuition1y')}</span><strong>{sym}{tuitionMin.toLocaleString('en')} · <span data-kzt={String(tuitionMin)}>—</span></strong></div>
                  <div class="calc__row"><span>{t('lp.calc.housing')}</span><strong>{sym}7,000 · <span data-kzt="7000">—</span></strong></div>
                  <div class="calc__row"><span>{t('lp.calc.visaInsurance')}</span><strong>{sym}1,200 · <span data-kzt="1200">—</span></strong></div>
                  <div class="calc__row"><span>{t('lp.calc.studyroomService')}</span><strong class="calc__highlight">0 ₸</strong></div>
                  <div class="calc__row calc__row--total"><span>{t('lp.calc.totalYear')}</span><strong>≈ <span data-kzt={String(tuitionMin + 7000 + 1200)}>—</span></strong></div>
