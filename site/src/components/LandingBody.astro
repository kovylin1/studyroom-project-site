  .lp dialog { border: none; border-radius: 18px; padding: 0; max-width: 720px; width: calc(100vw - 32px); max-height: calc(100vh - 60px); overflow: hidden; box-shadow: var(--shadow-lg); animation: lpModalIn .2s ease; }
  .lp dialog::backdrop { background: rgba(0,0,0,.55); backdrop-filter: blur(4px); }
  @keyframes lpModalIn { from { transform: scale(.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .lp .modal-head { padding: 18px 22px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 12px; position: sticky; top: 0; background: #fff; z-index: 1; }
  .lp .modal-head h3 { margin: 0; font-size: 20px; }
  .lp .modal-close { background: var(--bg-soft); border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: grid; place-items: center; font-size: 20px; line-height: 1; transition: background .15s; }
  .lp .modal-close:hover { background: #e0e0e0; }
  .lp .modal-body { padding: 22px; max-height: calc(100vh - 200px); overflow-y: auto; }
  .lp .modal-foot { padding: 18px 22px; border-top: 1px solid var(--line); display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }
  .lp .program-search { width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; font: inherit; font-size: 15px; margin-bottom: 14px; }
  .lp .program-search:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 3px rgba(0,149,15,.15); }
  .lp .program-list { list-style: none; padding: 0; margin: 0; }
  .lp .program-list li { display: grid; grid-template-columns: 110px 1fr auto; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .lp .program-list li:last-child { border-bottom: none; }
  .lp dialog.lightbox { max-width: 92vw; background: transparent; box-shadow: none; }
  .lp dialog.lightbox::backdrop { background: rgba(0,0,0,.9); }
  .lp dialog.lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 12px; box-shadow: var(--shadow-lg); }
  .lp dialog.lightbox .modal-close { position: absolute; top: 16px; right: 16px; background: rgba(255,255,255,.9); z-index: 2; }
  .lp .toast-tray { position: fixed; top: 20px; right: 20px; z-index: 300; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
  .lp .toast { background: var(--ink); color: #fff; padding: 14px 18px; border-radius: 12px; box-shadow: var(--shadow-lg); display: flex; align-items: center; gap: 10px; font-size: 14px; max-width: 360px; pointer-events: auto; animation: lpToastIn .25s ease; }
  .lp .toast--success { background: var(--green); }
  .lp .toast--error { background: #d23b3b; }
  .lp .toast.is-out { animation: lpToastOut .25s ease forwards; }
  @keyframes lpToastIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes lpToastOut { to { transform: translateX(120%); opacity: 0; } }

  /* ===== mobile (≤640px) — fix overflow, tighten paddings, wrap long names ===== */
  @media (max-width: 640px) {
    .lp .wrap { padding: 0 16px; }
    .lp .section { padding: 40px 0; }
    .lp .btn { padding: 12px 16px; font-size: 13.5px; }
    .lp .btn--lg { padding: 12px 14px; font-size: 13.5px; letter-spacing: -0.005em; }
    .lp .lp-nav__row { gap: 8px; padding-top: 10px; padding-bottom: 10px; }
    .lp .lp-nav__brand { font-size: 16px; margin-right: auto; }
    .lp .lp-burger { width: 36px; height: 36px; order: 1; }
    .lp .lp-nav__contact { gap: 6px; order: 2; }
    .lp .lp-nav__wa { width: 36px; height: 36px; }
    .lp .lp-nav__wa svg { width: 18px; height: 18px; }
    .lp .cta { padding: 24px 18px !important; border-radius: 18px; gap: 22px; }
    .lp .cta h2 { font-size: 22px; }
    .lp .cta p { font-size: 14.5px; }
    .lp .cta__form { padding: 18px; }
    .lp .cta__trust-item p { font-size: 14px; }
    .lp .pill-choices { flex-wrap: wrap; }
    .lp .pill-choices label { min-width: 0; flex: 1 1 calc(50% - 8px); font-size: 13px; padding: 8px 10px; }
    .lp .calc { gap: 14px; }
    .lp .calc__card { padding: 14px; }
    .lp .calc__row { font-size: 14px; gap: 10px; }
    .lp .calc__row strong { white-space: normal; word-break: break-word; }
    .lp .rate-slider { flex-wrap: wrap; gap: 8px; }
    .lp .rate-slider input[type="range"] { min-width: 0; flex: 1 1 100%; }
    .lp .scholar { padding: 14px; gap: 10px; }
    .lp .programs-grid { gap: 10px; }
    .lp .req-grid, .lp .desc-grid, .lp .about-grid, .lp .faq-grid { gap: 14px; }
    .lp .accom-grid, .lp .camp-grid { gap: 12px; }
    .lp .timeline { gap: 10px; }
    .lp .hero__lead { font-size: 16px; }
    .lp .hero__strip { gap: 8px; }
    .lp dialog { width: calc(100vw - 16px); max-height: calc(100vh - 32px); border-radius: 14px; }
    .lp .modal-body, .lp .modal-head, .lp .modal-foot { padding-left: 16px; padding-right: 16px; }
    .lp .modal-foot { flex-wrap: wrap; gap: 8px; }
    .lp .modal-foot .btn { flex: 1 1 100%; }
    .lp .chat-panel { width: calc(100vw - 16px); right: 8px; }
    .lp .lp-chat-fab { right: 14px; bottom: 14px; }
  }
</style>

<div class="lp">
  <div class="progress-bar" id="lpProgress"></div>

  <nav class="lp-nav">
