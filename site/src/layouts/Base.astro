---
import '~/styles/brand.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'StudyRoom — каталог зарубежных университетов с актуальными ценами и дедлайнами.',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/" aria-label="StudyRoom — главная">
          <span class="site-header__brand-mark">Study</span><span>Room</span>
        </a>
        <nav class="site-header__nav" aria-label="Основная навигация">
          <a href="/">Каталог</a>
          <a href="https://studyroom.kz" target="_blank" rel="noopener">studyroom.kz</a>
          <a class="btn btn-primary btn-sm" href="https://studyroom.kz#contact" target="_blank" rel="noopener">
            Консультация
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__brand">StudyRoom</div>
        <p class="muted" style="color:#cfcfcf;margin:0;">
          Каталог собирается автоматически и проверяется вручную перед публикацией.
        </p>
        <div class="site-footer__legal">
          © {year} StudyRoom. Данные о программах и стоимости актуализируются раз в месяц.
        </div>
      </div>
    </footer>
  </body>
</html>
