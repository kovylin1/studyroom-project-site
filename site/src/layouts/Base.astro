---
import '~/styles/brand.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'StudyRoom — каталог зарубежных университетов с актуальными ценами и дедлайнами.' } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <span class="site-header__logo">StudyRoom</span>
        </a>
        <nav class="site-header__nav">
          <a href="/">Каталог</a>
          <a href="https://studyroom.kz" target="_blank" rel="noopener">studyroom.kz</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="muted">
          © StudyRoom. Данные собираются автоматически и проверяются вручную.
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-4) var(--space-5);
      }

      .site-header__brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--color-text);
        font-weight: 700;
      }

      .site-header__logo {
        color: var(--color-primary);
        font-size: 1.25rem;
      }

      .site-header__nav {
        display: flex;
        gap: var(--space-5);
        font-size: 0.95rem;
      }

      .site-header__nav a {
        color: var(--color-text);
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-10);
        padding: var(--space-6) 0;
        background: var(--color-bg-soft);
      }
    </style>
  </body>
</html>
