  // Next update date for one aggregator. Primary source: dayOfMonth — fixed
  // calendar day from scrape-staggered.yml (this month if not yet passed, else
  // next month) at 03:00 UTC (cron hour). Falls back to lastRunAt+intervalDays,
  // then to the global scrape-monthly pass.
  function aggregatorNextRunFromDayOfMonth(dom) {
    if (!dom) return null;
    const now = new Date();
    let candidate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), dom, 3, 0, 0));
    if (candidate <= now) {
      candidate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, dom, 3, 0, 0));
    }
    return candidate.toISOString();
  }
  function aggregatorNextRun(agg) {
    if (agg && agg.dayOfMonth) {
      return aggregatorNextRunFromDayOfMonth(agg.dayOfMonth);
    }
    if (agg && agg.lastRunAt) {
      const days = agg.intervalDays || 30;
      return new Date(new Date(agg.lastRunAt).getTime() + days * 86400000).toISOString();
    }
    return lastSchedule ? lastSchedule.nextRunUTC : null;
  }

  // Drive both cards from the chosen aggregator: identity (right) + next update (left).
  function applyAggregatorSelection(slug) {
    const agg = (lastAggregators || []).find((a) => a.slug === slug);
    if (!agg) return;
    document.getElementById('source-name').textContent = agg.name || '—';
    const link = document.getElementById('source-url');
    link.textContent = agg.baseUrl || '—';
    link.href = agg.baseUrl || '#';
    const tierEl = document.getElementById('source-tier');
    tierEl.className = 'tier tier--' + (agg.tier || 'partner');
    tierEl.textContent = (agg.tier || 'partner').toUpperCase();

    const nextISO = aggregatorNextRun(agg);
    const days = agg.intervalDays || 30;
    document.getElementById('next-run-local').textContent = fmt.dateLocal(nextISO);
    document.getElementById('next-run-relative').textContent = fmt.relative(nextISO);
    document.getElementById('next-run-utc').textContent = nextISO || '—';
    document.getElementById('schedule-source').innerHTML = escapeHtml(
      agg.dayOfMonth
        ? agg.name + ': ' + agg.dayOfMonth + ' число месяца'
        : agg.lastRunAt ? agg.name + ': каждые ' + days + ' дн.' : agg.name + ': при следующем scrape-monthly',
    );
    renderSourceMatch();
    document.getElementById('cron-pill').innerHTML = agg.dayOfMonth
      ? '<code>' + agg.dayOfMonth + ' числа</code>'
      : agg.lastRunAt
      ? '<code>+' + days + 'д</code>'
      : (lastSchedule && lastSchedule.cron ? '<code>' + escapeHtml(lastSchedule.cron) + '</code>' : '—');
  }

  // Populate the aggregator <select>; preserve the current pick across refreshes.
  function setupSourceSelector(aggregators) {
    const sel = document.getElementById('source-select');
    if (!sel) return;
    const list = aggregators || [];
    const prev = sel.value;
    sel.innerHTML = list
      .map((a) => '<option value="' + escapeHtml(a.slug) + '">' + escapeHtml(a.name || a.slug) + '</option>')
      .join('');
    const initial = list.some((a) => a.slug === prev) ? prev : (list[0] && list[0].slug);
    if (initial) sel.value = initial;
    if (!sourceSelectWired) {
      sel.addEventListener('change', () => applyAggregatorSelection(sel.value));
      sourceSelectWired = true;
    }
    if (initial) applyAggregatorSelection(initial);
  }

