---
import Base from '~/layouts/Base.astro';

// Default control URL is empty string = relative path. On the public deploy,
// `${''}/api/status` resolves to `/api/status` and hits the static snapshot
// baked by `scripts/generate-status.mjs`. Users can override via localStorage
// to point at the local control panel (e.g. `http://localhost:5174`) when
// running it to trigger scrapes manually.
const CONTROL_DEFAULT_URL = '';
---

<Base
  title="Управление каталогом — StudyRoom"
  description="Внутренняя страница менеджера: ручной запуск скрапера и статус последнего обновления."
  noindex
>
  <section class="manager">
    <div class="container">
      <header class="manager__head">
        <div>
          <p class="manager__eyebrow">Менеджер · внутренний инструмент</p>
          <h1 class="manager__title">Обновление каталога</h1>
          <p class="manager__lead">
            Запускайте скрапер вручную, отслеживайте статус и смотрите лог. Расписание
            по&nbsp;умолчанию — раз в&nbsp;месяц через GitHub Actions.
          </p>
        </div>
        <div class="manager__health" id="health">
          <span class="status-pill status-pill--idle">
            <span class="status-pill__dot"></span>
            <span id="health-text">Подключение…</span>
          </span>
          <span class="manager__github" id="github-conn">
            <span id="github-conn-dot" class="manager__github-dot manager__github-dot--off" aria-hidden="true"></span>
            <span id="github-conn-text">GitHub не подключён</span>
            <button id="github-conn-btn" class="link-btn" type="button">подключить</button>
          </span>
          <span class="manager__health-url">
            API: <code id="health-url">{CONTROL_DEFAULT_URL || '/api/status.json (снимок)'}</code>
            <button id="health-edit" class="link-btn" type="button">изменить</button>
          </span>
        </div>
      </header>

      <div id="offline-banner" class="banner banner--warn" hidden>
        <strong>Панель управления не отвечает.</strong>
        Запустите её локально: <code>cd control &amp;&amp; npm start</code>. По&nbsp;умолчанию слушает
        <code>http://localhost:5174</code>.
      </div>

      <div id="static-banner" class="banner banner--info" hidden>
        <strong>Режим снимка.</strong>
        Обе кнопки запускают GitHub Actions: данные подтянутся сюда автоматически по&nbsp;завершении (проверка актуальности — ~2&nbsp;мин, полный скрапинг — до&nbsp;~15&nbsp;мин).
        Нужен fine-grained PAT с правом <code>Actions: Read and write</code> — нажмите «подключить» в шапке.
      </div>

      <div class="cards">
        <article class="card">
          <header class="card__head">
            <h2 class="card__title">Следующий запуск</h2>
            <span id="cron-pill" class="card__title card__title--mono"></span>
          </header>
          <p class="card__big" id="next-run-local">—</p>
          <p class="card__sub" id="next-run-relative">Ждём данные…</p>
          <dl class="meta">
            <div><dt>UTC</dt><dd id="next-run-utc">—</dd></div>
            <div><dt>Источник</dt><dd id="schedule-source">—</dd></div>
          </dl>
        </article>

        <article class="card">
          <header class="card__head">
            <h2 class="card__title">Источник данных</h2>
            <span id="source-tier" class="tier tier--partner">PARTNER</span>
          </header>
          <p class="card__big" id="source-name">—</p>
          <a id="source-url" class="card__link" href="#" target="_blank" rel="noopener">—</a>
          <label class="source-select__label" for="source-select">Выбрать агрегатор</label>
          <select id="source-select" class="filter-panel__select source-select"></select>
          <dl class="meta">
            <div><dt>В реестре</dt><dd><strong id="registry-count">—</strong></dd></div>
            <div><dt>В каталоге сейчас</dt><dd><strong id="catalog-count">—</strong></dd></div>
          </dl>
        </article>
      </div>

      <article class="card card--directors" id="directors-card">
        <header class="card__head">
          <h2 class="card__title">Директора (task hierarchy)</h2>
          <span id="gaps-pill" class="muted" style="font-size:0.8rem"></span>
        </header>
        <div class="directors-grid" id="directors-grid">
          <div class="director-item" id="dir-pauk">
            <span class="director-item__name">ПАУК</span>
            <span class="director-item__domain muted">programs</span>
            <span class="director-item__pill status-pill status-pill--idle"><span class="status-pill__dot"></span>—</span>
            <button id="pauk-run-btn" class="btn btn-ghost btn-sm" type="button" style="margin-top:8px">Запустить</button>
          </div>
          <div class="director-item" id="dir-bobr">
            <span class="director-item__name">БОБР</span>
            <span class="director-item__domain muted">campuses</span>
            <span class="director-item__pill status-pill status-pill--idle"><span class="status-pill__dot"></span>—</span>
            <button id="bobr-run-btn" class="btn btn-ghost btn-sm" type="button" style="margin-top:8px">Запустить</button>
          </div>
          <div class="director-item" id="dir-orel">
            <span class="director-item__name">ОРЁЛ</span>
            <span class="director-item__domain muted">photos</span>
            <span class="director-item__pill status-pill status-pill--idle"><span class="status-pill__dot"></span>—</span>
            <button id="orel-run-btn" class="btn btn-ghost btn-sm" type="button" style="margin-top:8px">Запустить</button>
          </div>
        </div>
      </article>

      <article class="card card--agg-schedules" id="agg-schedules-card">
        <header class="card__head">
          <h2 class="card__title">Агрегаторы — последний прогон</h2>
          <span id="agg-overdue-pill" class="muted" style="font-size:0.8rem"></span>
        </header>
        <div class="table-wrap">
          <table class="manager__table agg-table">
            <thead>
              <tr>
                <th>Агрегатор</th>
                <th>Тир</th>
                <th>Число / следующее</th>
                <th>Интервал</th>
                <th>Последний прогон</th>
                <th>Статус</th>
              </tr>
            </thead>
            <tbody id="agg-schedules-tbody">
              <tr><td colspan="6" class="table-loading">Загрузка…</td></tr>
            </tbody>
          </table>
        </div>
      </article>

      <article class="card manager__run">
        <header class="card__head">
          <h2 class="card__title">Ручной запуск</h2>
          <span id="run-status" class="status-pill status-pill--idle">
            <span class="status-pill__dot"></span>
            <span id="run-status-text">Ожидание</span>
          </span>
        </header>
        <p class="card__sub" id="run-summary">
          Скрапер ещё не запускался. Нажмите кнопку — обновятся все университеты каталога.
        </p>
        <div class="manager__actions">
          <button id="run-all-btn" class="btn btn-primary" type="button">
            Запустить скрапинг сейчас
          </button>
          <div class="verify-dropdown" id="verify-dropdown">
            <button id="verify-btn" class="btn btn-secondary verify-dropdown__trigger" type="button" aria-expanded="false" aria-haspopup="true">
              Проверить актуальность <span class="verify-dropdown__chevron">▾</span>
            </button>
            <div id="verify-menu" class="verify-menu" hidden role="menu">
              <button class="verify-menu-item" type="button" data-verify-scope="critical" role="menuitem">
                <span class="verify-menu-item__icon">🔍</span>
                <span class="verify-menu-item__body">
                  <span class="verify-menu-item__label">Критические</span>
                  <span class="verify-menu-item__desc">Топ-100 проблемных · ~10 мин</span>
                </span>
              </button>
              <button class="verify-menu-item" type="button" data-verify-scope="all" role="menuitem">
                <span class="verify-menu-item__icon">📋</span>
                <span class="verify-menu-item__body">
                  <span class="verify-menu-item__label">Все (804 вуза)</span>
                  <span class="verify-menu-item__desc">Полная проверка · ~25 мин</span>
                </span>
              </button>
            </div>
          </div>
          <div class="verify-dropdown" id="fix-dropdown">
            <button id="fix-freshness-btn" class="btn btn-secondary verify-dropdown__trigger" type="button" aria-expanded="false" aria-haspopup="true">
              Исправить <span class="verify-dropdown__chevron">▾</span>
            </button>
            <div id="fix-menu" class="verify-menu" hidden role="menu">
              <button class="verify-menu-item" type="button" data-fix-scope="critical" role="menuitem">
                <span class="verify-menu-item__icon">⚡</span>
                <span class="verify-menu-item__body">
                  <span class="verify-menu-item__label">Критические</span>
                  <span class="verify-menu-item__desc">Топ-100 · авто-удалить 404 + shmel · ~20 мин</span>
                </span>
              </button>
              <button class="verify-menu-item" type="button" data-fix-scope="all" role="menuitem">
                <span class="verify-menu-item__icon">🔧</span>
                <span class="verify-menu-item__body">
                  <span class="verify-menu-item__label">Все (804 вуза)</span>
                  <span class="verify-menu-item__desc">Полный ремонт · авто-удалить 404 + shmel · ~40 мин</span>
                </span>
              </button>
            </div>
          </div>
          <button id="orel-btn" class="btn btn-secondary" type="button">
            Обновить фото (ОРЁЛ)
          </button>
          <span class="muted manager__hint">
            или нажмите «обновить» в строке таблицы ниже, чтобы пересобрать один университет.
          </span>
        </div>
        <p class="card__sub manager__verify-summary" id="verify-summary" hidden>
          <span id="verify-summary-text"></span>
          <button id="verify-details-toggle" class="link-btn" type="button" hidden>
            подробности
          </button>
        </p>
        <details id="verify-details" class="manager__verify-details" hidden>
          <summary class="muted">Точность по университетам</summary>
          <ul id="verify-details-list" class="manager__verify-list"></ul>
        </details>

        <details id="review-panel" class="manager__review-panel" hidden>
          <summary id="review-panel-summary" class="manager__review-summary">
            <span id="review-panel-title">Аудит каталога: проблемные кейсы</span>
            <span id="review-panel-badge" class="status-pill status-pill--warn" hidden></span>
          </summary>
          <ul id="review-items-list" class="manager__review-list"></ul>
          <p id="review-feedback" class="manager__review-feedback" role="status" aria-live="polite" hidden></p>
          <div class="manager__review-actions" id="review-actions" hidden>
            <button id="review-apply-btn" class="btn btn-primary" type="button">Применить решения</button>
            <span class="muted" id="review-apply-hint">Решения сохраняются автоматически при нажатии кнопок</span>
          </div>
        </details>
      </article>

      <article id="remote-run" class="card manager__remote-run" hidden>
        <header class="card__head">
          <h2 class="card__title">Удалённый запуск (GitHub Actions)</h2>
          <span id="remote-run-status" class="status-pill status-pill--idle">
            <span class="status-pill__dot"></span>
            <span id="remote-run-status-text">—</span>
          </span>
        </header>
        <p class="card__sub" id="remote-run-summary">—</p>
        <div class="manager__remote-meta">
          <span>Прошло: <strong id="remote-run-elapsed">0&nbsp;с</strong></span>
          <a id="remote-run-link" href="#" target="_blank" rel="noopener" hidden>лог GitHub →</a>
        </div>
      </article>

      <article class="card card--flush">
        <div class="filterbar-mini">
          <label class="filterbar-mini__search">
            <span aria-hidden="true" class="filterbar-mini__search-icon">🔍</span>
            <input
              id="filter-search"
              type="search"
              placeholder="Поиск по слагу или названию…"
              autocomplete="off"
            />
          </label>
          <button
            id="filter-toggle"
            class="btn btn-ghost btn-sm filterbar-mini__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="filter-panel"
          >
            <span>Фильтры</span>
            <span id="filter-count" class="filterbar-mini__count" hidden></span>
            <span aria-hidden="true" class="filterbar-mini__chev">▾</span>
          </button>
          <button id="filter-reset" class="btn btn-ghost btn-sm" type="button">Сбросить</button>
          <span id="filter-result-count" class="filterbar-mini__result muted"></span>
        </div>

        <div id="filter-panel" class="filter-panel" data-open="false">
          <div class="filter-panel__inner">
            <div class="filter-panel__group">
              <span class="filter-panel__label">Агрегатор</span>
              <div class="filter-panel__chips" id="filter-aggregator-chips">
                <button class="chip chip--active" type="button" data-filter="aggregator" data-value="">Все</button>
              </div>
            </div>

            <div class="filter-panel__group">
              <span class="filter-panel__label">Тир</span>
              <div class="filter-panel__chips">
                <button class="chip" type="button" data-filter="tier" data-value="partner">partner</button>
                <button class="chip" type="button" data-filter="tier" data-value="official">official</button>
                <button class="chip" type="button" data-filter="tier" data-value="aggregator">aggregator</button>
              </div>
            </div>

            <div class="filter-panel__group">
              <span class="filter-panel__label">Страна</span>
              <select id="filter-country" class="filter-panel__select">
                <option value="">Все</option>
              </select>
            </div>

            <div class="filter-panel__group">
              <span class="filter-panel__label">В каталоге</span>
              <div class="filter-panel__chips">
                <button class="chip chip--active" type="button" data-filter="status" data-value="">Все</button>
                <button class="chip" type="button" data-filter="status" data-value="in">Да</button>
                <button class="chip" type="button" data-filter="status" data-value="out">Нет</button>
              </div>
            </div>

            <div class="filter-panel__group">
              <span class="filter-panel__label">Свежесть</span>
              <div class="filter-panel__chips">
                <button class="chip chip--active" type="button" data-filter="freshness" data-value="">Все</button>
                <button class="chip" type="button" data-filter="freshness" data-value="fresh">Свежие (&le;35д)</button>
                <button class="chip" type="button" data-filter="freshness" data-value="stale">Устарели</button>
                <button class="chip" type="button" data-filter="freshness" data-value="never">Никогда</button>
              </div>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <table class="manager__table">
            <thead>
              <tr>
                <th>Слаг</th>
                <th>Университет</th>
                <th>Город</th>
                <th>Тир</th>
                <th>Агрегатор</th>
                <th>В каталоге</th>
                <th>Последняя проверка</th>
                <th>Gap</th>
                <th aria-label="Действие"></th>
              </tr>
            </thead>
            <tbody id="registry-tbody">
              <tr>
                <td colspan="8" class="table-loading">Загрузка реестра…</td>
              </tr>
            </tbody>
          </table>
        </div>
      </article>

      <article class="card card--flush log-card">
        <header class="log-card__head">
          <h2 class="card__title">Лог последнего запуска</h2>
          <span id="log-summary" class="muted log-card__summary"></span>
        </header>
        <pre id="log-output" class="log"><span class="log__empty">Лог пустой. Запустите скрапер, чтобы увидеть вывод.</span></pre>
      </article>
    </div>
  </section>
</Base>

<style>
  .manager { padding: 56px 0 96px; background: var(--color-bg-soft); min-height: calc(100vh - 200px); }
  .manager__head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    flex-wrap: wrap; margin-bottom: 32px;
  }
  .manager__eyebrow {
    margin: 0 0 8px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-primary-dark);
  }
  .manager__title { margin: 0 0 8px; font-size: clamp(28px, 4vw, 40px); }
  .manager__lead { margin: 0; max-width: 640px; color: var(--color-text-muted); }
  .manager__health { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .manager__health-url { font-size: 0.8rem; color: var(--color-text-muted); }
  .manager__health-url code {
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
    background: var(--color-bg); padding: 1px 6px; border-radius: 6px; border: 1px solid var(--color-border);
  }
  .link-btn {
    background: none; border: none; padding: 0 0 0 6px; color: var(--color-primary-dark);
    font: inherit; font-size: 0.8rem; cursor: pointer; text-decoration: underline;
  }
  .link-btn:hover { color: var(--color-primary); }

  .banner {
    padding: 14px 18px; border-radius: var(--radius-card); margin-bottom: 24px;
    border: 1px solid; font-size: 0.92rem;
  }
  .banner--warn { background: #fff4cc; border-color: #f1d782; color: #5a4200; }
  .banner--info { background: var(--color-primary-soft); border-color: var(--color-primary); color: var(--color-primary-dark); }
  .banner code {
    background: rgba(0,0,0,0.06); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
  }

  .manager__github {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.8rem; color: var(--color-text-muted);
  }
  .manager__github-dot {
    width: 8px; height: 8px; border-radius: 50%; display: inline-block;
  }
  .manager__github-dot--on { background: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .manager__github-dot--off { background: var(--color-text-faint); }

  .manager__remote-run {
    margin-bottom: 24px;
    border: 1px solid var(--color-primary);
    background: linear-gradient(180deg, var(--color-primary-soft) 0%, var(--color-bg) 100%);
  }
  .manager__remote-meta {
    display: flex; flex-wrap: wrap; gap: 24px;
    font-size: 0.9rem; margin-top: 12px;
    color: var(--color-text-muted);
  }
  .manager__remote-meta a { color: var(--color-primary-dark); font-weight: 600; }
  .manager__remote-meta a:hover { text-decoration: underline; }

  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }

  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: var(--shadow-card);
  }
  .card--flush { padding: 0; overflow: hidden; margin-bottom: 24px; }
  .card__head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 16px; gap: 16px;
  }
  .card__title {
    margin: 0; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-text-muted); font-weight: 700;
  }
  .card__title--mono {
    text-transform: none; letter-spacing: 0; font-weight: 500;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
  }
  .card__big {
    margin: 0; font-size: 1.9rem; font-weight: 900; line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .card__sub { margin: 8px 0 0; color: var(--color-text-muted); }
  .card__link {
    display: inline-block; margin-top: 6px;
    font-size: 0.95rem; word-break: break-all;
  }

  .source-select__label {
    display: block; margin-top: 12px; margin-bottom: 4px;
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .source-select { width: 100%; }

  .meta { margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .meta > div { display: flex; justify-content: space-between; font-size: 0.85rem; gap: 12px; }
  .meta dt { color: var(--color-text-muted); margin: 0; }
  .meta dd { margin: 0; text-align: right; }

  .manager__run { margin-bottom: 24px; }
  .verify-dropdown { position: relative; display: inline-block; }
  .verify-dropdown__chevron { font-size: 0.7rem; transition: transform 180ms ease; }
  .verify-dropdown__trigger[aria-expanded="true"] .verify-dropdown__chevron { transform: rotate(180deg); }
  .verify-menu {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 200;
    background: var(--color-bg); border: 1px solid var(--color-border);
    border-radius: 12px; box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    min-width: 240px; overflow: hidden;
  }
  .verify-menu-item {
    display: flex; align-items: flex-start; gap: 10px; width: 100%;
    padding: 12px 16px; background: none; border: none; cursor: pointer;
    border-bottom: 1px solid var(--color-border); text-align: left; font: inherit;
  }
  .verify-menu-item:last-child { border-bottom: none; }
  .verify-menu-item:hover { background: var(--color-bg-soft); }
  .verify-menu-item__icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
  .verify-menu-item__body { display: flex; flex-direction: column; gap: 2px; }
  .verify-menu-item__label { font-weight: 600; font-size: 0.9rem; }
  .verify-menu-item__desc { font-size: 0.78rem; color: var(--color-text-muted); }
  .manager__actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 16px; }
  .manager__hint { font-size: 0.88rem; max-width: 480px; }
  .manager__verify-summary { margin-top: 12px; }
  .manager__verify-details { margin-top: 8px; }
  .manager__verify-details summary { cursor: pointer; font-size: 0.9rem; }
  .manager__verify-list { list-style: none; padding: 8px 0 0; margin: 0; display: grid; gap: 4px; }
  .verify-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 8px; border-radius: 4px; font-size: 0.9rem; }
  .verify-row__pct { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .verify-row--ok { background: rgba(34, 139, 34, 0.08); }
  .verify-row--warn { background: rgba(225, 165, 0, 0.12); }
  .verify-row--fail { background: rgba(200, 50, 50, 0.12); }

  .manager__review-panel { margin-top: 12px; border: 1px solid var(--border, #e0e0e0); border-radius: 8px; padding: 0; }
