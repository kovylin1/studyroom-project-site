  // ---------- generic workflow_dispatch + poll ----------

  async function runRemoteWorkflow({ workflowFile, label, expectedMin, inputs = {} }) {
    const token = getGithubToken();
    if (!token) {
      const proceed = confirm(
        'Запустить через GitHub Actions?\n\nНужен fine-grained PAT с правом «Actions: Read and write» на ' +
          GITHUB_REPO + '.\nТокен сохранится в localStorage этого браузера.',
      );
      if (!proceed) return false;
      const t = promptForGithubToken();
      if (!t) return false;
    }
    const authToken = getGithubToken();
    const startTs = new Date();

    showRemoteRun(
      label + ' — отправляем запрос в GitHub Actions…',
      'Отправка',
      'status-pill--running',
    );
    setRemoteRunLink(null);
    startRemoteRunTimer();

    try {
      const dispatchUrl =
        'https://api.github.com/repos/' + GITHUB_REPO + '/actions/workflows/' +
        workflowFile + '/dispatches';
      const dispatchRes = await fetch(dispatchUrl, {
        method: 'POST',
        headers: {
          Authorization: 'Bearer ' + authToken,
          Accept: 'application/vnd.github+json',
          'Content-Type': 'application/json',
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({ ref: GITHUB_REF, inputs }),
      });
      if (dispatchRes.status === 401) throw new Error('токен невалидный или истёк (HTTP 401)');
      if (dispatchRes.status === 404) throw new Error('workflow не найден или у токена нет прав (HTTP 404). Проверьте scope «Actions: Read and write».');
      if (dispatchRes.status !== 204) throw new Error('GitHub API ' + dispatchRes.status + ': ' + (await dispatchRes.text()));

      showRemoteRun(
        label + ' — workflow поставлен в очередь. Ожидаемое время: ~' + expectedMin + ' мин.',
        'В очереди',
        'status-pill--running',
      );

      // Poll workflow_runs until we find the one we just triggered and it completes.
      const runsUrl =
        'https://api.github.com/repos/' + GITHUB_REPO + '/actions/workflows/' +
        workflowFile + '/runs?per_page=10';
      let run = null;
      // 200 × 10s = 33 min. Allows for GitHub queue delay (2-5 min) +
      // longest workflow (orel: 60 min cap, pauk: 45 min cap). Verify is 30 min.
      for (let i = 0; i < 200; i += 1) {
        await sleep(10000);
        try {
          const r = await fetch(runsUrl, {
            headers: {
              Authorization: 'Bearer ' + authToken,
              Accept: 'application/vnd.github+json',
            },
          });
          if (!r.ok) continue;
          const data = await r.json();
          run = (data.workflow_runs || []).find((w) => new Date(w.created_at) >= startTs);
          if (!run) continue;
          if (run.html_url) setRemoteRunLink(run.html_url);
          if (run.status === 'queued') {
            showRemoteRun(label + ' — стоит в очереди GitHub Actions.', 'В очереди', 'status-pill--running');
          } else if (run.status === 'in_progress') {
            showRemoteRun(label + ' — workflow выполняется на GitHub.', 'Идёт ' + label.toLowerCase(), 'status-pill--running');
          }
          if (run.status === 'completed') break;
        } catch {
          // network blip — keep polling
        }
      }
      if (!run || run.status !== 'completed') {
        throw new Error('таймаут опроса GitHub (>33 мин). Откройте лог GitHub и проверьте вручную.');
      }
      if (run.conclusion !== 'success') {
        throw new Error('workflow завершился с conclusion=' + run.conclusion + '. Подробнее: ' + run.html_url);
      }

      showRemoteRun(
        label + ' — успешно. Подтягиваем свежие данные с raw.githubusercontent.com…',
        'Обновление данных',
        'status-pill--running',
      );
      await refreshDataFromRaw();

      stopRemoteRunTimer();
      showRemoteRun(
        label + ' — готово. Данные на странице обновлены. Cloudflare пересоберёт сайт ещё ~1 мин.',
        'Успешно',
        'status-pill--ok',
      );
      hideRemoteRunSoon();
      return true;
    } catch (err) {
      stopRemoteRunTimer();
      showRemoteRun(
        (label + ' — ошибка: ' + (err && err.message ? err.message : err)),
        'Ошибка',
        'status-pill--fail',
      );
      return false;
    }
  }

  // After a remote workflow completes, pull fresh status.json + verify.json
  // directly from the main branch on raw.githubusercontent.com (CORS-allowed,
  // no Cloudflare cache). Then rerender the page without a reload.
  async function refreshDataFromRaw() {
    const ts = Date.now();
    try {
      const sRes = await fetch(RAW_BASE + '/site/public/api/status.json?ts=' + ts, { cache: 'no-store' });
      if (sRes.ok) {
        const data = await sRes.json();
        lastRegistry = data.registry || [];
        renderSchedule(data.schedule);
        const catalogCount = data.registry.filter((r) => r.catalog).length;
        renderSource(data.sourceProfile, data.registry.length, catalogCount);
        renderAggregatorSchedules(data.aggregators || []);
        syncAggregatorChips(data.aggregators || [], data.registry);
      syncCountryOptions(data.registry);
        setupSourceSelector(data.aggregators || []);
          renderRegistry(data.registry);
      }
    } catch (err) {
      console.warn('refreshDataFromRaw status.json failed', err);
    }
    try {
      const vRes = await fetch(RAW_BASE + '/site/public/api/verify.json?ts=' + ts, { cache: 'no-store' });
      if (vRes.ok) renderVerifySummary(await vRes.json());
    } catch (err) {
      console.warn('refreshDataFromRaw verify.json failed', err);
    }
  }

