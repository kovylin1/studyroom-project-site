    const value = target.dataset.value || '';
    if (!kind) return;

    if (kind !== 'aggregator') return;
    if (value === '') filters.aggregators.clear();
    else if (filters.aggregators.has(value)) filters.aggregators.delete(value);
    else filters.aggregators.add(value);
    syncAggregatorChipState();
