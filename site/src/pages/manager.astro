  .card--agg-schedules .card__head { padding: 16px 20px 0; }
  .agg-table td, .agg-table th { padding: 10px 16px; }
  .agg-status--ok { color: var(--color-primary-dark); font-weight: 600; }
  .agg-status--due { color: #c47a30; font-weight: 600; }
  .agg-status--never { color: var(--color-text-faint); font-style: italic; }
  .directors-grid { display: flex; gap: 16px; flex-wrap: wrap; }
  .director-item { flex: 1 1 160px; display: flex; flex-direction: column; gap: 4px; padding: 14px; background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: 12px; }
  .director-item__name { font-weight: 700; font-size: 1rem; }
  .director-item__domain { font-size: 0.78rem; }
  .director-item__pill { margin-top: 8px; font-size: 0.78rem; padding: 3px 10px; }
  .gap-critical { color: #c43030; font-weight: 700; font-size: 0.8rem; }
  .gap-high { color: #c47a30; font-weight: 600; font-size: 0.8rem; }
  .gap-medium { color: var(--color-text-muted); font-size: 0.8rem; }

  /* ---------- run selector modal ---------- */
  .run-selector-overlay {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: flex-end; justify-content: center;
  }
  .run-selector-overlay[hidden] { display: none; }
  .run-selector-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);
  }
  .run-selector-sheet {
    position: relative; z-index: 1;
    width: 100%; max-width: 540px;
    background: var(--color-bg);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    padding: 28px 24px 32px;
    box-shadow: 0 -8px 32px rgba(0,0,0,0.15);
    animation: slideUp 180ms ease;
  }
  @keyframes slideUp { from { transform: translateY(60px); opacity: 0; } to { transform: none; opacity: 1; } }
  .run-selector__title { margin: 0 0 20px; font-size: 1.1rem; font-weight: 700; }
  .run-opts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
  .run-opt {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 12px; cursor: pointer;
    border: 1px solid var(--color-border);
    transition: background 120ms ease, border-color 120ms ease;
  }
  .run-opt:hover { background: var(--color-bg-soft); }
  .run-opt:has(.run-opt__check:checked) {
    background: var(--color-primary-soft); border-color: var(--color-primary);
  }
  .run-opt__check { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--color-primary); }
  .run-opt__body { display: flex; align-items: center; gap: 8px; flex: 1; flex-wrap: wrap; }
  .run-opt__label { font-weight: 700; font-size: 0.95rem; }
  .run-opt__desc { font-size: 0.82rem; flex: 1; }
  .run-opt__time { font-size: 0.75rem; margin-left: auto; white-space: nowrap; }
  .run-selector__actions { display: flex; gap: 12px; justify-content: flex-end; }

  .log-card__head {
    padding: 16px 20px; border-bottom: 1px solid var(--color-border);
    display: flex; justify-content: space-between; align-items: center;
  }
  .log-card__summary { font-size: 0.85rem; }
  .log {
    background: #0f0f0f; color: #e6e6e6;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
    font-size: 0.82rem; line-height: 1.5;
    padding: 16px 20px;
    max-height: 380px; overflow-y: auto;
    white-space: pre-wrap; word-break: break-word;
    margin: 0;
  }
  .log__line { display: block; }
  .log__line--ok { color: #93e695; }
  .log__line--fail { color: #ff8a8a; }
  .log__line--warn { color: #ffd699; }
  .log__line--meta { color: #888; }
  .log__empty { padding: 24px 0; text-align: center; color: #888; font-style: italic; display: block; }
</style>

<script define:vars={{ controlDefaultUrl: CONTROL_DEFAULT_URL }}>
  const STORAGE_KEY = 'studyroom.manager.controlUrl';
  const POLL_INTERVAL_RUNNING_MS = 1500;
  const POLL_INTERVAL_IDLE_MS = 8000;
  const POLL_INTERVAL_OFFLINE_MS = 5000;

  let pollTimer = null;
  let isOnline = false;
  let lastRegistry = [];
  let lastAggregators = [];
  let lastSchedule = null;
  let sourceSelectWired = false;
  const filters = {
    search: '',
    aggregator: '',
    tiers: new Set(),
    country: '',
    status: '',
    freshness: '',
  };

  function getControlUrl() {
    try {
      return localStorage.getItem(STORAGE_KEY) || controlDefaultUrl;
    } catch {
      return controlDefaultUrl;
    }
  }

  function setControlUrl(url) {
    try {
      if (url) localStorage.setItem(STORAGE_KEY, url);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {}
    const current = getControlUrl();
    document.getElementById('health-url').textContent =
      current || '/api/status.json (снимок)';
  }

  const fmt = {
    dateLocal(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('ru-RU', {
        day: '2-digit', month: 'long', year: 'numeric',
        hour: '2-digit', minute: '2-digit',
      });
    },
    relative(iso) {
      if (!iso) return '—';
      const diffMs = new Date(iso) - new Date();
      const totalMin = Math.round(diffMs / 60000);
      if (totalMin < 0) return 'в прошлом';
      if (totalMin < 60) return 'через ' + totalMin + ' мин';
      const totalHr = Math.round(totalMin / 60);
      if (totalHr < 24) return 'через ' + totalHr + ' ч';
      const days = Math.round(totalHr / 24);
      return 'через ' + days + ' дн';
    },
    ago(iso) {
      if (!iso) return null;
      const diffMs = new Date() - new Date(iso);
      const totalMin = Math.round(diffMs / 60000);
      if (totalMin < 1) return 'только что';
      if (totalMin < 60) return totalMin + ' мин назад';
      const totalHr = Math.round(totalMin / 60);
      if (totalHr < 24) return totalHr + ' ч назад';
      const days = Math.round(totalHr / 24);
      return days + ' дн назад';
    },
    stalenessClass(iso) {
      if (!iso) return 'checked-never';
      const days = (new Date() - new Date(iso)) / (1000 * 60 * 60 * 24);
      return days <= 35 ? 'checked-fresh' : 'checked-stale';
    },
  };

  function classifyLogLine(line) {
    if (/^\[ok\]/.test(line)) return 'log__line--ok';
    if (/^\[fail\]|spawn error|fail/i.test(line)) return 'log__line--fail';
    if (/^\[skip\]|warn/i.test(line)) return 'log__line--warn';
    if (/^[>=]|^Done:/i.test(line)) return 'log__line--meta';
    return '';
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderLog(log) {
    const el = document.getElementById('log-output');
    if (!log || log.length === 0) {
      el.innerHTML = '<span class="log__empty">Лог пустой. Запустите скрапер, чтобы увидеть вывод.</span>';
      return;
    }
    el.innerHTML = log.map((entry) => {
      const cls = classifyLogLine(entry.line);
      return '<span class="log__line ' + cls + '">' + escapeHtml(entry.line) + '</span>';
    }).join('\n');
    el.scrollTop = el.scrollHeight;
  }

  let lastRunRunning = false;
  let lastRunTarget = null;

  function renderRunStatus(run) {
    const pill = document.getElementById('run-status');
    const txt = document.getElementById('run-status-text');
    const summary = document.getElementById('run-summary');
    const btn = document.getElementById('run-all-btn');
    const verifyBtn = document.getElementById('verify-btn');
    const isVerify = run.currentTarget === 'verify';

    // When a verify run just finished, refresh the snapshot in the UI.
    if (lastRunRunning && !run.running && lastRunTarget === 'verify') {
      refreshVerifySummary();
    }
    lastRunRunning = !!run.running;
    lastRunTarget = run.currentTarget;

    pill.className = 'status-pill';

    if (run.running) {
      pill.classList.add('status-pill--running');
      if (isVerify) {
        txt.textContent = 'Идёт проверка';
        summary.textContent =
          'Проверяем актуальность ссылок. Запущено ' + fmt.ago(run.startedAt) + '. Кнопки отключены до завершения.';
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Проверяем…';
        btn.disabled = true;
        btn.textContent = 'Запустить скрапинг сейчас';
      } else {
        txt.textContent = 'Идёт скрапинг';
        const target = run.currentTarget === 'all' ? 'все университеты' : run.currentTarget;
        summary.textContent = 'Цель: ' + target + '. Запущено ' + fmt.ago(run.startedAt) + '. Кнопки отключены до завершения.';
        btn.disabled = true;
        btn.textContent = 'Идёт скрапинг…';
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Проверить актуальность';
      }
    } else if (run.exitCode === null) {
      pill.classList.add('status-pill--idle');
      txt.textContent = 'Ожидание';
      summary.textContent =
        'Скрапер не запускался в этой сессии. Нажмите кнопку — обновятся все ' +
        (lastRegistry.length || '—') +
        ' университетов.';
      btn.disabled = !isOnline;
      btn.textContent = 'Запустить скрапинг сейчас';
    } else if (run.exitCode === 0) {
      pill.classList.add('status-pill--ok');
      txt.textContent = 'Успешно';
      summary.textContent = 'Завершено ' + fmt.ago(run.finishedAt) + '. Цель: ' + (run.currentTarget === 'all' ? 'все' : run.currentTarget) + '. Можно запустить снова.';
      btn.disabled = !isOnline;
      btn.textContent = 'Запустить ещё раз';
    } else {
      pill.classList.add('status-pill--fail');
      txt.textContent = 'Ошибка (код ' + run.exitCode + ')';
      summary.textContent = 'Последний запуск завершился с ошибкой ' + fmt.ago(run.finishedAt) + '. Смотрите лог ниже.';
      btn.disabled = !isOnline;
      btn.textContent = 'Повторить';
    }

    // Verify-btn shares the same online lock + run lock as the scrape btn.
    if (!run.running) {
      verifyBtn.disabled = !isOnline;
      verifyBtn.textContent = 'Проверить актуальность';
    }
  }

  function rowFreshness(row) {
    const iso = row.catalog && row.catalog.lastChecked;
    if (!iso) return 'never';
    const days = (new Date() - new Date(iso)) / (1000 * 60 * 60 * 24);
    return days <= 35 ? 'fresh' : 'stale';
  }

  function rowMatchesFilters(row) {
    if (filters.search) {
      const q = filters.search.toLowerCase();
      if (!row.slug.toLowerCase().includes(q) && !row.name.toLowerCase().includes(q)) return false;
    }
    if (filters.aggregator && row.aggregatorSlug !== filters.aggregator) return false;
    if (filters.tiers.size > 0 && !filters.tiers.has(row.tier)) return false;
    if (filters.country && row.country !== filters.country) return false;
    if (filters.status === 'in' && !row.catalog) return false;
    if (filters.status === 'out' && row.catalog) return false;
    if (filters.freshness && rowFreshness(row) !== filters.freshness) return false;
    return true;
  }

  function aggregatorLabel(slug) {
    if (!slug) return '—';
    const found = lastAggregators.find((a) => a.slug === slug);
    return found ? found.name : slug;
  }

  function renderRegistry(registry) {
    lastRegistry = registry || [];
    const tbody = document.getElementById('registry-tbody');
    if (lastRegistry.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="table-loading">Реестр пуст. Проверьте sources/universities.list.md</td></tr>';
      updateResultCount(0, 0);
      return;
    }
    const filtered = lastRegistry.filter(rowMatchesFilters);
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="table-loading">Ничего не найдено. Попробуйте сбросить фильтры.</td></tr>';
      updateResultCount(0, lastRegistry.length);
      return;
    }
    tbody.innerHTML = filtered.map((row) => {
      const inCatalog = row.catalog ? 'да' : '—';
      const checked = row.catalog && row.catalog.lastChecked;
      const checkedLabel = checked ? fmt.ago(checked) : 'никогда';
      const checkedCls = fmt.stalenessClass(checked);
      const disabledAttr = isOnline ? '' : ' disabled';
      const aggLabel = aggregatorLabel(row.aggregatorSlug);
      const aggCell = row.aggregatorSlug
        ? '<span class="tier tier--' + escapeHtml(lastAggregators.find((a) => a.slug === row.aggregatorSlug)?.tier || 'aggregator') + '">' + escapeHtml(aggLabel) + '</span>'
        : '<span class="muted">—</span>';
      const slugLink = '<a href="/' + escapeHtml(row.slug) + '" target="_blank" rel="noopener" class="table-link"><code>' + escapeHtml(row.slug) + '</code></a>';
      const nameLink = '<a href="/' + escapeHtml(row.slug) + '" target="_blank" rel="noopener" class="table-link">' + escapeHtml(row.name || '—') + '</a>';
      return '<tr>' +
        '<td>' + slugLink + '</td>' +
        '<td>' + nameLink + '</td>' +
        '<td>' + escapeHtml(row.city) + '</td>' +
        '<td><span class="tier tier--' + escapeHtml(row.tier) + '">' + escapeHtml(row.tier) + '</span></td>' +
        '<td>' + aggCell + '</td>' +
        '<td>' + inCatalog + '</td>' +
        '<td><span class="' + checkedCls + '">' + checkedLabel + '</span></td>' +
        '<td>' + (row.gapPriority ? '<span class="gap-' + escapeHtml(row.gapPriority) + '">' + escapeHtml(row.gapPriority) + '</span>' : '') + '</td>' +
        '<td><button class="btn btn-ghost btn-sm" data-run-slug="' + escapeHtml(row.slug) + '"' + disabledAttr + '>обновить</button></td>' +
        '</tr>';
    }).join('');
    updateResultCount(filtered.length, lastRegistry.length);
  }

  function updateResultCount(shown, total) {
    const el = document.getElementById('filter-result-count');
    if (!el) return;
    el.textContent = total === 0 ? '' : (shown === total ? total + ' из ' + total : shown + ' из ' + total);
  }

  function countActiveFilters() {
    let n = 0;
    if (filters.search) n++;
    if (filters.aggregator) n++;
    if (filters.tiers.size > 0) n++;
    if (filters.country) n++;
    if (filters.status) n++;
    if (filters.freshness) n++;
    return n;
  }

  function refreshFilterCountBadge() {
    const n = countActiveFilters();
    const badge = document.getElementById('filter-count');
    if (!badge) return;
    if (n === 0) {
      badge.hidden = true;
      badge.textContent = '';
    } else {
      badge.hidden = false;
      badge.textContent = String(n);
    }
  }

  function applyFiltersAndRerender() {
    refreshFilterCountBadge();
    renderRegistry(lastRegistry);
  }

  function syncAggregatorChips(aggregators, registry) {
    lastAggregators = aggregators || [];
    const container = document.getElementById('filter-aggregator-chips');
    if (!container) return;
    const existing = new Set(Array.from(container.querySelectorAll('.chip')).map((c) => c.dataset.value));
    for (const agg of lastAggregators) {
      if (existing.has(agg.slug)) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.dataset.filter = 'aggregator';
      btn.dataset.value = agg.slug;
      btn.textContent = agg.name;
      container.appendChild(btn);
      existing.add(agg.slug);
    }
    // Add chips for any aggregatorSlug found in registry but not yet listed
    for (const row of (registry || [])) {
      if (!row.aggregatorSlug || existing.has(row.aggregatorSlug)) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.dataset.filter = 'aggregator';
      btn.dataset.value = row.aggregatorSlug;
      btn.textContent = row.aggregatorSlug;
      container.appendChild(btn);
      existing.add(row.aggregatorSlug);
    }
  }

  function syncCountryOptions(registry) {
    const select = document.getElementById('filter-country');
    if (!select) return;
    const countries = Array.from(new Set((registry || []).map((r) => r.country))).sort((a, b) => a.localeCompare(b, 'ru'));
    const current = filters.country;
    const existing = new Set(Array.from(select.options).map((o) => o.value));
    for (const c of countries) {
      if (existing.has(c)) continue;
      const opt = document.createElement('option');
      opt.value = c; opt.textContent = c;
      select.appendChild(opt);
    }
    if (current) select.value = current;
  }

  function renderSchedule(schedule) {
    lastSchedule = schedule;
    document.getElementById('next-run-local').textContent = fmt.dateLocal(schedule.nextRunUTC);
    document.getElementById('next-run-relative').textContent = fmt.relative(schedule.nextRunUTC);
    document.getElementById('next-run-utc').textContent = schedule.nextRunUTC || '—';
    document.getElementById('schedule-source').innerHTML = '<code>' + escapeHtml(schedule.source || '—') + '</code>';
    document.getElementById('cron-pill').innerHTML = schedule.cron ? '<code>' + escapeHtml(schedule.cron) + '</code>' : '—';
  }

  function renderSource(profile, registryCount, catalogCount) {
    document.getElementById('source-name').textContent = profile.name || '—';
    const link = document.getElementById('source-url');
    link.textContent = profile.baseUrl || '—';
    link.href = profile.baseUrl || '#';
    const tierEl = document.getElementById('source-tier');
    tierEl.className = 'tier tier--' + (profile.tier || 'partner');
    tierEl.textContent = (profile.tier || 'partner').toUpperCase();
    document.getElementById('registry-count').textContent = registryCount;
    document.getElementById('catalog-count').textContent = catalogCount;
  }

  // Next update date for one aggregator. Primary source: dayOfMonth — fixed
  // calendar day from scrape-staggered.yml (this month if not yet passed, else
  // next month) at 03:00 UTC (cron hour). Falls back to lastRunAt+intervalDays,
  // then to the global scrape-monthly pass.
  function aggregatorNextRunFromDayOfMonth(dom) {
    if (!dom) return null;
    const now = new Date();
    let candidate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), dom, 3, 0, 0));
    if (candidate <= now) {
      candidate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, dom, 3, 0, 0));
    }
    return candidate.toISOString();
  }
  function aggregatorNextRun(agg) {
    if (agg && agg.dayOfMonth) {
      return aggregatorNextRunFromDayOfMonth(agg.dayOfMonth);
    }
    if (agg && agg.lastRunAt) {
      const days = agg.intervalDays || 30;
      return new Date(new Date(agg.lastRunAt).getTime() + days * 86400000).toISOString();
    }
    return lastSchedule ? lastSchedule.nextRunUTC : null;
  }

  // Drive both cards from the chosen aggregator: identity (right) + next update (left).
  function applyAggregatorSelection(slug) {
    const agg = (lastAggregators || []).find((a) => a.slug === slug);
    if (!agg) return;
    document.getElementById('source-name').textContent = agg.name || '—';
    const link = document.getElementById('source-url');
    link.textContent = agg.baseUrl || '—';
    link.href = agg.baseUrl || '#';
    const tierEl = document.getElementById('source-tier');
    tierEl.className = 'tier tier--' + (agg.tier || 'partner');
    tierEl.textContent = (agg.tier || 'partner').toUpperCase();

    const nextISO = aggregatorNextRun(agg);
    const days = agg.intervalDays || 30;
    document.getElementById('next-run-local').textContent = fmt.dateLocal(nextISO);
    document.getElementById('next-run-relative').textContent = fmt.relative(nextISO);
    document.getElementById('next-run-utc').textContent = nextISO || '—';
    document.getElementById('schedule-source').innerHTML = escapeHtml(
      agg.dayOfMonth
        ? agg.name + ': ' + agg.dayOfMonth + ' число месяца'
        : agg.lastRunAt ? agg.name + ': каждые ' + days + ' дн.' : agg.name + ': при следующем scrape-monthly',
    );
    document.getElementById('cron-pill').innerHTML = agg.dayOfMonth
      ? '<code>' + agg.dayOfMonth + ' числа</code>'
      : agg.lastRunAt
      ? '<code>+' + days + 'д</code>'
      : (lastSchedule && lastSchedule.cron ? '<code>' + escapeHtml(lastSchedule.cron) + '</code>' : '—');
  }

  // Populate the aggregator <select>; preserve the current pick across refreshes.
  function setupSourceSelector(aggregators) {
    const sel = document.getElementById('source-select');
    if (!sel) return;
    const list = aggregators || [];
    const prev = sel.value;
    sel.innerHTML = list
      .map((a) => '<option value="' + escapeHtml(a.slug) + '">' + escapeHtml(a.name || a.slug) + '</option>')
      .join('');
    const initial = list.some((a) => a.slug === prev) ? prev : (list[0] && list[0].slug);
    if (initial) sel.value = initial;
    if (!sourceSelectWired) {
      sel.addEventListener('change', () => applyAggregatorSelection(sel.value));
      sourceSelectWired = true;
    }
    if (initial) applyAggregatorSelection(initial);
  }

  function renderLogSummary(run) {
    const el = document.getElementById('log-summary');
    if (run.running) el.textContent = 'идёт…';
    else if (run.startedAt && run.finishedAt) {
      const dur = Math.round((new Date(run.finishedAt) - new Date(run.startedAt)) / 1000);
      el.textContent = 'длительность ' + dur + ' с';
    } else el.textContent = '';
  }

  let isStaticMode = false;

  function setHealth(state) {
    const pill = document.querySelector('#health .status-pill');
    const txt = document.getElementById('health-text');
    const offlineBanner = document.getElementById('offline-banner');
    const staticBanner = document.getElementById('static-banner');
    pill.className = 'status-pill';
    const runBtn = document.getElementById('run-all-btn');
    const verifyBtn = document.getElementById('verify-btn');
    if (state === 'online') {
      isOnline = true;
      pill.classList.add('status-pill--ok');
      txt.textContent = 'Панель управления онлайн';
      offlineBanner.hidden = true;
      staticBanner.hidden = true;
      runBtn.disabled = false;
      verifyBtn.disabled = false;
    } else if (state === 'static') {
      // Static-snapshot mode: both buttons now work via GitHub Actions.
      isOnline = true;
      pill.classList.add('status-pill--ok');
      txt.textContent = 'Снимок данных — запуск через GitHub Actions';
      offlineBanner.hidden = true;
      staticBanner.hidden = false;
      runBtn.disabled = false;
      verifyBtn.disabled = false;
    } else {
      isOnline = false;
      pill.classList.add('status-pill--fail');
      txt.textContent = 'Панель управления оффлайн';
      offlineBanner.hidden = false;
      staticBanner.hidden = true;
      runBtn.disabled = true;
      verifyBtn.disabled = true;
    }
  }

  async function fetchStatus() {
    const url = getControlUrl();
    // Empty url = static-snapshot mode. Cloudflare Pages serves
    // public/api/status.json at /api/status.json (with extension); the local
    // control panel exposes /api/status (no extension). Pick the right path.
    const statusPath = url ? '/api/status' : '/api/status.json';
    try {
      const res = await fetch(url + statusPath, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      isStaticMode = data.isStaticSnapshot === true || !url;
      setHealth(isStaticMode ? 'static' : 'online');

      // Populate lastRegistry first so renderRunStatus() can use the real
      // count when composing the idle-state summary line.
      lastRegistry = data.registry || [];
      renderSchedule(data.schedule);
      const catalogCount = data.registry.filter((r) => r.catalog).length;
      renderSource(data.sourceProfile, data.registry.length, catalogCount);
      renderRunStatus(data.run);
      renderDirectors(data.directors, data.gaps);
      renderAggregatorSchedules(data.aggregators || []);
      syncAggregatorChips(data.aggregators || [], data.registry);
      setupSourceSelector(data.aggregators || []);
      syncCountryOptions(data.registry);
      renderRegistry(data.registry);
      renderLog(data.run.log);
      renderLogSummary(data.run);

      // Static-snapshot data never changes between page loads — skip polling
      // and let the user refresh manually. Live control-panel mode still polls.
      clearTimeout(pollTimer);
      if (!isStaticMode) {
        const next = data.run.running ? POLL_INTERVAL_RUNNING_MS : POLL_INTERVAL_IDLE_MS;
        pollTimer = setTimeout(fetchStatus, next);
      }
    } catch (err) {
      console.warn('manager status fetch failed', err);
      setHealth('offline');
      clearTimeout(pollTimer);
      pollTimer = setTimeout(fetchStatus, POLL_INTERVAL_OFFLINE_MS);
    }
  }

  async function postJson(path, body) {
    const url = getControlUrl();
    const res = await fetch(url + path, {
      method: 'POST',
      headers: body ? { 'content-type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    if (!res.ok) {
      const text = await res.text();
      throw new Error('HTTP ' + res.status + ': ' + text);
    }
    return res.json();
  }

  const GITHUB_REPO = 'kovylin1/studyroom-project-site';
  const GITHUB_REF = 'main';
  const VERIFY_WORKFLOW        = 'verify-on-demand.yml';
  const REVIZOR_APPLY_WORKFLOW = 'revizor-apply.yml';
  const SOROKA_APPLY_WORKFLOW  = 'soroka-apply.yml';
  const SOROKA_RUN_WORKFLOW    = 'soroka-on-demand.yml';
  const OREL_WORKFLOW          = 'orel-on-demand.yml';
  const PAUK_WORKFLOW          = 'pauk-on-demand.yml';
  const BOBR_WORKFLOW          = 'bobr-on-demand.yml';
  const BUMBLEBEE_WORKFLOW     = 'bumblebee-on-demand.yml';
  const SCRAPE_WORKFLOW        = 'scrape-monthly.yml';
  const FIX_FRESHNESS_WORKFLOW = 'fix-freshness.yml';
  const GITHUB_TOKEN_KEY = 'studyroom.manager.githubToken';
  const RAW_BASE =
    'https://raw.githubusercontent.com/' + GITHUB_REPO + '/' + GITHUB_REF;

  function getGithubToken() {
    try {
      return localStorage.getItem(GITHUB_TOKEN_KEY) || '';
    } catch {
      return '';
    }
  }

  function setGithubToken(token) {
    try {
      if (token) localStorage.setItem(GITHUB_TOKEN_KEY, token);
      else localStorage.removeItem(GITHUB_TOKEN_KEY);
    } catch {}
    refreshGithubConn();
  }

  function refreshGithubConn() {
    const dot = document.getElementById('github-conn-dot');
    const text = document.getElementById('github-conn-text');
    const btn = document.getElementById('github-conn-btn');
    const has = !!getGithubToken();
    dot.classList.toggle('manager__github-dot--on', has);
    dot.classList.toggle('manager__github-dot--off', !has);
    text.textContent = has ? 'GitHub подключён' : 'GitHub не подключён';
    btn.textContent = has ? 'сменить токен' : 'подключить';
  }

  function promptForGithubToken() {
    const current = getGithubToken();
    const next = prompt(
      'GitHub PAT (fine-grained, scopes «Actions: Read and write» + «Contents: Read and write» на ' + GITHUB_REPO + ').\n\n' +
      'Создать: https://github.com/settings/personal-access-tokens/new\n\n' +
      'Пустое значение — удалить токен. Хранится в localStorage этого браузера.',
      current,
    );
    if (next === null) return null;
    const trimmed = next.trim();
    setGithubToken(trimmed);
    return trimmed || null;
  }

  function sleep(ms) {
    return new Promise((r) => setTimeout(r, ms));
  }

  // ---------- remote-run progress card ----------

  let remoteRunTimer = null;
  let remoteRunStartTs = null;

  function showRemoteRun(label, statusText, pillClass) {
    const card = document.getElementById('remote-run');
    const sum = document.getElementById('remote-run-summary');
    const pill = document.getElementById('remote-run-status');
    const pillText = document.getElementById('remote-run-status-text');
    card.hidden = false;
    sum.textContent = label;
    pill.className = 'status-pill ' + (pillClass || 'status-pill--running');
