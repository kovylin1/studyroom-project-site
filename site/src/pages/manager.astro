  // ── Dropdown helpers ─────────────────────────────────────────────────────
  function toggleMenu(triggerId, menuId) {
    const trigger = document.getElementById(triggerId);
    const menu = document.getElementById(menuId);
    if (!trigger || !menu) return;
    const open = !menu.hidden;
    menu.hidden = open;
    trigger.setAttribute('aria-expanded', String(!open));
  }

  function closeAllMenus() {
    [['verify-btn','verify-menu'],['fix-freshness-btn','fix-menu']].forEach(([t,m]) => {
      const menu = document.getElementById(m);
      const trigger = document.getElementById(t);
      if (menu) menu.hidden = true;
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.verify-dropdown')) closeAllMenus();
  });

  document.getElementById('verify-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMenu('verify-btn', 'verify-menu');
    document.getElementById('fix-menu').hidden = true;
  });

  document.getElementById('verify-menu').addEventListener('click', async (e) => {
    const item = e.target.closest('[data-verify-scope]');
    if (!item) return;
    const scope = item.dataset.verifyScope;
    closeAllMenus();
    const btn = document.getElementById('verify-btn');
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.innerHTML = 'Проверяем…';
    const inputs = scope === 'all' ? { scope: 'all' } : { scope: 'critical' };
    const ok = await runRemoteWorkflow({
      workflowFile: VERIFY_WORKFLOW,
      label: 'Проверка актуальности (' + scope + ')',
      expectedMin: scope === 'all' ? 25 : 10,
      inputs,
    });
    btn.disabled = false;
    btn.innerHTML = orig;
    if (ok) fetchStatus();
  });

  document.getElementById('fix-freshness-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMenu('fix-freshness-btn', 'fix-menu');
    document.getElementById('verify-menu').hidden = true;
  });

  document.getElementById('fix-menu').addEventListener('click', async (e) => {
    const item = e.target.closest('[data-fix-scope]');
    if (!item) return;
    const scope = item.dataset.fixScope;
    closeAllMenus();
    const btn = document.getElementById('fix-freshness-btn');
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.innerHTML = 'Исправляем…';
    const inputs = { scope };
    await runRemoteWorkflow({
      workflowFile: FIX_FRESHNESS_WORKFLOW,
      label: 'Исправить актуальность (' + scope + ')',
      expectedMin: scope === 'all' ? 40 : 20,
      inputs,
    });
    btn.disabled = false;
    btn.innerHTML = orig;
    fetchStatus();
  });

  for (const [id, wf, label, mins] of [
    ['pauk-run-btn', PAUK_WORKFLOW, 'ПАУК (программы)', 30],
    ['bobr-run-btn', BOBR_WORKFLOW, 'БОБР (кампусы)', 20],
    ['orel-run-btn', OREL_WORKFLOW, 'ОРЁЛ (фото)', 40],
  ]) {
