  // Совпадение каталога с живым сайтом источника: берём последний прогон
  // РЕВИЗОРа и считаем по вузам ВЫБРАННОГО источника — общий процент о нём
  // ничего не говорит. Когда по источнику никого не проверяли, честно
  // показываем цифру по всем и так и подписываем.
  function renderSourceMatch() {
    const pctEl = document.getElementById('source-match-pct');
    const noteEl = document.getElementById('source-match-note');
    if (!pctEl || !noteEl) return;
    const data = lastVerify;
    const reports = (data && Array.isArray(data.reports)) ? data.reports : [];
    if (reports.length === 0) {
      pctEl.textContent = '—';
      pctEl.className = '';
      noteEl.textContent = 'совпадение ещё не проверялось';
      return;
    }
    const sel = document.getElementById('source-select');
    const slug = sel ? sel.value : '';
    const inSource = new Set(
      (lastRegistry || [])
        .filter((r) => (slug === DIRECT_FILTER
          ? r.partnerType === 'direct'
          : rowAggregatorSlugs(r).includes(slug)))
        .map((r) => r.slug),
    );
    const mine = reports.filter((r) => inSource.has(r.slug));
    const scope = mine.length ? mine : reports;
    const alive = scope.reduce((n, r) => n + (r.alive || 0), 0);
    const sampled = scope.reduce((n, r) => n + (r.sampled || 0), 0);
    if (sampled === 0) {
      pctEl.textContent = '—';
      pctEl.className = '';
      noteEl.textContent = 'совпадение ещё не проверялось';
      return;
    }
    const pct = Math.round((alive / sampled) * 100);
    pctEl.textContent = pct + '%';
    pctEl.className = pct >= 80 ? 'source-match--ok' : pct >= 50 ? 'source-match--warn' : 'source-match--fail';
    const ago = fmt.ago(data.generatedAt) || '—';
    noteEl.textContent = (mine.length ? '' : 'по всем: ') + alive + ' из ' + sampled + ' · ' + ago;
    noteEl.title = (mine.length
      ? 'Совпало ' + alive + ' из ' + sampled + ' проверенных программ этого источника'
      : 'По этому источнику проверок ещё не было — цифра по всем источникам')
      + '. Последняя проверка: ' + ago + '.';
  }

