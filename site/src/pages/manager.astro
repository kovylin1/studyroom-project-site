---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { FIELDS, fieldsFor } from '~/scripts/fields';
import { annualTuitionValues } from '../lib/tuition';
import { CURRENCY_TO_KZT, DEFAULT_KZT_RATE } from '~/content/studyroom/static';

// Default control URL is empty string = relative path. On the public deploy,
// `${''}/api/status` resolves to `/api/status` and hits the static snapshot
// baked by `scripts/generate-status.mjs`. Users can override via localStorage
// to point at the local control panel (e.g. `http://localhost:5174`) when
// running it to trigger scrapes manually.
const CONTROL_DEFAULT_URL = '';

// Цены, IELTS и направления фильтруются по каталогу: в снимке реестра этих
// полей нет вовсе. Карта компактная — три значения на вуз — и уезжает
// в клиентский скрипт рядом с остальным состоянием. Цена приведена к тенге,
// иначе суммы разных стран несравнимы.
const uniEntries = await getCollection('universities');
const FACETS = Object.fromEntries(uniEntries.map((entry) => {
  const u = entry.data;
  const annual = annualTuitionValues(u.tuition, u.programs);
  const rate = CURRENCY_TO_KZT[u.tuition.currency] ?? DEFAULT_KZT_RATE;
  // Одна склейка названий на вуз вместо вызова на каждую из 124 тысяч программ.
  const titles = u.programs.map((p) => p.title || '').join(' ').toLowerCase();
  return [u.slug, {
    kzt: annual.length ? Math.round(Math.min(...annual) * rate) : null,
    ielts: u.requirements?.language?.ielts ?? null,
    fields: fieldsFor(titles),
  }];
}));
const FIELD_OPTIONS = FIELDS.map((x) => ({ id: x.id, label: x.label }));
// Верхняя граница ползунка — 95-й процентиль, а не максимум: одна карточка
// с ценой под сто миллионов растягивает шкалу так, что весь каталог сминается
// в первую пятую её часть. Крайнее правое положение значит «любая».
const priceValues = Object.values(FACETS).map((x) => x.kzt).filter((x) => x).sort((a, b) => a - b);
const p95 = priceValues[Math.floor(priceValues.length * 0.95)] || 1;
const TUITION_MAX_KZT = Math.ceil(p95 / 1_000_000) * 1_000_000;
---

<Base
  title="Управление каталогом — StudyRoom"
  description="Внутренняя страница менеджера: ручной запуск скрапера и статус последнего обновления."
  noindex
>
  <section class="manager">
    <div class="container">
      <header class="manager__head">
        <div>
          <p class="manager__eyebrow">Менеджер · внутренний инструмент</p>
          <h1 class="manager__title">Обновление каталога</h1>
          <p class="manager__lead">
            Запускайте скрапер вручную, отслеживайте статус и смотрите лог. Расписание
            по&nbsp;умолчанию — раз в&nbsp;месяц через GitHub Actions.
          </p>
        </div>
        <div class="manager__health" id="health">
          <span class="status-pill status-pill--idle">
            <span class="status-pill__dot"></span>
            <span id="health-text">Подключение…</span>
          </span>
          <span class="manager__github" id="github-conn">
            <span id="github-conn-dot" class="manager__github-dot manager__github-dot--off" aria-hidden="true"></span>
            <span id="github-conn-text">GitHub не подключён</span>
            <button id="github-conn-btn" class="link-btn" type="button">подключить</button>
          </span>
          <span class="manager__health-url">
            API: <code id="health-url">{CONTROL_DEFAULT_URL || '/api/status.json (снимок)'}</code>
            <button id="health-edit" class="link-btn" type="button">изменить</button>
          </span>
        </div>
      </header>

      <div id="offline-banner" class="banner banner--warn" hidden>
        <strong>Панель управления не отвечает.</strong>
        Запустите её локально: <code>cd control &amp;&amp; npm start</code>. По&nbsp;умолчанию слушает
        <code>http://localhost:5174</code>.
      </div>

      <div id="static-banner" class="banner banner--info" hidden>
        <strong>Режим снимка.</strong>
        Обе кнопки запускают GitHub Actions: данные подтянутся сюда автоматически по&nbsp;завершении (проверка актуальности — ~2&nbsp;мин, полный скрапинг — до&nbsp;~15&nbsp;мин).
        Нужен fine-grained PAT с правом <code>Actions: Read and write</code> — нажмите «подключить» в шапке.
      </div>

      <div class="cards">
        <article class="card">
          <header class="card__head">
            <h2 class="card__title">Следующий запуск</h2>
            <span id="cron-pill" class="card__title card__title--mono"></span>
          </header>
          <p class="card__big" id="next-run-local">—</p>
          <p class="card__sub" id="next-run-relative">Ждём данные…</p>
          <dl class="meta">
            <div><dt>UTC</dt><dd id="next-run-utc">—</dd></div>
            <div><dt>Источник</dt><dd id="schedule-source">—</dd></div>
          </dl>
          <div class="card__footer">
            <span class="source-match" id="source-match" title="Доля проверенных программ, где наша карточка совпала с живым сайтом источника">
              <strong id="source-match-pct">—</strong>
              <span class="muted" id="source-match-note">совпадение с сайтом источника</span>
            </span>
            <span class="card__footer-actions">
              <span id="run-status" class="status-pill status-pill--idle">
                <span class="status-pill__dot"></span>
                <span id="run-status-text">Ожидание</span>
              </span>
              <button id="run-all-btn" class="btn btn-primary" type="button">Запустить сейчас</button>
            </span>
          </div>
        </article>

        <article class="card">
          <header class="card__head">
            <h2 class="card__title">Источник данных</h2>
            <span id="source-tier" class="tier tier--partner">PARTNER</span>
          </header>
          <p class="card__big" id="source-name">—</p>
          <a id="source-url" class="card__link" href="#" target="_blank" rel="noopener">—</a>
          <label class="source-select__label" for="source-select">Выбрать агрегатор</label>
          <select id="source-select" class="filter-panel__select source-select"></select>
          <dl class="meta">
            <div><dt>В реестре</dt><dd><strong id="registry-count">—</strong></dd></div>
            <div><dt>В каталоге сейчас</dt><dd><strong id="catalog-count">—</strong></dd></div>
          </dl>
        </article>
      </div>


      <details class="card card--flush card--registry" id="registry-card" open>
        <summary class="registry-summary">
          <span class="card__title">Реестр университетов</span>
          <span class="muted registry-summary__hint">свернуть</span>
        </summary>
          <div class="filterbar-mini">
            <label class="filterbar-mini__search">
              <span aria-hidden="true" class="filterbar-mini__search-icon">🔍</span>
              <input
                id="filter-search"
                type="search"
                placeholder="Поиск по слагу или названию…"
                autocomplete="off"
              />
            </label>
            <button
              id="filter-toggle"
              class="btn btn-ghost btn-sm filterbar-mini__toggle"
              type="button"
              aria-expanded="false"
              aria-controls="filter-panel"
            >
              <span>Фильтры</span>
              <span id="filter-count" class="filterbar-mini__count" hidden></span>
              <span aria-hidden="true" class="filterbar-mini__chev">▾</span>
            </button>
            <button id="filter-reset" class="btn btn-ghost btn-sm" type="button">Сбросить</button>
            <span id="filter-result-count" class="filterbar-mini__result muted"></span>
          </div>
  
          <div id="filter-panel" class="filter-panel" data-open="false">
            <div class="filter-panel__inner">
              <div class="filter-panel__group">
                <span class="filter-panel__label">
                  Источник
                  <span class="filter-panel__hint" id="filter-aggregator-hint">выбрано: все</span>
                </span>
                <div class="filter-panel__chips" id="filter-aggregator-chips">
                  <button class="chip chip--active" type="button" data-filter="aggregator" data-value="">Все</button>
                  <button class="chip" type="button" data-filter="aggregator" data-value="__direct">Прямые партнёры</button>
                </div>
              </div>

              <div class="filter-panel__group">
                <span class="filter-panel__label">
                  Страна
                  <span class="filter-panel__hint" id="filter-country-hint">не более 5</span>
                </span>
                <div class="filter-panel__boxes" id="filter-country-boxes"></div>
              </div>

              <div class="filter-panel__group">
                <span class="filter-panel__label">
                  Специальность
                  <span class="filter-panel__hint" id="filter-field-hint">любая</span>
                </span>
                <div class="filter-panel__boxes filter-panel__boxes--wide" id="filter-field-boxes">
                  {FIELD_OPTIONS.map((x) => (
                    <label class="filter-box">
                      <input type="checkbox" value={x.id} />
                      <span>{x.label}</span>
                    </label>
                  ))}
                </div>
              </div>

              <div class="filter-panel__group filter-panel__group--narrow">
                <span class="filter-panel__label">IELTS не выше</span>
                <input id="filter-ielts" class="filter-panel__select" type="number" min="0" max="9" step="0.5" placeholder="любой" />
              </div>

              <div class="filter-panel__group">
                <span class="filter-panel__label">
                  Цена за год
                  <span class="filter-panel__hint" id="filter-price-hint">любая</span>
                </span>
                <input id="filter-price" type="range" min="0" max={TUITION_MAX_KZT} step="500000" value={TUITION_MAX_KZT} data-max={TUITION_MAX_KZT} />
              </div>
  
            </div>
          </div>
  
          <div class="table-wrap">
            <table class="manager__table">
              <thead>
                <tr>
                  <th>Слаг</th>
                  <th>Университет</th>
                  <th>Город</th>
                  <th>Сайт</th>
                  <th>Тир</th>
                  <th>Агрегатор</th>
                  <th>В каталоге</th>
                  <th>Последняя проверка</th>
                  <th>Gap</th>
                  <th aria-label="Действие"></th>
                </tr>
              </thead>
              <tbody id="registry-tbody">
                <tr>
                  <td colspan="10" class="table-loading">Загрузка реестра…</td>
                </tr>
              </tbody>
            </table>
          </div>
      </details>

      <article class="card card--agg-schedules" id="agg-schedules-card">
        <header class="card__head">
          <h2 class="card__title">Агрегаторы — последний прогон</h2>
          <span id="agg-overdue-pill" class="muted" style="font-size:0.8rem"></span>
        </header>
        <div class="table-wrap">
          <table class="manager__table agg-table">
            <thead>
              <tr>
                <th>Агрегатор</th>
                <th>Тир</th>
                <th>Число / следующее</th>
                <th>Интервал</th>
                <th>Последний прогон</th>
                <th>Статус</th>
              </tr>
            </thead>
            <tbody id="agg-schedules-tbody">
              <tr><td colspan="6" class="table-loading">Загрузка…</td></tr>
            </tbody>
          </table>
        </div>
      </article>


      <article id="remote-run" class="card manager__remote-run" hidden>
        <header class="card__head">
          <h2 class="card__title">Удалённый запуск (GitHub Actions)</h2>
          <span id="remote-run-status" class="status-pill status-pill--idle">
            <span class="status-pill__dot"></span>
            <span id="remote-run-status-text">—</span>
          </span>
        </header>
        <p class="card__sub" id="remote-run-summary">—</p>
        <div class="manager__remote-meta">
          <span>Прошло: <strong id="remote-run-elapsed">0&nbsp;с</strong></span>
          <a id="remote-run-link" href="#" target="_blank" rel="noopener" hidden>лог GitHub →</a>
        </div>
      </article>


      <article class="card card--flush log-card">
        <header class="log-card__head">
          <h2 class="card__title">Лог последнего запуска</h2>
          <span id="log-summary" class="muted log-card__summary"></span>
        </header>
        <pre id="log-output" class="log"><span class="log__empty">Лог пустой. Запустите скрапер, чтобы увидеть вывод.</span></pre>
      </article>
    </div>
  </section>
</Base>

<style>
  .manager { padding: 56px 0 96px; background: var(--color-bg-soft); min-height: calc(100vh - 200px); }
  .manager__head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    flex-wrap: wrap; margin-bottom: 32px;
  }
  .manager__eyebrow {
    margin: 0 0 8px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-primary-dark);
  }
  .manager__title { margin: 0 0 8px; font-size: clamp(28px, 4vw, 40px); }
  .manager__lead { margin: 0; max-width: 640px; color: var(--color-text-muted); }
  .manager__health { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .manager__health-url { font-size: 0.8rem; color: var(--color-text-muted); }
  .manager__health-url code {
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
    background: var(--color-bg); padding: 1px 6px; border-radius: 6px; border: 1px solid var(--color-border);
  }
  .link-btn {
    background: none; border: none; padding: 0 0 0 6px; color: var(--color-primary-dark);
    font: inherit; font-size: 0.8rem; cursor: pointer; text-decoration: underline;
  }
  .link-btn:hover { color: var(--color-primary); }

  .banner {
    padding: 14px 18px; border-radius: var(--radius-card); margin-bottom: 24px;
    border: 1px solid; font-size: 0.92rem;
  }
  .banner--warn { background: #fff4cc; border-color: #f1d782; color: #5a4200; }
  .banner--info { background: var(--color-primary-soft); border-color: var(--color-primary); color: var(--color-primary-dark); }
  .banner code {
    background: rgba(0,0,0,0.06); padding: 1px 6px; border-radius: 6px;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
  }

  .manager__github {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.8rem; color: var(--color-text-muted);
  }
  .manager__github-dot {
    width: 8px; height: 8px; border-radius: 50%; display: inline-block;
  }
  .manager__github-dot--on { background: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
  .manager__github-dot--off { background: var(--color-text-faint); }

  .manager__remote-run {
    margin-bottom: 24px;
    border: 1px solid var(--color-primary);
    background: linear-gradient(180deg, var(--color-primary-soft) 0%, var(--color-bg) 100%);
  }
  .manager__remote-meta {
    display: flex; flex-wrap: wrap; gap: 24px;
    font-size: 0.9rem; margin-top: 12px;
    color: var(--color-text-muted);
  }
  .manager__remote-meta a { color: var(--color-primary-dark); font-weight: 600; }
  .manager__remote-meta a:hover { text-decoration: underline; }

  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }

  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: var(--shadow-card);
  }
  .card--flush { padding: 0; overflow: hidden; margin-bottom: 24px; }
  .card__head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 16px; gap: 16px;
  }
  .card__title {
    margin: 0; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-text-muted); font-weight: 700;
  }
  .card__title--mono {
    text-transform: none; letter-spacing: 0; font-weight: 500;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
  }
  .card__big {
    margin: 0; font-size: 1.9rem; font-weight: 900; line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .card__sub { margin: 8px 0 0; color: var(--color-text-muted); }
  .card__link {
    display: inline-block; margin-top: 6px;
    font-size: 0.95rem; word-break: break-all;
  }

  .source-select__label {
    display: block; margin-top: 12px; margin-bottom: 4px;
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .source-select { width: 100%; }

  .meta { margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .meta > div { display: flex; justify-content: space-between; font-size: 0.85rem; gap: 12px; }
  .meta dt { color: var(--color-text-muted); margin: 0; }
  .meta dd { margin: 0; text-align: right; }

  /* Подвал карточки расписания: слева совпадение с источником, справа запуск. */
  .card__footer {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap; margin-top: 16px;
    padding-top: 14px; border-top: 1px solid var(--color-border);
  }
  .card__footer-actions { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; flex: 0 0 auto; }
  .source-match { display: flex; flex-direction: column; gap: 2px; font-size: 0.82rem; min-width: 0; }
  .source-match strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .source-match--ok { color: var(--color-primary-dark); }
  .source-match--warn { color: #8a4b00; }
  .source-match--fail { color: #c83232; }

  .filter-panel__hint { margin-left: 8px; font-weight: 400; color: var(--color-text-muted); font-size: 0.76rem; }
  .filter-panel__boxes {
    display: flex; flex-wrap: wrap; gap: 6px 14px;
    max-height: 168px; overflow-y: auto; padding: 4px 2px;
  }
  .filter-box { display: inline-flex; align-items: center; gap: 6px; font-size: 0.84rem; cursor: pointer; }
  .filter-box input { width: 15px; height: 15px; accent-color: var(--color-primary); cursor: pointer; }
  .filter-box--off { opacity: 0.4; cursor: default; }
  .filter-box--off input { cursor: default; }
  .filter-panel__boxes--wide { max-height: none; }
  .filter-panel__group--narrow { max-width: 150px; }
  #filter-price { width: 100%; max-width: 280px; accent-color: var(--color-primary); }

  /* Реестр сворачивается: он длинный, а нужен не в каждую сессию. */
  .card--registry { margin-bottom: 24px; }
  .registry-summary {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 16px 20px; cursor: pointer; list-style: none;
  }
  .registry-summary::-webkit-details-marker { display: none; }
  .registry-summary__hint { font-size: 0.78rem; }
  .card--registry[open] .registry-summary { border-bottom: 1px solid var(--color-border); }
  .card--registry:not([open]) .registry-summary__hint::after { content: " ▾"; }
  .card--registry[open] .registry-summary__hint::after { content: " ▴"; }


  .status-pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 14px; border-radius: var(--radius-pill);
    font-size: 0.82rem; font-weight: 600;
  }
  .status-pill__dot { width: 8px; height: 8px; border-radius: 50%; }
  .status-pill--idle { background: var(--color-bg-soft); color: var(--color-text-muted); }
  .status-pill--idle .status-pill__dot { background: var(--color-text-faint); }
  .status-pill--running { background: var(--color-primary-soft); color: var(--color-primary-dark); }
  .status-pill--running .status-pill__dot { background: var(--color-primary); animation: pulse 1.2s infinite; }
  .status-pill--ok { background: var(--color-primary-soft); color: var(--color-primary-dark); }
  .status-pill--ok .status-pill__dot { background: var(--color-primary); }
  .status-pill--fail { background: #fce8e8; color: #c43030; }
  .status-pill--fail .status-pill__dot { background: #c43030; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  /* ---------- compact filter bar + rolldown ---------- */
  .filterbar-mini {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    padding: 14px 16px; border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .filterbar-mini__search {
    flex: 1 1 240px; min-width: 200px;
    display: flex; align-items: center; gap: 8px;
    padding: 6px 12px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .filterbar-mini__search:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }
  .filterbar-mini__search input {
    flex: 1; border: none; outline: none; background: transparent;
    font: inherit; font-size: 0.88rem; color: var(--color-text);
    padding: 4px 0;
  }
  .filterbar-mini__search input::-webkit-search-cancel-button { cursor: pointer; }
  .filterbar-mini__search-icon { font-size: 0.85rem; opacity: 0.6; }

  .filterbar-mini__toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px;
  }
  .filterbar-mini__chev {
    font-size: 0.7rem; transition: transform 200ms ease;
  }
  .filterbar-mini__toggle[aria-expanded="true"] .filterbar-mini__chev {
    transform: rotate(180deg);
  }
  .filterbar-mini__count {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 18px; height: 18px; padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--color-primary); color: #fff;
    font-size: 0.7rem; font-weight: 700;
  }
  .filterbar-mini__result {
    margin-left: auto; font-size: 0.8rem; white-space: nowrap;
  }

  .filter-panel {
    max-height: 0; overflow: hidden;
    transition: max-height 260ms ease, border-color 260ms ease;
    border-bottom: 1px solid transparent;
    background: var(--color-bg-soft);
  }
  .filter-panel[data-open="true"] {
    max-height: 600px;
    border-bottom-color: var(--color-border);
  }
  .filter-panel__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px 24px;
    padding: 16px 20px 20px;
  }
  .filter-panel__group { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .filter-panel__label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-text-muted);
  }
  .filter-panel__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter-panel__select {
    padding: 6px 10px; border: 1px solid var(--color-border);
    border-radius: 10px; background: var(--color-bg);
    font: inherit; font-size: 0.85rem; color: var(--color-text);
    outline: none; max-width: 100%;
  }
  .filter-panel__select:focus { border-color: var(--color-primary); }

  .chip {
    display: inline-flex; align-items: center;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-pill);
    font: inherit; font-size: 0.78rem; font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
    white-space: nowrap;
  }
  .chip:hover:not(.chip--active) { border-color: var(--color-primary); color: var(--color-primary); }
  .chip--active {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .table-wrap { overflow-x: auto; }
  .manager__table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .manager__table th, .manager__table td {
    padding: 12px 16px; text-align: left;
    border-bottom: 1px solid var(--color-border); vertical-align: middle;
  }
  .manager__table th {
    background: var(--color-bg-soft);
    font-weight: 700; font-size: 0.74rem;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .manager__table tr:last-child td { border-bottom: none; }
  .manager__table code {
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
    font-size: 0.86rem;
  }
  .table-loading {
    text-align: center; color: var(--color-text-faint); padding: 32px;
  }

  .tier {
    display: inline-block; padding: 2px 9px;
    border-radius: var(--radius-pill);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tier--partner { background: var(--color-primary-soft); color: var(--color-primary-dark); }
  .tier--official { background: #fff4cc; color: #6b4d00; }
  .tier--aggregator { background: var(--color-bg-soft); color: var(--color-text-muted); }
  .agg-chips { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .checked-fresh { color: var(--color-primary-dark); font-weight: 600; }
  .checked-stale { color: #c47a30; font-weight: 600; }
  .checked-never { color: var(--color-text-faint); font-style: italic; }
  .table-link { color: var(--color-text); text-decoration: none; }
  .table-link:hover { color: var(--color-primary-dark); text-decoration: underline; }
  .table-link code { transition: color 120ms ease; }
  .table-link:hover code { color: var(--color-primary-dark); }

  .gap-critical { color: #c43030; font-weight: 700; font-size: 0.8rem; }
  .gap-high { color: #c47a30; font-weight: 600; font-size: 0.8rem; }
  .gap-medium { color: var(--color-text-muted); font-size: 0.8rem; }

  /* ---------- run selector modal ---------- */
  .run-selector-overlay {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: flex-end; justify-content: center;
  }
  .run-selector-overlay[hidden] { display: none; }
  .run-selector-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);
  }
  .run-selector-sheet {
    position: relative; z-index: 1;
    width: 100%; max-width: 540px;
    background: var(--color-bg);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    padding: 28px 24px 32px;
    box-shadow: 0 -8px 32px rgba(0,0,0,0.15);
    animation: slideUp 180ms ease;
  }
  @keyframes slideUp { from { transform: translateY(60px); opacity: 0; } to { transform: none; opacity: 1; } }
  .run-selector__title { margin: 0 0 20px; font-size: 1.1rem; font-weight: 700; }
  .run-opts { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
  .run-opt {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 12px; cursor: pointer;
    border: 1px solid var(--color-border);
    transition: background 120ms ease, border-color 120ms ease;
  }
  .run-opt:hover { background: var(--color-bg-soft); }
  .run-opt:has(.run-opt__check:checked) {
    background: var(--color-primary-soft); border-color: var(--color-primary);
  }
  .run-opt__check { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--color-primary); }
  .run-opt__body { display: flex; align-items: center; gap: 8px; flex: 1; flex-wrap: wrap; }
  .run-opt__label { font-weight: 700; font-size: 0.95rem; }
  .run-opt__desc { font-size: 0.82rem; flex: 1; }
  .run-opt__time { font-size: 0.75rem; margin-left: auto; white-space: nowrap; }
  .run-selector__actions { display: flex; gap: 12px; justify-content: flex-end; }

  .log-card__head {
    padding: 16px 20px; border-bottom: 1px solid var(--color-border);
    display: flex; justify-content: space-between; align-items: center;
  }
  .log-card__summary { font-size: 0.85rem; }
  .log {
    background: #0f0f0f; color: #e6e6e6;
    font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, monospace;
    font-size: 0.82rem; line-height: 1.5;
    padding: 16px 20px;
    max-height: 380px; overflow-y: auto;
    white-space: pre-wrap; word-break: break-word;
    margin: 0;
  }
  .log__line { display: block; }
  .log__line--ok { color: #93e695; }
  .log__line--fail { color: #ff8a8a; }
  .log__line--warn { color: #ffd699; }
  .log__line--meta { color: #888; }
  .log__empty { padding: 24px 0; text-align: center; color: #888; font-style: italic; display: block; }
</style>

<script define:vars={{ controlDefaultUrl: CONTROL_DEFAULT_URL, FACETS, TUITION_MAX_KZT }}>
  const STORAGE_KEY = 'studyroom.manager.controlUrl';
  const POLL_INTERVAL_RUNNING_MS = 1500;
  const POLL_INTERVAL_IDLE_MS = 8000;
  const POLL_INTERVAL_OFFLINE_MS = 5000;

  let pollTimer = null;
  let isOnline = false;
  let lastRegistry = [];
  let lastAggregators = [];
  let lastSchedule = null;
  let sourceSelectWired = false;
  // Источников и стран можно выбрать несколько; страны ограничены пятью,
  // иначе фильтр перестаёт что-либо сужать.
  const COUNTRY_LIMIT = 5;
  const filters = {
    search: '',
    aggregators: new Set(),
    countries: new Set(),
    fields: new Set(),
    maxIelts: null,
    maxKzt: null,
  };

  function getControlUrl() {
    try {
      return localStorage.getItem(STORAGE_KEY) || controlDefaultUrl;
    } catch {
      return controlDefaultUrl;
    }
  }

  function setControlUrl(url) {
    try {
      if (url) localStorage.setItem(STORAGE_KEY, url);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {}
    const current = getControlUrl();
    document.getElementById('health-url').textContent =
      current || '/api/status.json (снимок)';
  }

  const fmt = {
    dateLocal(iso) {
      if (!iso) return '—';
      return new Date(iso).toLocaleString('ru-RU', {
        day: '2-digit', month: 'long', year: 'numeric',
        hour: '2-digit', minute: '2-digit',
      });
    },
    relative(iso) {
      if (!iso) return '—';
      const diffMs = new Date(iso) - new Date();
      const totalMin = Math.round(diffMs / 60000);
      if (totalMin < 0) return 'в прошлом';
      if (totalMin < 60) return 'через ' + totalMin + ' мин';
      const totalHr = Math.round(totalMin / 60);
      if (totalHr < 24) return 'через ' + totalHr + ' ч';
      const days = Math.round(totalHr / 24);
      return 'через ' + days + ' дн';
    },
    ago(iso) {
      if (!iso) return null;
      const diffMs = new Date() - new Date(iso);
      const totalMin = Math.round(diffMs / 60000);
      if (totalMin < 1) return 'только что';
      if (totalMin < 60) return totalMin + ' мин назад';
      const totalHr = Math.round(totalMin / 60);
      if (totalHr < 24) return totalHr + ' ч назад';
      const days = Math.round(totalHr / 24);
      return days + ' дн назад';
    },
    stalenessClass(iso) {
      if (!iso) return 'checked-never';
      const days = (new Date() - new Date(iso)) / (1000 * 60 * 60 * 24);
      return days <= 35 ? 'checked-fresh' : 'checked-stale';
    },
  };

  function classifyLogLine(line) {
    if (/^\[ok\]/.test(line)) return 'log__line--ok';
    if (/^\[fail\]|spawn error|fail/i.test(line)) return 'log__line--fail';
    if (/^\[skip\]|warn/i.test(line)) return 'log__line--warn';
    if (/^[>=]|^Done:/i.test(line)) return 'log__line--meta';
    return '';
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderLog(log) {
    const el = document.getElementById('log-output');
    if (!log || log.length === 0) {
      el.innerHTML = '<span class="log__empty">Лог пустой. Запустите скрапер, чтобы увидеть вывод.</span>';
      return;
    }
    el.innerHTML = log.map((entry) => {
      const cls = classifyLogLine(entry.line);
      return '<span class="log__line ' + cls + '">' + escapeHtml(entry.line) + '</span>';
    }).join('\n');
    el.scrollTop = el.scrollHeight;
  }

  let lastRunRunning = false;
  let lastRunTarget = null;

  function renderRunStatus(run) {
    const pill = document.getElementById('run-status');
    const txt = document.getElementById('run-status-text');
    const btn = document.getElementById('run-all-btn');

    // Прогон проверки закончился — обновляем процент совпадения.
    if (lastRunRunning && !run.running && lastRunTarget === 'verify') {
      refreshVerifySummary();
    }
    lastRunRunning = !!run.running;
    lastRunTarget = run.currentTarget;

    pill.className = 'status-pill';

    if (run.running) {
      pill.classList.add('status-pill--running');
      txt.textContent = run.currentTarget === 'verify' ? 'Идёт проверка' : 'Идёт скрапинг';
      btn.disabled = true;
      btn.textContent = 'Идёт…';
    } else if (run.exitCode === null) {
      pill.classList.add('status-pill--idle');
      txt.textContent = 'Ожидание';
      btn.disabled = !isOnline;
      btn.textContent = 'Запустить сейчас';
    } else if (run.exitCode === 0) {
      pill.classList.add('status-pill--ok');
      txt.textContent = 'Успешно · ' + fmt.ago(run.finishedAt);
      btn.disabled = !isOnline;
      btn.textContent = 'Запустить снова';
    } else {
      pill.classList.add('status-pill--fail');
      txt.textContent = 'Ошибка (код ' + run.exitCode + ')';
      btn.disabled = !isOnline;
      btn.textContent = 'Повторить';
    }
  }

  const DIRECT_FILTER = '__direct';

  function rowMatchesFilters(row) {
    if (filters.search) {
      const q = filters.search.toLowerCase();
      if (!row.slug.toLowerCase().includes(q) && !row.name.toLowerCase().includes(q)) return false;
    }
    if (filters.countries.size > 0 && !filters.countries.has(row.country)) return false;
    // Цена, IELTS и направления живут в каталоге; у вуза без нужного значения
    // строка при активном фильтре не проходит — иначе фильтр ничего не сужает.
    if (filters.fields.size > 0 || filters.maxIelts !== null || filters.maxKzt !== null) {
      const facet = FACETS[row.slug];
      if (!facet) return false;
      if (filters.maxKzt !== null && !(facet.kzt !== null && facet.kzt <= filters.maxKzt)) return false;
      if (filters.maxIelts !== null && !(facet.ielts !== null && facet.ielts <= filters.maxIelts)) return false;
      if (filters.fields.size > 0 && !facet.fields.some((id) => filters.fields.has(id))) return false;
    }
    // '__direct' — не агрегатор, а вузы, с которыми работаем напрямую:
    // строка проходит, если совпал хоть один из выбранных источников.
    if (filters.aggregators.size > 0) {
      const slugs = rowAggregatorSlugs(row);
      const hit = Array.from(filters.aggregators).some((v) =>
        v === DIRECT_FILTER ? row.partnerType === 'direct' : slugs.includes(v));
      if (!hit) return false;
    }
    return true;
  }

  function aggregatorLabel(slug) {
    if (!slug) return '—';
    const found = lastAggregators.find((a) => a.slug === slug);
    return found ? found.name : slug;
  }

  // Все агрегаторы вуза: новый снимок кладёт массив aggregatorSlugs (КОМПАС-карта),
  // старый — одиночный aggregatorSlug; поддерживаем оба.
  function rowAggregatorSlugs(row) {
    if (Array.isArray(row.aggregatorSlugs)) return row.aggregatorSlugs;
    return row.aggregatorSlug ? [row.aggregatorSlug] : [];
  }

  function aggregatorCell(row) {
    const chips = [];
    if (row.partnerType === 'direct') {
      chips.push('<span class="tier tier--partner">прямой</span>');
    }
    for (const slug of rowAggregatorSlugs(row)) {
      const agg = lastAggregators.find((a) => a.slug === slug);
      const tier = agg?.tier || 'aggregator';
      chips.push('<span class="tier tier--' + escapeHtml(tier) + '">' + escapeHtml(agg ? agg.name : slug) + '</span>');
    }
    return chips.length ? '<span class="agg-chips">' + chips.join('') + '</span>' : '<span class="muted">—</span>';
  }

  // Ссылка на официальный сайт вуза: менеджеру она нужна чаще всего, чтобы
  // проверить цену глазами. Домен короче полного URL и читается в узкой ячейке.
  function siteCell(row) {
    const url = row.officialUrl;
    if (!url) return '<span class="muted">—</span>';
    let host = url;
    try { host = new URL(url).hostname.replace(/^www./, ''); } catch {}
    return '<a href="' + escapeHtml(url) + '" target="_blank" rel="noopener" class="table-link">' + escapeHtml(host) + '</a>';
  }

  function renderRegistry(registry) {
    lastRegistry = registry || [];
    const tbody = document.getElementById('registry-tbody');
    if (lastRegistry.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" class="table-loading">Реестр пуст. Проверьте sources/universities.list.md</td></tr>';
      updateResultCount(0, 0);
      return;
    }
    const filtered = lastRegistry.filter(rowMatchesFilters);
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" class="table-loading">Ничего не найдено. Попробуйте сбросить фильтры.</td></tr>';
      updateResultCount(0, lastRegistry.length);
      return;
    }
    tbody.innerHTML = filtered.map((row) => {
      const inCatalog = row.catalog ? 'да' : '—';
      const checked = row.catalog && row.catalog.lastChecked;
      const checkedLabel = checked ? fmt.ago(checked) : 'никогда';
      const checkedCls = fmt.stalenessClass(checked);
      const disabledAttr = isOnline ? '' : ' disabled';
      const aggCell = aggregatorCell(row);
      const slugLink = '<a href="/' + escapeHtml(row.slug) + '" target="_blank" rel="noopener" class="table-link"><code>' + escapeHtml(row.slug) + '</code></a>';
      const nameLink = '<a href="/' + escapeHtml(row.slug) + '" target="_blank" rel="noopener" class="table-link">' + escapeHtml(row.name || '—') + '</a>';
      return '<tr>' +
        '<td>' + slugLink + '</td>' +
        '<td>' + nameLink + '</td>' +
        '<td>' + escapeHtml(row.city) + '</td>' +
        '<td>' + siteCell(row) + '</td>' +
        '<td><span class="tier tier--' + escapeHtml(row.tier) + '">' + escapeHtml(row.tier) + '</span></td>' +
        '<td>' + aggCell + '</td>' +
        '<td>' + inCatalog + '</td>' +
        '<td><span class="' + checkedCls + '">' + checkedLabel + '</span></td>' +
        '<td>' + (row.gapPriority ? '<span class="gap-' + escapeHtml(row.gapPriority) + '">' + escapeHtml(row.gapPriority) + '</span>' : '') + '</td>' +
        '<td><button class="btn btn-ghost btn-sm" data-run-slug="' + escapeHtml(row.slug) + '"' + disabledAttr + '>обновить</button></td>' +
        '</tr>';
    }).join('');
    updateResultCount(filtered.length, lastRegistry.length);
  }

  function updateResultCount(shown, total) {
    const el = document.getElementById('filter-result-count');
    if (!el) return;
    el.textContent = total === 0 ? '' : (shown === total ? total + ' из ' + total : shown + ' из ' + total);
  }

  function countActiveFilters() {
    let n = 0;
    if (filters.search) n++;
    if (filters.aggregators.size > 0) n++;
    if (filters.countries.size > 0) n++;
    if (filters.fields.size > 0) n++;
    if (filters.maxIelts !== null) n++;
    if (filters.maxKzt !== null) n++;
    return n;
  }

  function refreshFilterCountBadge() {
    const n = countActiveFilters();
    const badge = document.getElementById('filter-count');
    if (!badge) return;
    if (n === 0) {
      badge.hidden = true;
      badge.textContent = '';
    } else {
      badge.hidden = false;
      badge.textContent = String(n);
    }
  }

  function applyFiltersAndRerender() {
    refreshFilterCountBadge();
    renderRegistry(lastRegistry);
  }

  function syncAggregatorChips(aggregators, registry) {
    lastAggregators = aggregators || [];
    const container = document.getElementById('filter-aggregator-chips');
    if (!container) return;
    const existing = new Set(Array.from(container.querySelectorAll('.chip')).map((c) => c.dataset.value));
    for (const agg of lastAggregators) {
      if (existing.has(agg.slug)) continue;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.dataset.filter = 'aggregator';
      btn.dataset.value = agg.slug;
      btn.textContent = agg.name;
      container.appendChild(btn);
      existing.add(agg.slug);
    }
    // Add chips for any aggregator slug found in registry but not yet listed
    for (const row of (registry || [])) {
      for (const slug of rowAggregatorSlugs(row)) {
        if (existing.has(slug)) continue;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip';
        btn.dataset.filter = 'aggregator';
        btn.dataset.value = slug;
        btn.textContent = slug;
        container.appendChild(btn);
        existing.add(slug);
      }
    }
    syncAggregatorChipState();
  }

  // Вид чипов повторяет набор: «Все» подсвечен, когда не выбрано ничего.
  function syncAggregatorChipState() {
    const container = document.getElementById('filter-aggregator-chips');
    if (!container) return;
    const picked = filters.aggregators;
    container.querySelectorAll('.chip').forEach((chip) => {
      const v = chip.dataset.value || '';
      chip.classList.toggle('chip--active', v === '' ? picked.size === 0 : picked.has(v));
    });
    const hint = document.getElementById('filter-aggregator-hint');
    if (hint) hint.textContent = picked.size === 0 ? 'выбрано: все' : 'выбрано: ' + picked.size;
  }

  // Страны — чекбоксы: их полсотни, чипами такой список не читается.
  function syncCountryOptions(registry) {
    const box = document.getElementById('filter-country-boxes');
    if (!box || box.childElementCount > 0) return;
    const countries = Array.from(new Set((registry || []).map((r) => r.country).filter(Boolean)))
      .sort((a, b) => a.localeCompare(b, 'ru'));
    box.innerHTML = countries
      .map((c) => '<label class="filter-box"><input type="checkbox" value="' + escapeHtml(c) + '"><span>' + escapeHtml(c) + '</span></label>')
      .join('');
    syncCountryBoxState();
  }

  // Больше пяти стран разом фильтр не сужает, поэтому лишние гасим.
  function syncCountryBoxState() {
    const box = document.getElementById('filter-country-boxes');
    if (!box) return;
    const atLimit = filters.countries.size >= COUNTRY_LIMIT;
    box.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      cb.checked = filters.countries.has(cb.value);
      cb.disabled = atLimit && !cb.checked;
      const label = cb.closest('.filter-box');
      if (label) label.classList.toggle('filter-box--off', cb.disabled);
    });
    const hint = document.getElementById('filter-country-hint');
    if (hint) {
      hint.textContent = filters.countries.size === 0
        ? 'не более ' + COUNTRY_LIMIT
        : filters.countries.size + ' из ' + COUNTRY_LIMIT;
    }
  }

  // Тенге в подписи: миллионами, чтобы семизначные числа не съедали строку.
  function kztShort(v) {
    return v >= 1000000 ? (v / 1000000).toFixed(1).replace('.', ',').replace(',0', '') + ' млн ₸' : Math.round(v / 1000) + ' тыс ₸';
  }

  function syncFieldHint() {
    const hint = document.getElementById('filter-field-hint');
    if (hint) hint.textContent = filters.fields.size === 0 ? 'любая' : 'выбрано: ' + filters.fields.size;
  }

  function syncPriceHint() {
    const hint = document.getElementById('filter-price-hint');
    if (!hint) return;
    hint.textContent = filters.maxKzt === null ? 'любая' : 'не дороже ' + kztShort(filters.maxKzt);
  }

  document.getElementById('filter-price').addEventListener('input', (e) => {
    const v = Number(e.target.value);
    const max = Number(e.target.dataset.max);
    filters.maxKzt = v >= max ? null : v;
    syncPriceHint();
    applyFiltersAndRerender();
  });

  document.getElementById('filter-ielts').addEventListener('input', (e) => {
    const v = parseFloat(e.target.value);
    filters.maxIelts = Number.isFinite(v) ? v : null;
    applyFiltersAndRerender();
  });

  document.addEventListener('change', (e) => {
    const box = e.target;
    if (!(box instanceof HTMLInputElement) || box.type !== 'checkbox') return;
    if (!box.closest('#filter-field-boxes')) return;
    if (box.checked) filters.fields.add(box.value);
    else filters.fields.delete(box.value);
    syncFieldHint();
    applyFiltersAndRerender();
  });

  document.addEventListener('change', (e) => {
    const cb = e.target;
    if (!(cb instanceof HTMLInputElement) || cb.type !== 'checkbox') return;
    if (!cb.closest('#filter-country-boxes')) return;
    if (cb.checked) {
      if (filters.countries.size >= COUNTRY_LIMIT) { cb.checked = false; return; }
      filters.countries.add(cb.value);
    } else {
      filters.countries.delete(cb.value);
    }
    syncCountryBoxState();
    applyFiltersAndRerender();
  });

  function renderSchedule(schedule) {
    lastSchedule = schedule;
    document.getElementById('next-run-local').textContent = fmt.dateLocal(schedule.nextRunUTC);
    document.getElementById('next-run-relative').textContent = fmt.relative(schedule.nextRunUTC);
    document.getElementById('next-run-utc').textContent = schedule.nextRunUTC || '—';
    document.getElementById('schedule-source').innerHTML = '<code>' + escapeHtml(schedule.source || '—') + '</code>';
    document.getElementById('cron-pill').innerHTML = schedule.cron ? '<code>' + escapeHtml(schedule.cron) + '</code>' : '—';
