  // ── РЕВИЗОР decisions panel ──────────────────────────────────────────────

  // Источники кейсов аудита. Формат items идентичен (РЕВИЗОР-схема), поэтому
  // рендер общий; различаются только файл, apply-workflow и localStorage-ключ.
  const REVIEW_SRCS = [
    {
      key: 'revizor', title: 'РЕВИЗОР',
      api: '/api/revizor-review.json',
      contentPath: 'site/public/api/revizor-review.json',
      workflow: REVIZOR_APPLY_WORKFLOW,
      lsKey: 'studyroom.revizor.decisions',
    },
    {
      key: 'soroka', title: 'СОРОКА',
      api: '/api/soroka-review.json',
      contentPath: 'site/public/api/soroka-review.json',
      workflow: SOROKA_APPLY_WORKFLOW,
      lsKey: 'studyroom.soroka.decisions',
    },
  ];
  const srcState = {};   // key → { cfg, data }  (data = полный JSON источника)
  let reviewData = null; // объединённый вид { items: [...] } для рендера

  const srcOf = (item) => srcState[item && item.__src];

  async function loadReviewData() {
    const merged = [];
    for (const cfg of REVIEW_SRCS) {
      try {
        const ts = Date.now();
        const res = await fetch(cfg.api + '?ts=' + ts, { cache: 'no-store' });
        if (!res.ok) continue;
        const data = await res.json();
        srcState[cfg.key] = { cfg, data };
        // Восстанавливаем локальные решения поверх данных с сервера
        const local = loadDecisionsLocal(cfg.lsKey);
        // Чистим решения с прошлых запусков: их кейсов больше нет в свежем review.
        const currentIds = new Set((data.items || []).map(i => i.id));
        let prunedLocal = false;
        for (const id of Object.keys(local)) {
          if (!currentIds.has(id)) { delete local[id]; prunedLocal = true; }
        }
        if (prunedLocal) { try { localStorage.setItem(cfg.lsKey, JSON.stringify(local)); } catch {} }
        for (const item of (data.items || [])) {
          item.__src = cfg.key;
          if (local[item.id] && item.decision === null) {
            item.decision = local[item.id].decision;
            item.decidedAt = local[item.id].decidedAt;
          }
          merged.push(item);
        }
      } catch {}
    }
    reviewData = { items: merged };
    renderReviewPanel();
  }

  function issueLabel(issue) {
    const map = {
      missing_on_site: 'не найдены на официальном сайте',
      broken_url: '404 — битая ссылка',
      tuition_mismatch: 'расхождение стоимости обучения',
      ielts_changed: 'изменились требования IELTS',
      tuition_zero: 'цена обучения не заполнена (0)',
      tuition_outlier: 'цена обучения вне диапазона',
      ielts_implausible: 'неправдоподобный балл IELTS',
    };
    return map[issue] || issue;
  }

  function decisionActions(item) {
    const decided = item.decision;
    const btn = (a) =>
      `<button class="review-btn${a.danger ? ' review-btn--danger' : ''}${decided === a.value ? ' review-btn--active' : ''}" data-id="${item.id}" data-decision="${a.value}">${a.label}</button>`;
    // Кейсы без авто-фикса значения (СОРОКА: неправдоподобный IELTS) — только
    // «Игнорировать»; реальное значение правится руками (пункт B).
    if (item.issue === 'ielts_implausible') {
      return [{ value: 'ignore', label: 'Игнорировать', danger: false }].map(btn).join('');
    }
    const isMismatch = item.issue === 'tuition_mismatch' || item.issue === 'ielts_changed';
    if (isMismatch) {
      return [
        { value: 'update', label: 'Обновить', danger: false },
        { value: 'ignore', label: 'Игнорировать', danger: false },
      ].map(btn).join('');
    }
    return [
      { value: 'delete', label: 'Удалить', danger: true },
      { value: 'ignore', label: 'Игнорировать', danger: false },
    ].map(btn).join('');
  }

  function renderReviewPanel() {
    if (!reviewData) return;
    const panel = document.getElementById('review-panel');
    const badge = document.getElementById('review-panel-badge');
    const list = document.getElementById('review-items-list');
    const actions = document.getElementById('review-actions');

    const pending = (reviewData.items || []).filter(i => !i.applied);
    if (!pending.length) { panel.hidden = true; return; }

    panel.hidden = false;
    // Show only cases that still need a decision — once decided, a case drops out
    // of the list so the operator isn't confused by already-handled items.
    const open = pending.filter(i => i.decision === null);
    const decidedCount = pending.length - open.length;
    badge.textContent = open.length + ' требуют решения';
    badge.hidden = false;

    if (open.length === 0) {
      list.innerHTML = `<li class="review-item review-item--alldone">Все кейсы обработаны (${decidedCount}). Нажмите «Применить решения».</li>`;
    } else {
      list.innerHTML = open.map(item => {
        const severity = item.severity === 'critical' ? 'critical' : 'warning';
        const programsHtml = (item.programs || []).slice(0, 5).map(p => `<span class="muted">${p.title}</span>`).join(', ');
        return `<li class="review-item review-item--${severity}">
          <div class="review-item__head">
            <span class="review-item__name">${item.name}</span>
            <span class="review-item__issue">${(srcOf(item)?.cfg.title ? srcOf(item).cfg.title + ' · ' : '')}${issueLabel(item.issue)}</span>
          </div>
          ${programsHtml ? `<div class="review-item__detail">${programsHtml}</div>` : ''}
          ${item.detail ? `<div class="review-item__detail">${item.detail}</div>` : ''}
          <div class="review-item__actions">${decisionActions(item)}</div>
        </li>`;
      }).join('');
    }

    actions.hidden = decidedCount === 0;
  }

  function saveDecisionLocal() {
    try {
      for (const cfg of REVIEW_SRCS) {
        const st = srcState[cfg.key];
        if (!st) continue;
        const decisions = {};
        for (const item of (st.data.items || [])) {
          if (item.decision !== null) decisions[item.id] = { decision: item.decision, decidedAt: item.decidedAt };
        }
        try { localStorage.setItem(cfg.lsKey, JSON.stringify(decisions)); } catch {}
      }
    } catch {}
  }

  function loadDecisionsLocal(lsKey) {
    try {
      return JSON.parse(localStorage.getItem(lsKey) || '{}');
    } catch { return {}; }
  }

  // Сохраняет решение — сначала в localStorage, потом пробует GitHub Contents API
  // Возвращает статус синхронизации: { synced, onlyLocal, reason }.
  //  synced=true     → решение записано и локально, и в GitHub.
  //  onlyLocal=true  → записано только в localStorage (нет токена / нет прав / сеть).
  async function saveDecision(itemId, decision, { skipRender = false } = {}) {
    const item = (reviewData?.items || []).find(i => i.id === itemId);
    if (!item) return { synced: false, onlyLocal: true, reason: 'not-found' };
    const src = srcOf(item);
    if (!src) return { synced: false, onlyLocal: true, reason: 'no-src' };
    item.decision = decision;
    item.decidedAt = new Date().toISOString();

    const pending = (src.data.items || []).filter(i => i.decision === null).length;
    src.data.summary = { ...src.data.summary, pending };

    // Сохраняем локально сразу — решение не потеряется даже без GitHub
    saveDecisionLocal();
    if (!skipRender) renderReviewPanel();

    // Пробуем синхронизировать с GitHub (нужно Contents: Read and write)
    const token = getGithubToken();
    if (!token) return { synced: false, onlyLocal: true, reason: 'no-token' };

    const tag = src.cfg.key;
    const apiBase = 'https://api.github.com/repos/' + GITHUB_REPO + '/contents/' + src.cfg.contentPath;
    try {
      const shaRes = await fetch(apiBase + '?ref=' + GITHUB_REF, {
        headers: { Authorization: 'Bearer ' + token, Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' },
      });
      if (!shaRes.ok) {
        console.warn(tag + ': не удалось получить SHA файла (' + shaRes.status + '). Решение сохранено локально.');
        return { synced: false, onlyLocal: true, reason: 'no-sha-' + shaRes.status };
      }
      const shaData = await shaRes.json();
      const sha = shaData.sha;
      if (!sha) {
        console.warn(tag + ': SHA файла пустой. Решение сохранено локально.');
        return { synced: false, onlyLocal: true, reason: 'empty-sha' };
      }
      // Пишем JSON конкретного источника (без служебного поля __src).
      const payload = { ...src.data, items: (src.data.items || []).map(({ __src, ...rest }) => rest) };
      const content = btoa(unescape(encodeURIComponent(JSON.stringify(payload, null, 2) + '\n')));
      const putRes = await fetch(apiBase, {
        method: 'PUT',
        headers: { Authorization: 'Bearer ' + token, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json', 'X-GitHub-Api-Version': '2022-11-28' },
        body: JSON.stringify({ message: 'chore: ' + tag + ' decision ' + decision + ' for ' + item.slug, content, sha, branch: GITHUB_REF }),
      });
      if (!putRes.ok) {
        const status = putRes.status;
        if (status === 403 || status === 404) {
          console.warn(tag + ': нет прав Contents API (нужен scope «Contents: Read and write»). Решение сохранено локально.');
        } else {
          console.warn(tag + ': GitHub API ' + status + '. Решение сохранено локально.');
        }
        return { synced: false, onlyLocal: true, reason: 'put-' + status };
      }
      return { synced: true, onlyLocal: false };
    } catch (e) {
      console.warn(tag + ': ошибка GitHub API:', e.message, '— решение сохранено локально.');
      return { synced: false, onlyLocal: true, reason: 'network' };
    }
  }

  const REVIEW_DECISION_LABEL = { delete: 'удалить', update: 'обновить', ignore: 'игнорировать' };
  function showReviewFeedback(message, kind) {
    const el = document.getElementById('review-feedback');
    if (!el) return;
    el.textContent = message;
    el.className = 'manager__review-feedback manager__review-feedback--' + (kind || 'ok');
    el.hidden = false;
    if (showReviewFeedback._t) clearTimeout(showReviewFeedback._t);
    showReviewFeedback._t = setTimeout(() => { el.hidden = true; }, kind === 'warn' ? 8000 : 4000);
  }

  // Клики по кнопкам решений (event delegation)
  document.getElementById('review-items-list').addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-decision]');
    if (!btn) return;
    const itemId = btn.dataset.id;
    const decision = btn.dataset.decision;
    if (btn.disabled) return; // уже в обработке — без двойных кликов
    // Блокируем ВСЕ кнопки этого кейса, не только нажатую
    const li = btn.closest('li.review-item');
    const itemBtns = li ? Array.from(li.querySelectorAll('[data-decision]')) : [btn];
    itemBtns.forEach(b => { b.disabled = true; });
    // Защитный таймаут: если сеть зависнет, разблокируем кнопки
    const safety = setTimeout(() => { itemBtns.forEach(b => { b.disabled = false; }); }, 12000);

    try {
      // Анимация: выезд вправо → схлопывание (оптимистично — локально решение уже не потеряется)
      if (li) {
        const h = li.offsetHeight;
        li.style.maxHeight = h + 'px';
        li.classList.add('review-item--exiting');
        await new Promise(r => setTimeout(r, 270));
        li.classList.add('review-item--collapsing');
        await new Promise(r => setTimeout(r, 190));
      }

      const result = await saveDecision(itemId, decision, { skipRender: true });
      clearTimeout(safety);

      if (result && result.reason === 'not-found') {
        // Кейс пропал из данных — откат анимации и разблокировка
        if (li) {
          li.classList.remove('review-item--exiting', 'review-item--collapsing');
          li.style.maxHeight = '';
        }
        itemBtns.forEach(b => { b.disabled = false; });
        showReviewFeedback('Кейс не найден — обновите панель', 'warn');
        return;
      }

      const label = REVIEW_DECISION_LABEL[decision] || decision;
      if (result && result.synced) {
        showReviewFeedback('Решение «' + label + '» сохранено и в GitHub', 'ok');
      } else if (result && result.onlyLocal && result.reason !== 'no-token') {
        showReviewFeedback('Решение «' + label + '» сохранено локально, но НЕ в GitHub (проверь токен/права). Нажми «Применить решения» позже.', 'warn');
      }
      renderReviewPanel();
    } catch (err) {
      clearTimeout(safety);
      itemBtns.forEach(b => { b.disabled = false; });
      showReviewFeedback('Ошибка сохранения решения: ' + (err && err.message ? err.message : err), 'warn');
    }
  });

  // "Применить решения" → revizor-apply.yml
  document.getElementById('review-apply-btn').addEventListener('click', async () => {
    const btn = document.getElementById('review-apply-btn');
    btn.disabled = true;
    btn.textContent = 'Запускаем…';
    try {
      // Запускаем apply-workflow каждого источника, у которого есть принятые,
      // но ещё не применённые решения (РЕВИЗОР и/или СОРОКА).
      const toRun = REVIEW_SRCS.filter(cfg => {
        const st = srcState[cfg.key];
        return st && (st.data.items || []).some(i => i.decision !== null && !i.applied);
      });
      if (!toRun.length) {
        showReviewFeedback('Нет решений для применения', 'warn');
        return;
      }
      for (const cfg of toRun) {
        await runRemoteWorkflow({ workflowFile: cfg.workflow, label: cfg.title + ' Apply', expectedMin: 5 });
      }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Применить решения';
    }
  });

  // Загрузка при старте
  loadReviewData();

  document.addEventListener('click', async (e) => {
    const target = e.target;
    if (!target || !(target instanceof HTMLElement)) return;
    const slug = target.dataset?.runSlug;
    if (!slug) return;
    if (isStaticMode) {
      alert(
        'Отдельный скрап одного университета доступен только в локальной панели.\n' +
        'В режиме снимка нажмите «Запустить скрапинг сейчас» — обновятся все университеты через GitHub Actions.',
      );
      return;
    }
    target.disabled = true;
    const original = target.textContent;
    target.textContent = '…';
    try {
      await postJson('/api/run-one', { slug });
    } catch (err) {
      alert('Не удалось запустить ' + slug + ': ' + err.message);
      target.disabled = false;
      target.textContent = original;
    }
    fetchStatus();
