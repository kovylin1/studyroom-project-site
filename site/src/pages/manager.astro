  document.getElementById('health-edit').addEventListener('click', () => {
    const current = getControlUrl();
    const next = prompt('URL панели управления (control-panel API):', current);
    if (next === null) return;
    const trimmed = next.trim().replace(/\/$/, '');
    if (trimmed && !/^https?:\/\//.test(trimmed)) {
      alert('URL должен начинаться с http:// или https://');
      return;
    }
    setControlUrl(trimmed || null);
    fetchStatus();
  });

  function debounce(fn, wait) {
    let t;
    return function (...args) {
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), wait);
    };
  }

  document.getElementById('filter-search').addEventListener(
    'input',
    debounce((e) => {
      filters.search = e.target.value.trim();
      applyFiltersAndRerender();
    }, 120),
  );

  document.getElementById('filter-toggle').addEventListener('click', () => {
    const btn = document.getElementById('filter-toggle');
    const panel = document.getElementById('filter-panel');
    const isOpen = panel.dataset.open === 'true';
    panel.dataset.open = isOpen ? 'false' : 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
  });

  document.getElementById('filter-country').addEventListener('change', (e) => {
    filters.country = e.target.value;
    applyFiltersAndRerender();
  });

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.classList.contains('chip')) return;
    const kind = target.dataset.filter;
    const value = target.dataset.value || '';
    if (!kind) return;

    if (kind === 'tier') {
      if (filters.tiers.has(value)) filters.tiers.delete(value);
      else filters.tiers.add(value);
      target.classList.toggle('chip--active');
    } else {
      filters[kind] = value;
      const group = target.parentElement;
      if (group) {
        group.querySelectorAll('.chip').forEach((c) => c.classList.remove('chip--active'));
      }
      target.classList.add('chip--active');
    }
    applyFiltersAndRerender();
  });

  document.getElementById('filter-reset').addEventListener('click', () => {
    filters.search = '';
    filters.aggregator = '';
    filters.tiers.clear();
    filters.country = '';
    filters.status = '';
    filters.freshness = '';

    document.getElementById('filter-search').value = '';
    document.getElementById('filter-country').value = '';
    document.querySelectorAll('#filter-panel .chip').forEach((chip) => {
      chip.classList.toggle('chip--active', chip.dataset.value === '');
    });
    applyFiltersAndRerender();
  });

  function renderAggregatorSchedules(aggregators) {
    const tbody = document.getElementById('agg-schedules-tbody');
    const pill = document.getElementById('agg-overdue-pill');
    if (!tbody) return;
    const list = aggregators || [];
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="table-loading">Нет данных</td></tr>';
      return;
    }
    let overdueCount = 0;
    tbody.innerHTML = list.map((agg) => {
      const lastRun = agg.lastRunAt;
      const interval = agg.intervalDays;
      let statusCls, statusLabel, lastLabel;
      if (!lastRun) {
        statusCls = 'agg-status--never';
        statusLabel = 'никогда';
        lastLabel = '—';
      } else {
        const days = (Date.now() - new Date(lastRun).getTime()) / (1000 * 60 * 60 * 24);
        lastLabel = fmt.ago(lastRun);
        if (interval && days > interval) {
          statusCls = 'agg-status--due';
          statusLabel = 'просрочен';
          overdueCount++;
        } else {
          statusCls = 'agg-status--ok';
          statusLabel = 'актуально';
        }
      }
      const tierCls = agg.tier === 'partner' ? 'tier--partner' : agg.tier === 'official' ? 'tier--official' : 'tier--aggregator';
      const schedCell = agg.dayOfMonth
        ? '<strong>' + agg.dayOfMonth + ' число</strong><br><span class="muted">' + escapeHtml(fmt.dateLocal(aggregatorNextRun(agg))) + '</span>'
        : '<span class="muted">—</span>';
      return '<tr>' +
        '<td>' + escapeHtml(agg.name || agg.slug) + '</td>' +
        '<td><span class="tier ' + tierCls + '">' + escapeHtml(agg.tier || '—') + '</span></td>' +
        '<td>' + schedCell + '</td>' +
        '<td>' + (interval ? interval + ' дн' : '—') + '</td>' +
        '<td>' + escapeHtml(lastLabel) + '</td>' +
        '<td><span class="' + statusCls + '">' + statusLabel + '</span></td>' +
        '</tr>';
    }).join('');
    if (pill) {
      pill.textContent = overdueCount > 0 ? overdueCount + ' просрочено' : 'все актуальны';
      pill.className = overdueCount > 0 ? 'agg-status--due' : 'agg-status--ok';
    }
  }

  function renderDirectors(directors, gaps) {
    const STATUS_LABEL = { done: 'Готов', planned: 'Запланирован', 'in-progress': 'В работе' };
    const STATUS_PILL = { done: 'status-pill--ok', planned: 'status-pill--idle', 'in-progress': 'status-pill--running' };
    for (const [key, id] of [['pauk','dir-pauk'],['bobr','dir-bobr'],['orel','dir-orel']]) {
      const d = directors?.[key];
      if (!d) continue;
      const pill = document.querySelector('#' + id + ' .director-item__pill');
      if (!pill) continue;
      const st = d.status || 'planned';
      pill.className = 'director-item__pill status-pill ' + (STATUS_PILL[st] || 'status-pill--idle');
      pill.innerHTML = '<span class="status-pill__dot"></span>' + escapeHtml(STATUS_LABEL[st] || st);
    }
    if (gaps) {
      const el = document.getElementById('gaps-pill');
      if (el) el.textContent = 'Gaps: ' + (gaps.byPriority?.critical || 0) + ' critical · ' + (gaps.byPriority?.high || 0) + ' high · ' + (gaps.byPriority?.medium || 0) + ' medium';
    }
  }

  // ---------- run selector modal ----------

  const RUN_OPTIONS = [
    { value: 'pauk',      label: 'ПАУК',     desc: 'программы',                   wf: PAUK_WORKFLOW,      mins: 30, defaultOn: true  },
    { value: 'bobr',      label: 'БОБР',     desc: 'кампусы · жильё',             wf: BOBR_WORKFLOW,      mins: 20, defaultOn: false },
    { value: 'orel',      label: 'ОРЁЛ',     desc: 'фото',                         wf: OREL_WORKFLOW,      mins: 40, defaultOn: false },
    { value: 'bumblebee', label: 'БАМБЛБИ',  desc: 'автофикс критических проблем', wf: BUMBLEBEE_WORKFLOW, mins: 30, defaultOn: false },
    { value: 'revizor',   label: 'РЕВИЗОР',  desc: 'аудит актуальности ссылок',   wf: VERIFY_WORKFLOW,    mins: 5,  defaultOn: false },
    { value: 'soroka',    label: 'СОРОКА',   desc: 'сверка цен и фактов',          wf: SOROKA_RUN_WORKFLOW, mins: 10, defaultOn: false },
  ];

  function buildRunSelectorHtml() {
    const opts = RUN_OPTIONS.map((o) =>
      '<label class="run-opt">' +
      '<input type="checkbox" class="run-opt__check" value="' + o.value + '"' + (o.defaultOn ? ' checked' : '') + '>' +
      '<span class="run-opt__body">' +
        '<span class="run-opt__label">' + o.label + '</span>' +
        '<span class="run-opt__desc muted">' + o.desc + '</span>' +
        '<span class="run-opt__time muted">~' + o.mins + ' мин</span>' +
      '</span>' +
      '</label>'
    ).join('');
    return '<div class="run-selector-overlay" id="run-selector-overlay">' +
      '<div class="run-selector-backdrop" id="run-selector-backdrop"></div>' +
      '<div class="run-selector-sheet" role="dialog" aria-modal="true" aria-label="Выбор компонентов">' +
        '<h3 class="run-selector__title">Что запускаем?</h3>' +
        '<div class="run-opts" id="run-opts">' + opts + '</div>' +
        '<div class="run-selector__actions">' +
          '<button id="run-selector-cancel" class="btn btn-ghost" type="button">Отмена</button>' +
          '<button id="run-selector-confirm" class="btn btn-primary" type="button">Запустить выбранное</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function openRunSelector() {
    if (document.getElementById('run-selector-overlay')) {
      document.getElementById('run-selector-overlay').hidden = false;
      return;
    }
    document.body.insertAdjacentHTML('beforeend', buildRunSelectorHtml());
    document.getElementById('run-selector-backdrop').addEventListener('click', closeRunSelector);
    document.getElementById('run-selector-cancel').addEventListener('click', closeRunSelector);
    document.getElementById('run-selector-confirm').addEventListener('click', confirmRunSelector);
  }

  function closeRunSelector() {
    const el = document.getElementById('run-selector-overlay');
    if (el) el.hidden = true;
  }

  async function confirmRunSelector() {
    const checks = document.querySelectorAll('#run-opts .run-opt__check:checked');
    const selected = Array.from(checks).map((c) => c.value);
    if (selected.length === 0) { closeRunSelector(); return; }

    closeRunSelector();

    const confirmBtn = document.getElementById('run-selector-confirm');
    if (!isStaticMode) {
      // Live mode: trigger via local control panel
      const runBtn = document.getElementById('run-all-btn');
      runBtn.disabled = true;
      runBtn.textContent = 'Запускаем…';
      try { await postJson('/api/run', { components: selected }); } catch (err) { alert('Ошибка: ' + err.message); }
      runBtn.disabled = false;
      runBtn.textContent = 'Запустить скрапинг сейчас';
      fetchStatus();
      return;
    }

    // Static mode: dispatch each selected workflow sequentially
    for (const val of selected) {
      const opt = RUN_OPTIONS.find((o) => o.value === val);
      if (!opt) continue;
      const ok = await runRemoteWorkflow({ workflowFile: opt.wf, label: opt.label, expectedMin: opt.mins });
      if (!ok) break;
    }
    fetchStatus();
    loadReviewData(); // подтянуть свежие кейсы аудита (СОРОКА/РЕВИЗОР) без релоада
  }

  // Initial label: empty default URL = static snapshot. Match the fallback
  // used by setControlUrl() so reload doesn't blank the field.
  document.getElementById('health-url').textContent =
    getControlUrl() || '/api/status.json (снимок)';
  refreshGithubConn();
  fetchStatus();
  refreshVerifySummary();
</script>
