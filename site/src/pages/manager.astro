  async function refreshVerifySummary() {
    try {
      const res = await fetch('/api/verify.json?ts=' + Date.now(), { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      renderVerifySummary(data);
    } catch {
      // No verify.json yet — leave summary hidden.
    }
  }

  function renderVerifySummary(data) {
    const summary = document.getElementById('verify-summary');
    const text = document.getElementById('verify-summary-text');
    const toggle = document.getElementById('verify-details-toggle');
    const details = document.getElementById('verify-details');
    const list = document.getElementById('verify-details-list');
    if (!data || !Number.isFinite(data.totalSampled) || data.totalSampled === 0) {
      summary.hidden = true;
      details.hidden = true;
      return;
    }
    const ago = fmt.ago(data.generatedAt) || '—';
    text.textContent =
      'Проверено ' + data.totalSampled + ' программ из ' + (data.reports?.length || 0) +
      ' университетов. Актуальность: ' + data.overallFreshnessPct + '%. Последняя проверка: ' + ago + '.';
    summary.hidden = false;
    toggle.hidden = false;
    const reports = (data.reports || []).slice().sort((a, b) => a.freshnessPct - b.freshnessPct);
    list.innerHTML = reports
      .map((r) => {
        const cls = r.freshnessPct >= 80 ? 'ok' : r.freshnessPct >= 50 ? 'warn' : 'fail';
        const issues = [];
        if (r.dead) issues.push(r.dead + ' битых');
        if (r.mismatch) issues.push(r.mismatch + ' несовпадений');
        if (r.errors) issues.push(r.errors + ' ошибок');
        const tail = issues.length ? ' · ' + issues.join(', ') : '';
        return '<li class="verify-row verify-row--' + cls + '">' +
          '<span class="verify-row__name">' + r.name + '</span>' +
          '<span class="verify-row__pct">' + r.freshnessPct + '% (' + r.alive + '/' + r.sampled + ')' + tail + '</span>' +
          '</li>';
      })
      .join('');
  }

  document.getElementById('verify-details-toggle').addEventListener('click', (e) => {
    e.preventDefault();
    const details = document.getElementById('verify-details');
    details.hidden = !details.hidden;
    if (!details.hidden) details.setAttribute('open', '');
    else details.removeAttribute('open');
