---
import Base from '~/layouts/Base.astro';
import CatalogBody from '~/components/CatalogBody.astro';
import { getLocalePaths, useTranslations, type Locale } from '~/i18n/utils';

export function getStaticPaths() {
  return getLocalePaths().map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const titleByLocale: Record<Locale, string> = {
  ru: 'StudyRoom — каталог зарубежных университетов',
  en: 'StudyRoom — catalogue of universities abroad',
  kk: 'StudyRoom — шетелдік университеттер каталогы',
};
---

<Base title={titleByLocale[locale]} description={t('meta.description')}>
  <CatalogBody locale={locale} />
</Base>
