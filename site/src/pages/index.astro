---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import UniversityCard from '~/components/UniversityCard.astro';
import Filters from '~/components/Filters.astro';

const entries = await getCollection('universities');

const universities = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.name.localeCompare(b.name, 'ru'));

const countries = Array.from(new Set(universities.map((u) => u.country))).sort((a, b) =>
  a.localeCompare(b, 'ru'),
);

const levels = Array.from(
  new Set(universities.flatMap((u) => u.programs.map((p) => p.level))),
).sort();

const faculties = Array.from(
  new Set(
    universities
      .flatMap((u) => u.programs.map((p) => p.faculty))
      .filter((f): f is string => Boolean(f)),
  ),
).sort((a, b) => a.localeCompare(b, 'ru'));

const tuitionValues = universities.flatMap((u) => Object.values(u.tuition.byProgram)).filter((v) => v > 0);
const tuitionMax = tuitionValues.length ? Math.max(...tuitionValues) : 0;
---

<Base title="StudyRoom — каталог зарубежных университетов">
  <form id="catalog-filters" autocomplete="off" onsubmit="return false">
    <section class="catalog-hero">
      <div class="container">
        <div class="catalog-hero__inner">
          <h1>Найдите свой университет за рубежом</h1>
          <p class="catalog-hero__lead">
            Каталог партнёрских университетов StudyRoom. Программы, стоимость и дедлайны — обновляются автоматически каждый месяц.
          </p>
          <label class="catalog-hero__search" aria-label="Поиск университета">
            <span aria-hidden="true">🔎</span>
            <input
              type="search"
              name="q"
              placeholder="Например, Glasgow или Computer Science"
              autocomplete="off"
            />
            <button type="button" class="btn btn-primary">Найти</button>
          </label>
        </div>
      </div>
    </section>

    <section class="catalog">
      <div class="container">
        <div class="catalog-filters-wrap">
          <div class="catalog-filters-bar">
            <button
              id="catalog-filters-toggle"
              class="btn btn-ghost btn-sm catalog-filters-bar__toggle"
              type="button"
              aria-expanded="false"
              aria-controls="catalog-filters-panel"
            >
              <span>Фильтры</span>
              <span id="catalog-filters-count" class="catalog-filters-bar__count" hidden></span>
              <span aria-hidden="true" class="catalog-filters-bar__chev">▾</span>
            </button>
            <button type="reset" form="catalog-filters" class="btn btn-ghost btn-sm">Сбросить</button>
            <span id="catalog-filters-result" class="catalog-filters-bar__result muted"></span>
          </div>
          <div id="catalog-filters-panel" class="catalog-filters-panel" data-open="false">
            <Filters countries={countries} levels={levels} faculties={faculties} tuitionMax={tuitionMax} />
          </div>
        </div>

        <p class="catalog__count">
          Найдено: <strong id="catalog-count">{universities.length}</strong> университетов
        </p>

        <div class="catalog__grid" id="catalog-grid">
          {universities.map((data) => <UniversityCard data={data} />)}
        </div>

        <p class="catalog__empty muted" id="catalog-empty" hidden>
          По заданным фильтрам ничего не нашлось — попробуйте ослабить условия.
        </p>
      </div>
    </section>
  </form>
</Base>

<style is:global>
  /* ---------- catalog filter pulldown (mirrors /manager UX) ---------- */
  .catalog-filters-wrap {
    margin-bottom: 16px;
  }
  .catalog-filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
  }
  .catalog-filters-bar__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .catalog-filters-bar__chev {
    font-size: 0.7rem;
    transition: transform 200ms ease;
  }
  .catalog-filters-bar__toggle[aria-expanded="true"] .catalog-filters-bar__chev {
    transform: rotate(180deg);
  }
  .catalog-filters-bar__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .catalog-filters-bar__result {
    margin-left: auto;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .catalog-filters-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 280ms ease, border-color 280ms ease, margin 280ms ease;
    border-radius: var(--radius-card);
  }
  .catalog-filters-panel[data-open="true"] {
    max-height: 1200px; /* generous upper bound for the full filterbar height */
    margin-top: 4px;
  }
</style>

<script>
  import '~/scripts/catalog-filters';
</script>
