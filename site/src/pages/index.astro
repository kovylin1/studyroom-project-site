---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import UniversityCard from '~/components/UniversityCard.astro';
import Filters from '~/components/Filters.astro';

const entries = await getCollection('universities');

const universities = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.name.localeCompare(b.name, 'ru'));

const countries = Array.from(new Set(universities.map((u) => u.country))).sort((a, b) =>
  a.localeCompare(b, 'ru'),
);

const levels = Array.from(
  new Set(universities.flatMap((u) => u.programs.map((p) => p.level))),
).sort();

const faculties = Array.from(
  new Set(
    universities
      .flatMap((u) => u.programs.map((p) => p.faculty))
      .filter((f): f is string => Boolean(f)),
  ),
).sort((a, b) => a.localeCompare(b, 'ru'));

const tuitionValues = universities.flatMap((u) => Object.values(u.tuition.byProgram)).filter((v) => v > 0);
const tuitionMax = tuitionValues.length ? Math.max(...tuitionValues) : 0;
---

<Base title="StudyRoom — каталог зарубежных университетов">
  <form id="catalog-filters" autocomplete="off" onsubmit="return false">
    <section class="catalog-hero">
      <div class="container">
        <div class="catalog-hero__inner">
          <h1>Найдите свой университет за рубежом</h1>
          <p class="catalog-hero__lead">
            Каталог партнёрских университетов StudyRoom. Программы, стоимость и дедлайны — обновляются автоматически каждый месяц.
          </p>
          <label class="catalog-hero__search" aria-label="Поиск университета">
            <span aria-hidden="true">🔎</span>
            <input
              type="search"
              name="q"
              placeholder="Например, Glasgow или Computer Science"
              autocomplete="off"
            />
            <button type="button" class="btn btn-primary">Найти</button>
          </label>
        </div>
      </div>
    </section>

    <section class="catalog">
      <div class="container">
        <Filters countries={countries} levels={levels} faculties={faculties} tuitionMax={tuitionMax} />

        <p class="catalog__count">
          Найдено: <strong id="catalog-count">{universities.length}</strong> университетов
        </p>

        <div class="catalog__grid" id="catalog-grid">
          {universities.map((data) => <UniversityCard data={data} />)}
        </div>

        <p class="catalog__empty muted" id="catalog-empty" hidden>
          По заданным фильтрам ничего не нашлось — попробуйте ослабить условия.
        </p>
      </div>
    </section>
  </form>
</Base>

<script>
  import '~/scripts/catalog-filters';
</script>
