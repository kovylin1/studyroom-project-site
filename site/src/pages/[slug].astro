      <a href={`/${u.slug}`} class="lp-nav__brand"><span class="lp-nav__mark">S</span><span>StudyRoom</span></a>
      <div class="lp-nav__links" id="lpNav">
        <a href="/" class="lp-nav__catalog">Каталог</a>
        {hasScholarships && <a href="#money" data-section="money">Стипендии</a>}
        <a href="#programs" data-section="programs">Программы</a>
        <a href="#requirements" data-section="requirements">Требования</a>
        {accom.length > 0 && <a href="#living" data-section="living">Жильё</a>}
        <a href="#dates" data-section="dates">Сроки</a>
      </div>
      <div class="lp-nav__contact">
        <a href={telLink()} class="lp-nav__phone">{CONTACTS.phoneDisplay}<small>{CONTACTS.workHours}</small></a>
        <a class="lp-nav__wa" href={waLink(`Здравствуйте, я с лендинга ${u.name}`)} aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 2.1.55 4.15 1.6 5.96L2 22l4.27-1.12a9.95 9.95 0 0 0 5.77 1.84c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01A9.83 9.83 0 0 0 12.04 2zM17.4 16.21c-.23.65-1.33 1.24-1.85 1.31-.49.07-1.11.1-1.79-.11-.41-.13-.94-.31-1.62-.6-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.26-.28.57-.35.76-.35.19 0 .38.01.54.01.17 0 .41-.07.64.49.23.56.79 1.96.86 2.1.07.14.12.31.02.49-.09.18-.14.3-.28.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.57.16.28.71 1.18 1.53 1.91 1.06.94 1.95 1.24 2.23 1.38.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.18-.28.37-.23.61-.14.24.09 1.55.73 1.81.86.27.13.44.2.51.31.06.11.06.65-.16 1.29z"/></svg>
        </a>
      </div>
      <button class="lp-burger" id="lpBurger" aria-label="Меню"><span></span></button>
    </div>
  </nav>

  <div class="drawer__overlay" id="lpDrawerOverlay"></div>
  <aside class="drawer" id="lpDrawer">
    {hasScholarships && <a href="#money">Стипендии и цена</a>}
    <a href="#programs">Программы</a>
    <a href="#requirements">Требования</a>
    {accom.length > 0 && <a href="#living">Жильё и кампусы</a>}
    <a href="#faq">Виза и документы</a>
    <a href="#dates">Сроки</a>
    <a href={telLink()}>{CONTACTS.phoneDisplay}</a>
    <div class="drawer__cta"><button class="btn btn--primary" data-modal-open="lpConsultModal">Бесплатная консультация</button></div>
  </aside>

  <section id="top" class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div>
          <div class="hero__uni-line">
            <span class="hero__logo">
              <img src={`/logos/${u.slug}.png`} alt={u.name} onerror="this.style.display='none'" />
            </span>
            <span><b>{u.name}</b> · {u.city}, {u.country}</span>
          </div>
          <h1>Поступим в {u.name} с одной подачи — или вернём оплату услуги</h1>
          <p class="hero__lead">Партнёрский договор с университетом напрямую. Без посредников, без двойных комиссий — оплачиваете только сам университет. Сопровождение от подачи до приземления.</p>
          <div class="hero__facts">
            <div class="hero__fact">
              <div class="hero__fact-num">{u.requirements?.language?.ielts ? `от ${u.requirements.language.ielts}` : '5.5+'}</div>
              <div class="hero__fact-label">IELTS — Foundation / Pre-Master's</div>
            </div>
            <div class="hero__fact">
              <div class="hero__fact-num">{u.programs.length}</div>
              <div class="hero__fact-label">программ доступно</div>
            </div>
            {hasScholarships ? (
              <div class="hero__fact">
                <div class="hero__fact-num">до {sym}{maxScholarshipApprox.toLocaleString('en')}</div>
                <div class="hero__fact-label">стипендий для иностранцев</div>
              </div>
            ) : (
              <div class="hero__fact">
                <div class="hero__fact-num">{tuitionMin > 0 ? `от ${sym}${tuitionMin.toLocaleString('en')}` : '—'}</div>
                <div class="hero__fact-label">стоимость / год</div>
              </div>
            )}
          </div>
          <div class="hero__ctas">
            <button class="btn btn--primary btn--lg" data-modal-open="lpConsultModal">Узнать свой шанс на поступление →</button>
            <a href="#programs" class="btn btn--ghost btn--lg">Смотреть программы</a>
          </div>
          <div class="hero__trust">
            <span class="dot"></span>
            <span><b>Айгерим</b>, куратор StudyRoom, онлайн — ответит в течение 5 минут</span>
          </div>
        </div>
        {heroPhoto ? (
          <div class="hero__media" role="img" aria-label={`Кампус ${u.name}`} data-lightbox={heroPhoto} style={`background-image: url('${heroPhoto}')`}>
            <div class="hero__media-cap">{u.name} — клик чтобы увеличить</div>
          </div>
        ) : (
          <div class="hero__media hero__media--placeholder"><span>{u.name}</span></div>
        )}
      </div>
      {galleryItems.length >= 4 && (
        <div class="hero__strip">
          {galleryItems.slice(1, 5).map((p: any) => (
            <div class="hero__strip-tile" data-lightbox={p.img} style={`background-image: url('${p.img}')`}></div>
          ))}
        </div>
      )}
    </div>
  </section>

  {hasScholarships && (
    <section
      class:list={["section section--alt reveal", moneyBackdrop && "section--photo-bg"]}
      id="money"
      style={moneyBackdrop ? `--photo-bg: url('${moneyBackdrop}')` : undefined}
    >
      <div class="wrap">
        <span class="eyebrow">Деньги — честно</span>
        <div class="money">
          <div class="money__head">
            <h2 class="money__title">Стипендии для казахстанцев — <span>до {sym}{maxScholarshipApprox.toLocaleString('en')}</span></h2>
            <p style="max-width: 60ch; color: var(--ink-2); margin: 0;">Услуга StudyRoom — <b>бесплатно</b>: комиссию платит сам университет. Кликните по стипендии — увидите условия.</p>
          </div>
          <ul class="scholar-list">
            {scholarshipsClean.map((s, i) => (
              <li class="scholar" data-scholarship-idx={String(i)}>
                <span class="scholar__amount">{s.amount ?? '—'}</span>
                <div>
                  <div class="scholar__name">{s.nameRu ?? s.name}</div>
                  <p class="scholar__desc">{((s.descriptionRu ?? s.description ?? '')).slice(0, 140)}{((s.descriptionRu ?? s.description ?? '')).length > 140 ? '…' : ''}</p>
                  <div class="scholar__more">Подробнее →</div>
                </div>
              </li>
            ))}
          </ul>

          {tuitionMin > 0 && (
            <>
              <div class="rate-slider">
                <label for="lpRate">Курс ₸ за 1 {u.tuition.currency}:</label>
                <input type="range" id="lpRate" min={String(Math.round(baseRate * 0.9))} max={String(Math.round(baseRate * 1.15))} step="5" value={String(baseRate)} />
                <output id="lpRateOut">{baseRate} ₸</output>
                <span style="font-size: 12px; color: var(--ink-3);">Подвиньте — пересчитает в тенге</span>
              </div>

              <div class="calc">
                <div class="calc__card">
                  <span class="calc__scenario calc__scenario--base">Базовый сценарий</span>
                  <h4>Программа от {sym}{tuitionMin.toLocaleString('en')} + жильё</h4>
                  <div class="calc__row"><span>Обучение, 1 год</span><strong>{sym}{tuitionMin.toLocaleString('en')} · <span data-kzt={String(tuitionMin)}>—</span></strong></div>
                  <div class="calc__row"><span>Жильё (≈30 нед)</span><strong>{sym}7,000 · <span data-kzt="7000">—</span></strong></div>
                  <div class="calc__row"><span>Виза + страховка</span><strong>{sym}1,200 · <span data-kzt="1200">—</span></strong></div>
                  <div class="calc__row"><span>Услуги StudyRoom</span><strong class="calc__highlight">0 ₸</strong></div>
                  <div class="calc__row calc__row--total"><span>Итого за год</span><strong>≈ <span data-kzt={String(tuitionMin + 7000 + 1200)}>—</span></strong></div>
                </div>
                {maxScholarshipApprox > 0 && (
                  <div class="calc__card">
                    <span class="calc__scenario calc__scenario--best">Со стипендией</span>
                    <h4>Тот же сценарий, с применением стипендии</h4>
                    <div class="calc__row"><span>Обучение + жильё + виза</span><strong>{sym}{(tuitionMin + 7000 + 1200).toLocaleString('en')} · <span data-kzt={String(tuitionMin + 7000 + 1200)}>—</span></strong></div>
                    <div class="calc__row"><span>− Типовая стипендия</span><strong class="calc__highlight">−{sym}{Math.min(maxScholarshipApprox, 4000).toLocaleString('en')} · <span data-kzt={String(-Math.min(maxScholarshipApprox, 4000))}>—</span></strong></div>
                    <div class="calc__row calc__row--total"><span>Итого за год</span><strong>≈ <span data-kzt={String(tuitionMin + 7000 + 1200 - Math.min(maxScholarshipApprox, 4000))}>—</span></strong></div>
                    <p style="font-size: 12px; color: var(--ink-3); margin-top: 8px;">Стипендии могут суммироваться — точный расчёт у куратора.</p>
                  </div>
                )}
              </div>
            </>
          )}

          <div style="margin-top: 22px; text-align: center;">
            <button class="btn btn--primary btn--lg" data-modal-open="lpConsultModal">Проверить, на какие стипендии я прохожу →</button>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section reveal" id="programs">
    <div class="wrap">
      <span class="eyebrow">Программы</span>
      <h2>{u.programs.length} программ по {faculties.length} факультетам</h2>
      <p style="max-width: 60ch; color: var(--ink-2);">Бакалавриат, магистратура и подготовительные программы для тех, у кого IELTS ниже {(u.requirements?.language?.ielts ?? 5.5) + 0.5} или нужен переходный год.</p>

      {faculties.length > 1 && (
        <div class="tabs" role="tablist">
          {faculties.map((f, i) => (
            <button class={`tab ${i === 0 ? 'is-active' : ''}`} data-faculty={f[0]}>{f[0]}</button>
          ))}
        </div>
      )}

      <div class="level-filter" role="tablist" id="lpLevelFilter">
        <button class="lvl is-active" type="button" data-level="all">Все</button>
        <button class="lvl" type="button" data-level="high-school">Школа</button>
        <button class="lvl" type="button" data-level="sixth-form">Sixth Form</button>
        <button class="lvl" type="button" data-level="foundation">Foundation</button>
        <button class="lvl" type="button" data-level="bachelor">Бакалавриат</button>
        <button class="lvl" type="button" data-level="pathway">Pre-Master's</button>
        <button class="lvl" type="button" data-level="master">Магистратура</button>
        <button class="lvl" type="button" data-level="english-language">Английский</button>
        <button class="lvl" type="button" data-level="short-course">Короткие</button>
      </div>

      <div class="programs-grid" id="lpProgramsGrid"></div>

      <div style="text-align: center; margin-top: 18px;">
        <button class="btn btn--ghost" id="lpShowAllPrograms" type="button">Показать все программы факультета →</button>
      </div>
    </div>
  </section>

  <section class="section section--alt reveal" id="requirements">
    <div class="wrap">
      <span class="eyebrow">Прохожу ли я?</span>
      <h2>Требования к поступлению</h2>
      <div class="req-grid">
        <div class="req-card">
          <h3 style="margin-top: 0;">Документы и баллы</h3>
          <ul class="req-list">
            <li><dt>Аттестат / диплом</dt><b>4.0+ GPA (≈70%)</b></li>
            <li><dt>IELTS</dt><b>{u.requirements?.language?.ielts ?? '5.5'} (Foundation) · 6.0 (Pre-Master's) · 6.5 (магистратура)</b></li>
            {u.requirements?.language?.toefl && <li><dt>TOEFL iBT</dt><b>от {u.requirements.language.toefl}</b></li>}
            <li><dt>Мотивационное письмо</dt><b>1 страница</b></li>
            <li><dt>Рекомендации</dt><b>1–2 от учителей / работодателя</b></li>
            <li><dt>Финансовое подтверждение</dt><b>~{sym}{Math.max(15000, tuitionMin).toLocaleString('en')} на счёте 28+ дней</b></li>
          </ul>
        </div>
        <div class="ielts-help">
          <h4>IELTS ниже 6.0? Это не блокер.</h4>
          <p style="font-size: 14px; color: var(--ink-2);">Через Foundation (1 год) можно поступать с IELTS от <b>{u.requirements?.language?.ielts ?? 5.5}</b>, через Pre-Master's — с <b>5.5–6.0</b>. После пути — гарантированный переход на бакалавриат или магистратуру.</p>
          <button class="btn btn--ghost" style="margin-top: 8px;" data-modal-open="lpConsultModal">Подобрать путь под мой IELTS →</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="reviews">
    <div class="wrap">
      <span class="eyebrow">Студенты StudyRoom</span>
      <h2>Кто уже поступил через нас</h2>
      <div class="reviews-stub">
        <strong>Раздел появится после съёмки настоящих видео-отзывов.</strong>
        На реальном сайте — три видео по 30 сек: два студента и один родитель.
      </div>
    </div>
  </section>

  <section class="section section--alt reveal" id="about">
    <div class="wrap">
      <span class="eyebrow">О StudyRoom</span>
      <div class="about-grid">
        <div>
          <h2>Образовательное агентство в Алматы. С прямым партнёрством университетов.</h2>
          <p>Помогаем казахстанским школьникам и выпускникам поступать в зарубежные университеты с {AGENCY.sinceYear} года. Работаем напрямую — без перепродажи услуг.</p>
          <p>Офис в Алматы, выезды на встречи в Астану и Шымкент. С 2024 года — официальный канал в Telegram «Поступление за рубеж».</p>
          <p><b>{CONTACTS.legalName}</b>{CONTACTS.bin ? ` · БИН ${CONTACTS.bin}` : ''} · {CONTACTS.address} · {CONTACTS.phoneDisplay}</p>
        </div>
        <div class="about-stats">
          <div class="about-stat"><b>{AGENCY.studentsPlaced}</b><span>казахстанцев поступили через нас</span></div>
          <div class="about-stat"><b>{AGENCY.visaApprovalRate}</b><span>одобрений студ. виз</span></div>
          <div class="about-stat"><b>{yearsOnMarket()}</b><span>лет на рынке EdTech</span></div>
          <div class="about-stat"><b>{uniCount}</b><span>университетов в портфеле</span></div>
        </div>
      </div>
    </div>
  </section>

  {(accom.length > 0 || campuses.length > 0) && (
    <section class="section reveal" id="living">
      <div class="wrap">
        <span class="eyebrow">Где жить и учиться</span>
        <h2>Жильё и кампусы <small style="font-weight: 400; font-size: 14px; color: var(--ink-3);">(кликните для деталей)</small></h2>

        {accom.length > 0 && (
          <>
            <h3 style="margin: 24px 0 14px; font-size: 18px;">Где жить — реальные цены</h3>
            <div class="accom-grid">
              {accom.map((a, i) => (
                <div class="accom" data-accom-idx={String(i)}>
                  {a.img ? (
                    <div class="accom__img" style={`background-image: url('${a.img}')`}></div>
                  ) : (
                    <div class="accom__placeholder">{(a.name ?? 'Жильё').slice(0, 24)}</div>
                  )}
                  <div class="accom__body">
                    {a.price && <span class="accom__price">{a.price}</span>}
                    <div class="accom__name">{a.name}</div>
                    {a.text && <p class="accom__text">{a.text.slice(0, 160)}{a.text.length > 160 ? '…' : ''}</p>}
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        {campuses.length > 0 && (
          <>
            <h3 style="margin: 36px 0 14px; font-size: 18px;">Кампусы — где будут лекции</h3>
            <div class="camp-grid">
              {campuses.map((c, i) => (
                <div class="camp" data-camp-idx={String(i)}>
                  {c.img ? (
                    <div class="camp__img" style={`background-image: url('${c.img}')`}></div>
                  ) : (
                    <div class="camp__placeholder">{c.title}</div>
                  )}
                  <div class="camp__body">
                    {c.sub && <div class="camp__sub">{c.sub}</div>}
                    <div class="camp__title">{c.title}</div>
                    {c.text && <p class="camp__text">{c.text.slice(0, 160)}{c.text.length > 160 ? '…' : ''}</p>}
                  </div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )}

  {accom.length === 0 && campuses.length === 0 && (photoSets?.general?.length ?? 0) > 0 && (
    <section class="section reveal" id="uni-gallery">
      <div class="wrap">
        <span class="eyebrow">Фото университета</span>
        <h2>{u.name} — фотогалерея</h2>
        <div class="photo-grid">
          {photoSets.general.map((p: any) => (
            <div class="photo-tile" data-lightbox={p.img} style={`background-image: url('${p.img}')`}></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {(descParagraphs.length > 0 || keyFacts.length > 0) && (
    <section class="section reveal" id="about-uni">
      <div class="wrap">
        <span class="eyebrow">О университете</span>
        {aboutPhoto && (
          <div class="about-photo" data-lightbox={aboutPhoto} style={`background-image: url('${aboutPhoto}')`}></div>
        )}
        <div class="desc-grid">
          <div class="desc-text">
            <h2>{u.name}</h2>
            {descParagraphs.slice(0, 3).map((p) => <p>{p}</p>)}
          </div>
          {keyFacts.length > 0 && (
            <div class="ranks-card">
              <h4>Рейтинги и факты</h4>
              <ul class="ranks-list">
                {keyFacts.slice(0, 8).map((f) => <li>{f}</li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt reveal" id="faq">
    <div class="wrap">
      <span class="eyebrow">Важно знать</span>
      <h2>Виза, страховка, документы</h2>
      <div class="faq-grid">
        {STUDYROOM_FAQ.map((item) => (
          <div class="faq-item">
            <div class="faq-item__head"><h4>{item.title}</h4><span class="faq-item__icon">+</span></div>
            <div class="faq-item__body"><p>{item.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal" id="dates">
    <div class="wrap">
      <span class="eyebrow">Сроки</span>
      <h2>Когда подавать в {u.name}</h2>
      <div class="deadline-strip">
        ⏱ До дедлайна ранней подачи (скидка) осталось
        <span class="deadline-strip__count" id="lpDeadline">— дн.</span>.
        Подача занимает 3–5 недель — начните сегодня.
      </div>
      <div class="timeline">
        {TIMELINE.map((s) => (
          <div class="tl-step"><h4>{s.title}</h4><p>{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal" id="map">
    <div class="wrap">
      <span class="eyebrow">Расположение</span>
      <h2>{u.name} на карте</h2>
      <p style="color: var(--ink-2); margin: 8px 0 20px;">{[u.city, u.country].filter(Boolean).join(', ')}</p>
      <div class="map-embed" style="overflow:hidden; border-radius:14px; box-shadow: var(--shadow-md);">
        <iframe
          src={`https://maps.google.com/maps?q=${encodeURIComponent(u.name + (u.city ? ', ' + u.city : '') + (u.country ? ', ' + u.country : ''))}&output=embed&z=14`}
          width="100%"
          height="450"
          style="border:0; display:block;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Карта: ${u.name}`}
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="wrap">
      <div class="cta" id="cta">
        <div>
          <span class="eyebrow" style="background: rgba(255,255,255,.15); color: #fff;">15 минут с куратором</span>
          <h2>Узнайте, проходите ли вы в {u.name} — за один звонок</h2>
          <p>Айгерим (куратор StudyRoom) посмотрит ваш аттестат, IELTS и скажет честно: есть ли шанс, какая программа подойдёт, сколько будет стоить со стипендией.</p>
          <div class="cta__trust">
            <div class="cta__trust-item"><svg viewBox="0 0 24 24" fill="#fff"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg><p><b>Без обязательств</b>Один звонок, один PDF с расчётом.</p></div>
            <div class="cta__trust-item"><svg viewBox="0 0 24 24" fill="#fff"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg><p><b>Ответим за 15 минут</b>В рабочие часы.</p></div>
            <div class="cta__trust-item"><svg viewBox="0 0 24 24" fill="#fff"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19l12-12-1.4-1.4z"/></svg><p><b>Без спам-рассылок</b>Только один звонок и PDF.</p></div>
          </div>
        </div>
        <form class="cta__form" id="lpCtaForm">
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
          <div class="field"><label>Кто оставляет заявку?</label><div class="pill-choices"><label><input type="radio" name="lprole" checked /><span>Студент</span></label><label><input type="radio" name="lprole" /><span>Родитель</span></label></div></div>
          <div class="field"><label for="lpname">Имя</label><input id="lpname" type="text" placeholder="Ваше имя" required /></div>
          <div class="field"><label for="lpphone">WhatsApp / телефон</label><input id="lpphone" type="tel" placeholder="+7 (___) ___-__-__" required /></div>
          <div class="field"><label for="lpemail">Email <span style="color:var(--ink-2);font-weight:400;">(необязательно)</span></label><input id="lpemail" type="email" placeholder="email@example.com" /></div>
          <div class="field"><label>Удобное время</label><div class="pill-choices"><label><input type="radio" name="lptime" checked /><span>Сейчас</span></label><label><input type="radio" name="lptime" /><span>Вечером</span></label><label><input type="radio" name="lptime" /><span>Завтра</span></label></div></div>
          <button class="btn btn--primary btn--lg" type="submit" style="width: 100%;">Записаться на разбор профиля →</button>
          <p class="form-fineprint">Нажимая «Записаться», вы соглашаетесь с обработкой данных.</p>
        </form>
      </div>
    </div>
  </section>

  <div class="chat-panel" id="lpChatPanel" role="dialog" aria-label="Чат">
    <div class="chat-panel__head">
      <div class="chat-avatar">А</div>
      <div><div class="chat-panel__name">Айгерим</div><div class="chat-panel__role">Куратор · онлайн</div></div>
      <button class="chat-panel__close" id="lpChatClose" aria-label="Закрыть">×</button>
    </div>
    <div class="chat-panel__body" id="lpChatBody">
      <div class="chat-msg chat-msg--bot"><div class="chat-msg__bubble">Привет 👋 Я Айгерим, куратор StudyRoom. Что вас интересует в {u.name}?</div></div>
    </div>
    <div class="chat-quick">
      <button data-lpq="scholarships">Какие стипендии?</button>
      <button data-lpq="grades">Хватит ли оценок?</button>
      <button data-lpq="cost">Сколько стоит?</button>
      <button data-lpq="visa">Сколько идёт виза?</button>
    </div>
    <form class="chat-input" id="lpChatInput">
      <input type="text" placeholder="Напишите вопрос…" />
      <button type="submit" aria-label="Отправить"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg></button>
    </form>
  </div>

  <button class="lp-chat-fab" id="lpStickyChatBtn" type="button" aria-label="Открыть чат с куратором" aria-controls="lpChatPanel" aria-expanded="false">
    <svg class="lp-chat-fab__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 4V6a2 2 0 0 1 2-2z" fill="currentColor"/>
    </svg>
    <span class="lp-chat-fab__badge" aria-hidden="true">1</span>
  </button>

  <dialog id="lpConsultModal" aria-label="Консультация">
    <div class="modal-head"><h3>Записаться на бесплатную консультацию</h3><button class="modal-close" data-modal-close>×</button></div>
    <div class="modal-body">
      <p style="color: var(--ink-2); margin-top: 0;">Айгерим перезвонит в течение <b>15 минут</b>. Скажет честно: проходите ли в {u.name}.</p>
      <form id="lpModalConsultForm">
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
        <div class="field"><label>Кто оставляет заявку?</label><div class="pill-choices"><label><input type="radio" name="lpmrole" checked /><span>Студент</span></label><label><input type="radio" name="lpmrole" /><span>Родитель</span></label></div></div>
        <div class="field"><label for="lpmname">Имя</label><input id="lpmname" type="text" placeholder="Ваше имя" required /></div>
        <div class="field"><label for="lpmphone">WhatsApp / телефон</label><input id="lpmphone" type="tel" placeholder="+7 (___) ___-__-__" required /></div>
        <div class="field"><label for="lpmemail">Email <span style="color:var(--ink-2);font-weight:400;">(необязательно)</span></label><input id="lpmemail" type="email" placeholder="email@example.com" /></div>
        <div class="field"><label>Канал связи</label><div class="pill-choices"><label><input type="radio" name="lpmch" checked /><span>WhatsApp</span></label><label><input type="radio" name="lpmch" /><span>Telegram</span></label><label><input type="radio" name="lpmch" /><span>Звонок</span></label></div></div>
        <div class="field"><label>Когда?</label><div class="pill-choices"><label><input type="radio" name="lpmt" checked /><span>Сейчас</span></label><label><input type="radio" name="lpmt" /><span>Вечером</span></label><label><input type="radio" name="lpmt" /><span>Завтра</span></label></div></div>
        <button class="btn btn--primary btn--lg" type="submit" style="width: 100%;">Записаться →</button>
        <p class="form-fineprint">Без спам-рассылок. Один звонок и PDF.</p>
      </form>
    </div>
  </dialog>

  <dialog id="lpProgramsModal" aria-label="Программы">
    <div class="modal-head"><h3>Программы — <span id="lpProgramsModalFaculty"></span></h3><button class="modal-close" data-modal-close>×</button></div>
    <div class="modal-body">
      <div class="level-filter" role="tablist" id="lpModalLevelFilter">
        <button class="lvl is-active" type="button" data-level="all">Все</button>
        <button class="lvl" type="button" data-level="high-school">Школа</button>
        <button class="lvl" type="button" data-level="sixth-form">Sixth Form</button>
        <button class="lvl" type="button" data-level="foundation">Foundation</button>
        <button class="lvl" type="button" data-level="bachelor">Бакалавриат</button>
        <button class="lvl" type="button" data-level="pathway">Pre-Master's</button>
        <button class="lvl" type="button" data-level="master">Магистратура</button>
        <button class="lvl" type="button" data-level="english-language">Английский</button>
        <button class="lvl" type="button" data-level="short-course">Короткие</button>
      </div>
      <input type="text" class="program-search" id="lpProgramSearch" placeholder="Поиск по названию программы…" />
      <ul class="program-list" id="lpProgramList"></ul>
    </div>
    <div class="modal-foot">
      <button class="btn btn--ghost" data-modal-close>Закрыть</button>
      <button class="btn btn--primary" data-modal-open="lpConsultModal">Получить консультацию</button>
    </div>
  </dialog>

  <dialog id="lpScholarshipModal" aria-label="Стипендия">
    <div class="modal-head"><h3 id="lpSchTitle">Стипендия</h3><button class="modal-close" data-modal-close>×</button></div>
    <div class="modal-body" id="lpSchBody"></div>
    <div class="modal-foot">
      <button class="btn btn--ghost" data-modal-close>Закрыть</button>
      <button class="btn btn--primary" data-modal-open="lpConsultModal">Подать заявку →</button>
    </div>
  </dialog>

  <dialog id="lpDetailModal" aria-label="Детали">
    <div class="modal-head"><h3 id="lpDetailTitle">Подробнее</h3><button class="modal-close" data-modal-close>×</button></div>
    <div class="modal-body" id="lpDetailBody"></div>
  </dialog>

  <dialog id="lpExitModal" aria-label="Подождите">
    <div class="modal-head"><h3>Подождите — получите PDF</h3><button class="modal-close" data-modal-close>×</button></div>
    <div class="modal-body">
      <p style="color: var(--ink-2); margin-top: 0;"><b>«Гид по поступлению в {u.name} для казахстанцев»</b> — документы, дедлайны, расчёт стипендий, чек-лист подачи на визу.</p>
      <form id="lpExitForm">
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
        <div class="field"><label for="lpexname">Имя</label><input id="lpexname" type="text" placeholder="Ваше имя" required /></div>
        <div class="field"><label for="lpexc">Email или WhatsApp</label><input id="lpexc" type="text" placeholder="email@example.com или +7 (___) ___-__-__" required /></div>
        <button class="btn btn--primary btn--lg" type="submit" style="width: 100%;">Скачать PDF →</button>
        <p class="form-fineprint">Только PDF. Без звонков.</p>
      </form>
    </div>
  </dialog>

  <dialog id="lpLightbox" class="lightbox">
    <button class="modal-close" data-modal-close>×</button>
    <img id="lpLightboxImg" src="" alt="" />
  </dialog>

  <div class="toast-tray" id="lpToast" aria-live="polite"></div>
</div>

<script is:inline define:vars={{
  PROGRAMS_DATA: programsByFaculty,
  SCHOLARSHIPS_DATA: scholarshipsClean,
  ACCOM_DATA: accom,
  CAMP_DATA: campuses,
  CURRENCY_SYM: sym,
  UNI_NAME: u.name,
  UNI_SLUG: u.slug,
}}>
(() => {
  const $ = (s, root) => (root || document).querySelector(s);
  const $$ = (s, root) => Array.from((root || document).querySelectorAll(s));
  document.body.classList.add('lp-mobile');

  const LEVEL_LABELS = { 'high-school': 'Школа', 'sixth-form': 'Sixth Form', foundation: 'Foundation', pathway: "Pre-Master's", master: 'Магистратура', bachelor: 'Бакалавриат', phd: 'PhD', 'english-language': 'Английский', 'short-course': 'Короткие' };
  function levelLabel(level, programType) {
    if (level === 'master' && programType === 'pathway') return "Pre-Master's";
    return LEVEL_LABELS[level] || level;
  }
  function levelClass(level, programType) {
    if (level === 'master' && programType === 'pathway') return 'pathway';
    return level;
  }

  function toast(msg, type) {
    const tray = $('#lpToast');
    if (!tray) return;
    const el = document.createElement('div');
    el.className = 'toast toast--' + (type || 'info');
    el.textContent = msg;
    tray.appendChild(el);
    setTimeout(() => { el.classList.add('is-out'); setTimeout(() => el.remove(), 250); }, 3000);
  }

  function fmtKzt(n) {
    if (Math.abs(n) >= 1000000) return (n/1000000).toFixed(2).replace('.',',') + ' млн ₸';
    if (Math.abs(n) >= 1000) return Math.round(n/1000) + ' тыс. ₸';
    return Math.round(n) + ' ₸';
  }

  const pb = $('#lpProgress');
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (pb) pb.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  }, { passive: true });

  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
  }, { threshold: .15 });
  $$('.reveal').forEach(el => io.observe(el));

  const navIo = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        $$('#lpNav a').forEach(a => a.classList.toggle('is-active', a.dataset.section === id));
      }
    });
  }, { threshold: .3, rootMargin: '-100px 0px -50% 0px' });
  ['money','programs','requirements','living','dates'].forEach(id => {
    const el = document.getElementById(id);
    if (el) navIo.observe(el);
  });

  const burger = $('#lpBurger');
  const drawer = $('#lpDrawer');
  const overlay = $('#lpDrawerOverlay');
  function toggleDrawer(open) {
    if (!drawer) return;
    drawer.classList.toggle('is-open', open);
    overlay.classList.toggle('is-open', open);
    burger.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  }
  if (burger) burger.addEventListener('click', () => toggleDrawer(!drawer.classList.contains('is-open')));
  if (overlay) overlay.addEventListener('click', () => toggleDrawer(false));
  $$('#lpDrawer a').forEach(a => a.addEventListener('click', () => toggleDrawer(false)));

  const facultyNames = Object.keys(PROGRAMS_DATA);
  let currentFaculty = facultyNames[0];
  let currentLevel = 'all';
  let modalLevel = 'all';

  function matchesLevel(p, lvl) {
    if (lvl === 'all') return true;
    if (lvl === 'pathway') return p.level === 'master' && p.programType === 'pathway';
    if (lvl === 'master') return p.level === 'master' && p.programType !== 'pathway';
    return p.level === lvl;
  }

  function filterByLevel(list, lvl) { return list.filter(p => matchesLevel(p, lvl)); }

  function renderProgramsCards(facultyKey, lvl) {
    const grid = $('#lpProgramsGrid');
    if (!grid) return;
    const all = PROGRAMS_DATA[facultyKey] || [];
    const filtered = filterByLevel(all, lvl).slice(0, 6);
    if (!filtered.length) {
      grid.innerHTML = '<div class="programs-empty">Программ этого уровня на факультете нет.</div>';
      return;
    }
    grid.innerHTML = filtered.map(p => `
      <div class="program-row" data-prog-level="${p.level}" data-prog-type="${p.programType || ''}">
        <div>
          <span class="program-row__level program-row__level--${levelClass(p.level, p.programType)}">${levelLabel(p.level, p.programType)}</span>
          <div class="program-row__title">${p.title}</div>
        </div>
        <div class="program-row__price">${p.tuition ? CURRENCY_SYM + p.tuition.toLocaleString('en') + '/год' : '—'}</div>
      </div>
    `).join('');
  }

  function renderProgramsModal(facultyKey, lvl, q) {
    q = q || '';
    const list = filterByLevel(PROGRAMS_DATA[facultyKey] || [], lvl);
    const filtered = q ? list.filter(p => p.title.toLowerCase().includes(q.toLowerCase())) : list;
    const facHead = $('#lpProgramsModalFaculty');
    if (facHead) {
      const lvlLabels = { all: '', foundation: 'Foundation', bachelor: 'Бакалавриат', pathway: "Pre-Master's", master: 'Магистратура' };
      facHead.textContent = facultyKey + (lvl !== 'all' ? ' · ' + lvlLabels[lvl] : '');
    }
    $$('#lpModalLevelFilter .lvl').forEach(b => b.classList.toggle('is-active', b.dataset.level === lvl));
    const ul = $('#lpProgramList');
    if (!ul) return;
    ul.innerHTML = filtered.length ? filtered.map(p => `
      <li>
        <span class="program-row__level program-row__level--${levelClass(p.level, p.programType)}">${levelLabel(p.level, p.programType)}</span>
        <span>${p.title}</span>
        <strong style="color: var(--green); white-space: nowrap;">${p.tuition ? CURRENCY_SYM + p.tuition.toLocaleString('en') + '/год' : '—'}</strong>
      </li>
    `).join('') : '<li style="grid-template-columns: 1fr; color: var(--ink-3);">Ничего не нашли. Попробуйте другое слово или другой уровень.</li>';
  }

  function openProgramsModalFor(facultyKey, lvl) {
    currentFaculty = facultyKey;
    modalLevel = lvl;
    const search = $('#lpProgramSearch');
    if (search) search.value = '';
    renderProgramsModal(currentFaculty, modalLevel, '');
    openModal('lpProgramsModal');
  }

  if (currentFaculty) renderProgramsCards(currentFaculty, currentLevel);

  $$('.tab').forEach(t => {
    t.addEventListener('click', () => {
      $$('.tab').forEach(x => x.classList.remove('is-active'));
      t.classList.add('is-active');
      currentFaculty = t.dataset.faculty;
      renderProgramsCards(currentFaculty, currentLevel);
    });
  });

  $$('#lpLevelFilter .lvl').forEach(b => {
    b.addEventListener('click', () => {
      $$('#lpLevelFilter .lvl').forEach(x => x.classList.remove('is-active'));
      b.classList.add('is-active');
      currentLevel = b.dataset.level;
      renderProgramsCards(currentFaculty, currentLevel);
    });
  });

  $$('#lpModalLevelFilter .lvl').forEach(b => {
    b.addEventListener('click', () => {
      modalLevel = b.dataset.level;
      const search = $('#lpProgramSearch');
      renderProgramsModal(currentFaculty, modalLevel, search ? search.value : '');
    });
  });

  document.addEventListener('click', (e) => {
    const card = e.target.closest('.program-row');
    if (!card) return;
    openProgramsModalFor(currentFaculty, currentLevel);
  });

  const showAllBtn = $('#lpShowAllPrograms');
  if (showAllBtn) showAllBtn.addEventListener('click', () => openProgramsModalFor(currentFaculty, currentLevel));

  const rate = $('#lpRate');
  const rateOut = $('#lpRateOut');
  function applyRate() {
    if (!rate) return;
    const r = +rate.value;
    if (rateOut) rateOut.textContent = r + ' ₸';
    $$('[data-kzt]').forEach(el => {
      const gbp = +el.dataset.kzt;
      el.textContent = fmtKzt(gbp * r);
    });
  }
  if (rate) rate.addEventListener('input', applyRate);
  applyRate();

  const dl = new Date();
  dl.setDate(dl.getDate() + 47);
  function tickDeadline() {
    const diff = dl - new Date();
    const el = $('#lpDeadline');
    if (!el) return;
    if (diff <= 0) { el.textContent = 'дедлайн прошёл'; return; }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    el.textContent = d + ' дн. ' + h + ' ч.';
  }
  tickDeadline();
  setInterval(tickDeadline, 60000);

  function openModal(id) {
    const dlg = document.getElementById(id);
    if (!dlg) return;
    if (dlg.showModal) dlg.showModal();
    document.body.classList.add('no-scroll');
  }
  function closeModal(dlg) {
    if (!dlg || !dlg.open) return;
    dlg.close();
    document.body.classList.remove('no-scroll');
  }

  document.addEventListener('click', (e) => {
    const opener = e.target.closest('[data-modal-open]');
    if (opener) {
      e.preventDefault();
      const id = opener.dataset.modalOpen;
      $$('dialog[open]').forEach(d => closeModal(d));
      if (id === 'lpProgramsModal' && currentFaculty) renderProgramsModal(currentFaculty, modalLevel, '');
      openModal(id);
      return;
    }
    const closer = e.target.closest('[data-modal-close]');
    if (closer) closeModal(closer.closest('dialog'));
  });

  $$('dialog').forEach(dlg => {
    dlg.addEventListener('click', (e) => { if (e.target === dlg) closeModal(dlg); });
    dlg.addEventListener('close', () => document.body.classList.remove('no-scroll'));
  });

  const ps = $('#lpProgramSearch');
  if (ps) ps.addEventListener('input', (e) => renderProgramsModal(currentFaculty, modalLevel, e.target.value));

  $$('.scholar').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.scholarshipIdx;
      const s = SCHOLARSHIPS_DATA[i];
      if (!s) return;
      $('#lpSchTitle').textContent = (s.nameRu || s.name) + ' · ' + (s.amount || '');
      $('#lpSchBody').innerHTML = (s.descriptionRu || s.description || '<p>Подробности у куратора.</p>')
        + (s.url ? '<p style="margin-top:14px;"><b>Источник:</b> <a href="' + s.url + '" target="_blank" rel="noopener">' + s.url.replace(/^https?:\/\//, '').replace(/\/$/, '') + '</a></p>' : '');
      openModal('lpScholarshipModal');
    });
  });

  $$('[data-accom-idx]').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.accomIdx;
      const a = ACCOM_DATA[i];
      if (!a) return;
      $('#lpDetailTitle').textContent = a.name || 'Жильё';
      $('#lpDetailBody').innerHTML = (a.price ? '<p><b>Цена:</b> ' + a.price + '</p>' : '') + (a.text ? '<p>' + a.text + '</p>' : '');
      openModal('lpDetailModal');
    });
  });

  $$('[data-camp-idx]').forEach(card => {
    card.addEventListener('click', () => {
      const i = +card.dataset.campIdx;
      const c = CAMP_DATA[i];
      if (!c) return;
      $('#lpDetailTitle').textContent = c.title || 'Кампус';
      $('#lpDetailBody').innerHTML = (c.sub ? '<p style="color:var(--green);font-weight:700;text-transform:uppercase;font-size:12px;letter-spacing:.05em;">' + c.sub + '</p>' : '') + (c.text ? '<p>' + c.text + '</p>' : '');
      openModal('lpDetailModal');
    });
  });

  $$('[data-lightbox]').forEach(el => {
    el.addEventListener('click', () => {
      $('#lpLightboxImg').src = el.dataset.lightbox;
      openModal('lpLightbox');
    });
  });

  $$('.faq-item').forEach(item => {
    const head = item.querySelector('.faq-item__head');
    if (!head) return;
    head.addEventListener('click', () => {
      const wasOpen = item.classList.contains('is-open');
      $$('.faq-item').forEach(x => x.classList.remove('is-open'));
      if (!wasOpen) item.classList.add('is-open');
    });
  });

  const chatPanel = $('#lpChatPanel');
  const chatBody = $('#lpChatBody');
  const stickyChatBtn = $('#lpStickyChatBtn');

  function chatOpen() {
    if (chatPanel) chatPanel.classList.add('is-open');
    if (stickyChatBtn) { stickyChatBtn.classList.add('is-hidden'); stickyChatBtn.setAttribute('aria-expanded', 'true'); }
  }
  function chatClose() {
    if (chatPanel) chatPanel.classList.remove('is-open');
    if (stickyChatBtn) { stickyChatBtn.classList.remove('is-hidden'); stickyChatBtn.setAttribute('aria-expanded', 'false'); }
  }
  function chatAddMsg(text, who) {
    if (!chatBody) return;
    const m = document.createElement('div');
    m.className = 'chat-msg chat-msg--' + (who || 'bot');
    m.innerHTML = '<div class="chat-msg__bubble">' + text + '</div>';
    chatBody.appendChild(m);
    chatBody.scrollTop = chatBody.scrollHeight;
  }
  if (stickyChatBtn) stickyChatBtn.addEventListener('click', () => {
    if (chatPanel && chatPanel.classList.contains('is-open')) chatClose(); else chatOpen();
  });
  const chatCloseBtn = $('#lpChatClose');
  if (chatCloseBtn) chatCloseBtn.addEventListener('click', chatClose);

  const QR = {
    scholarships: { user: 'Какие стипендии?', bot: SCHOLARSHIPS_DATA.length ? 'Для ' + UNI_NAME + ' доступны: ' + SCHOLARSHIPS_DATA.map(s => '<b>' + (s.nameRu || s.name) + '</b> (' + (s.amount || '—') + ')').join(', ') + '. Хотите подробности?' : 'Для этого универа специальных стипендий пока нет — но мы поможем найти внешние (Chevening и др.). Оставьте номер.' },
    grades: { user: 'Хватит ли оценок?', bot: 'Зависит от программы. Для Foundation — аттестат от 4.0 (≈70%), для магистратуры — диплом 3.5 GPA. Скиньте оценки в WhatsApp.' },
    cost: { user: 'Сколько стоит?', bot: 'Стоимость зависит от программы. Точный расчёт со стипендиями пришлём в PDF — оставьте номер.' },
    visa: { user: 'Сколько идёт виза?', bot: 'Студенческая виза — 3-4 недели от подачи. У нас 97% одобрений в 2024. Подача за 6 месяцев до старта.' },
  };

  $$('.chat-quick button').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = QR[btn.dataset.lpq];
      if (!q) return;
      chatAddMsg(q.user, 'user');
      setTimeout(() => chatAddMsg(q.bot, 'bot'), 600);
    });
  });

  const chatInput = $('#lpChatInput');
  if (chatInput) chatInput.addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = e.target.querySelector('input');
    const val = inp.value.trim();
    if (!val) return;
    chatAddMsg(val, 'user');
    inp.value = '';
    setTimeout(() => chatAddMsg('Спасибо! На реальном сайте — живой консультант. Если срочно — WhatsApp.', 'bot'), 800);
  });

  const LEAD_ENDPOINT = '/api/lead';
  const FORM_CONFIG = {
    lpCtaForm:          { type: 'consultation',       name: 'lpname',   phone: 'lpphone',  email: 'lpemail',  roleName: 'lprole', timeName: 'lptime' },
    lpModalConsultForm: { type: 'consultation_modal', name: 'lpmname',  phone: 'lpmphone', email: 'lpmemail', roleName: 'lpmrole', channelName: 'lpmch', timeName: 'lpmt' },
    lpExitForm:         { type: 'guide_pdf',          name: 'lpexname', contact: 'lpexc' },
  };

  function radioLabel(form, name) {
    const r = form.querySelector('input[name="' + name + '"]:checked');
    const lbl = r && r.closest('label');
    const span = lbl && lbl.querySelector('span');
    return span ? span.textContent.trim() : '';
  }

  function handleForm(formId, msg) {
    const form = document.getElementById(formId);
    if (!form) return;
    const cfg = FORM_CONFIG[formId] || {};
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // honeypot: бот заполнил скрытое поле — тихо «успех», ничего не шлём
      const hp = form.querySelector('input[name="company"]');
      if (hp && hp.value) { form.reset(); toast(msg, 'success'); return; }

      const val = (id) => { const el = id && document.getElementById(id); return el ? el.value.trim() : ''; };
      let phone = val(cfg.phone), email = val(cfg.email);
      const contact = val(cfg.contact);
      if (contact) { if (contact.indexOf('@') >= 0) email = contact; else phone = contact; }

      const payload = {
        name: val(cfg.name),
        phone: phone,
        email: email,
        formType: cfg.type,
        uniSlug: typeof UNI_SLUG !== 'undefined' ? UNI_SLUG : '',
        uniName: typeof UNI_NAME !== 'undefined' ? UNI_NAME : '',
        pageUrl: location.href,
        role: cfg.roleName ? radioLabel(form, cfg.roleName) : '',
        channel: cfg.channelName ? radioLabel(form, cfg.channelName) : '',
        time: cfg.timeName ? radioLabel(form, cfg.timeName) : '',
      };

      if (!payload.name || (!payload.phone && !payload.email)) {
        toast('Заполните имя и телефон', 'error');
        return;
      }

      const btn = form.querySelector('button[type="submit"]') || form.querySelector('button');
      const btnLabel = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Отправляем…'; }
      try {
        const res = await fetch(LEAD_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error((data && data.error) || ('HTTP ' + res.status));
        toast(msg, 'success');
        form.reset();
        const dlg = form.closest('dialog');
        if (dlg) setTimeout(() => closeModal(dlg), 800);
      } catch (err) {
        toast('Не удалось отправить заявку. Напишите нам в WhatsApp или попробуйте ещё раз.', 'error');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
      }
    });
  }
  handleForm('lpCtaForm', 'Заявка отправлена. Перезвоним за 15 минут.');
  handleForm('lpModalConsultForm', 'Заявка отправлена. Перезвоним за 15 минут.');
  handleForm('lpExitForm', 'PDF отправлен. Проверьте email или WhatsApp.');

  let exitShown = false;
  document.addEventListener('mouseout', (e) => {
    if (exitShown) return;
    if (e.clientY <= 0 && !e.relatedTarget) {
      exitShown = true;
      setTimeout(() => openModal('lpExitModal'), 100);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (chatPanel && chatPanel.classList.contains('is-open')) chatClose();
      if (drawer && drawer.classList.contains('is-open')) toggleDrawer(false);
    }
  });
})();
</script>

</Base>
