      </form>
    </aside>
  </div>
</Base>

<!-- Hand chat + form config to client-side scripts via window globals.
     Astro's `define:vars` serializes the JSON into the inline script. -->
<script
  is:inline
  define:vars={{
    chatConfig: STUDYROOM_CHAT,
    formConfig: STUDYROOM_FORM,
    footerCopyright: STUDYROOM_FOOTER.copyright,
  }}
>
  window.CHAT = chatConfig;
  window.__SR_FORM__ = formConfig;
  window.__SR_FOOTER__ = footerCopyright;
</script>

<script>
  import '~/scripts/oxford-phone-mask';
  import '~/scripts/oxford-program-card';
  import '~/scripts/oxford-program-modal';
  import '~/scripts/oxford-chat';
  import '~/scripts/oxford-reveal';

  // ---------- lead forms (inline + final) ----------
  type FormCfg = {
    submit: string;
    success: string;
    fields: { name: { label: string; placeholder: string }; phone: { label: string; placeholder: string } };
    errors: { name: string; phone: string };
  };

  const formCfg = (window as unknown as { __SR_FORM__?: FormCfg }).__SR_FORM__;
  const footerCopy = (window as unknown as { __SR_FOOTER__?: string }).__SR_FOOTER__ ?? '';

  function buildForm(slot: Element): void {
    if (!formCfg) return;
    const wrap = document.createElement('form');
    wrap.className = 'form';
    wrap.setAttribute('novalidate', '');

    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.name = 'name';
    nameInput.placeholder = formCfg.fields.name.placeholder;
    nameInput.setAttribute('aria-label', formCfg.fields.name.label);

    const phoneInput = document.createElement('input');
    phoneInput.type = 'tel';
    phoneInput.name = 'phone';
    phoneInput.placeholder = formCfg.fields.phone.placeholder;
    phoneInput.setAttribute('aria-label', formCfg.fields.phone.label);
    phoneInput.setAttribute('autocomplete', 'tel');

    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'btn btn--primary';
    submit.textContent = formCfg.submit;

    const errLine = document.createElement('div');
    errLine.className = 'form__error';
    errLine.setAttribute('role', 'alert');
    errLine.setAttribute('aria-live', 'polite');

    wrap.append(nameInput, phoneInput, submit, errLine);

    const w = window as unknown as {
      attachPhoneMask?: (el: HTMLInputElement) => void;
      isPhoneValid?: (v: string) => boolean;
    };
    if (typeof w.attachPhoneMask === 'function') w.attachPhoneMask(phoneInput);

    wrap.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const phoneOk =
        typeof w.isPhoneValid === 'function'
          ? w.isPhoneValid(phoneInput.value)
          : phoneInput.value.replace(/\D/g, '').length >= 11;

      let firstError = '';
      if (!name) {
        nameInput.setAttribute('aria-invalid', 'true');
        firstError = formCfg.errors.name;
      } else {
        nameInput.removeAttribute('aria-invalid');
      }
      if (!phoneOk) {
        phoneInput.setAttribute('aria-invalid', 'true');
        if (!firstError) firstError = formCfg.errors.phone;
      } else {
        phoneInput.removeAttribute('aria-invalid');
      }
      errLine.textContent = firstError;
      if (firstError) return;

      // TODO: wire to real CRM (Telegram bot, email, webhook).
      const success = document.createElement('div');
      success.className = 'form__success';
      success.textContent = formCfg.success;
      wrap.replaceChildren(success);
    });

    slot.appendChild(wrap);
  }

  document.querySelectorAll('.cta__form-slot').forEach(buildForm);

  // ---------- footer year + copyright ----------
  const year = new Date().getFullYear();
  const yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = String(year);
  document.querySelectorAll('.site-footer__copy').forEach((n) => {
    n.textContent = `© ${year} ${footerCopy}`;
  });
</script>

