---
// Per-university landing page.
// Visual design ported from projects/studyroom-oxford-landing/ (the original
// hand-tuned Oxford Tilda-style page) and adapted for any of the 16 Kaplan
// partners by reading from the validated University record.
//
// Sections that need per-uni data the scraper hasn't filled yet (hero photos,
// gallery, accommodation, campuses, video reviews, exact location coords) are
// marked with `[TBD]` placeholders or hidden entirely. See BACKLOG Stage 11
// for the full list of fields the scraper extension needs to populate.

import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import '~/styles/oxford-landing.css';
import {
  STUDYROOM_BENEFITS,
  STUDYROOM_ACTIVITIES,
  STUDYROOM_FAQ,
  STUDYROOM_REVIEWS,
  STUDYROOM_ABOUT,
  STUDYROOM_DATES_TIMELINE,
  STUDYROOM_FORM,
  STUDYROOM_FOOTER,
  STUDYROOM_CHAT,
} from '~/content/studyroom/static';

export async function getStaticPaths() {
  const entries = await getCollection('universities');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'universities'>;
}

const { entry } = Astro.props;
const u = entry.data;

// ---------- derived view models ----------

interface FacultyGroup {
  name: string;
  programs: Array<{
    slug: string;
    title: string;
    level: string;
    durationYears: number;
    intakes: string[];
    tuition: number | undefined;
    programType: string | undefined;
    programUrl: string | undefined;
  }>;
  minTuition: number;
  maxTuition: number;
}

const LEVEL_LABELS: Record<string, string> = {
  foundation: 'Foundation',
  bachelor: 'Бакалавриат',
  master: "Pre-Master's / Магистратура",
  phd: 'PhD',
};

const LEVEL_ORDER: Record<string, number> = {
  foundation: 1,
  bachelor: 2,
  master: 3,
  phd: 4,
};

const programRows = u.programs.map((p) => ({
  slug: p.slug,
  title: p.title,
  level: p.level,
  faculty: p.faculty ?? 'Прочее',
  durationYears: p.durationYears,
  intakes: p.intakes ?? [],
  tuition: u.tuition.byProgram[p.slug],
  programType: p.programType,
  programUrl: p.programUrl,
}));

const facultyMap = new Map<string, FacultyGroup>();
for (const r of programRows) {
  const existing = facultyMap.get(r.faculty);
  if (existing) {
    existing.programs.push(r);
  } else {
    facultyMap.set(r.faculty, {
      name: r.faculty,
      programs: [r],
      minTuition: 0,
      maxTuition: 0,
    });
  }
}
for (const fac of facultyMap.values()) {
  fac.programs.sort((a, b) => {
    const lvl = (LEVEL_ORDER[a.level] ?? 99) - (LEVEL_ORDER[b.level] ?? 99);
    if (lvl !== 0) return lvl;
    return (a.tuition ?? 0) - (b.tuition ?? 0);
  });
  const tuitions = fac.programs
    .map((p) => p.tuition)
    .filter((t): t is number => typeof t === 'number' && t > 0);
  fac.minTuition = tuitions.length ? Math.min(...tuitions) : 0;
  fac.maxTuition = tuitions.length ? Math.max(...tuitions) : 0;
}

const faculties = Array.from(facultyMap.values()).sort(
  (a, b) => b.programs.length - a.programs.length || a.name.localeCompare(b.name, 'ru')
);
const topFaculties = faculties.slice(0, 6);

const tuitionValues = Object.values(u.tuition.byProgram).filter((v) => v > 0);
const tuitionMin = tuitionValues.length ? Math.min(...tuitionValues) : 0;
const tuitionMax = tuitionValues.length ? Math.max(...tuitionValues) : 0;
const tuitionRange =
  tuitionMin === 0
    ? '[TBD: уточняется]'
    : tuitionMin === tuitionMax
      ? `${tuitionMin.toLocaleString('ru-RU')} ${u.tuition.currency}`
      : `${tuitionMin.toLocaleString('ru-RU')}–${tuitionMax.toLocaleString('ru-RU')} ${u.tuition.currency}`;

const lastChecked = new Date(u.lastChecked).toLocaleDateString('ru-RU', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

function programsCountLabel(n: number): string {
  if (n % 10 === 1 && n % 100 !== 11) return n + ' программа';
  if ([2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100)) return n + ' программы';
  return n + ' программ';
}

// Google Maps embed by name search (no API key needed, works over http/https).
// Per-uni precise coords would let us swap to the modern `/maps/embed?pb=...`
// form — that's part of the scraper extension.
const mapsQuery = encodeURIComponent(`${u.name}, ${u.city}, ${u.country}`);
const mapsEmbedUrl = `https://maps.google.com/maps?q=${mapsQuery}&output=embed`;
const mapsOpenUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

const heroSubtitle = `${u.city} · ${u.country}`;
const description = `${u.name} — поступление через StudyRoom. Программы, стоимость и дедлайны обновлены ${lastChecked}.`;
---

<Base title={`${u.name} — StudyRoom`} description={description}>
  <main>

    <!-- 1. Hero -->
    <section id="hero" class="section hero">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div>
          <p class="hero__subtitle">{heroSubtitle}</p>
          <h1 class="hero__title">{u.name}</h1>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#cta">Записаться на консультацию</a>
            <a class="btn btn--ghost" href="#programs">Программы обучения</a>
          </div>
        </div>
        <div class="hero__cover hero__cover--logo">
          <img src={`/logos/${u.slug}.png`} alt={u.name} />
        </div>
      </div>
    </section>

    <!-- 2. Benefits -->
    <section id="benefits" class="section section--soft benefits">
      <div class="container">
        <div class="benefits__grid">
          {STUDYROOM_BENEFITS.map((b) => (
            <div class="benefit">
              <span class="benefit__num">{b.num}</span>
              <h3 class="benefit__title">{b.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Description -->
    <section id="description" class="section description">
      <div class="container">
        <div class="section__head">
          <h2 class="description__title">Об университете</h2>
        </div>
        <div class="description__body">
          <p>
            <strong>{u.name}</strong> — университет в городе {u.city} ({u.country}). Партнёрский договор
            со StudyRoom через Kaplan Pathways.
          </p>
          <p>
            На лендинге доступно <strong>{u.programs.length}</strong> программ из <strong>{faculties.length}</strong>
            факультетов. Стоимость обучения: <strong>{tuitionRange}</strong> в год.
            Данные обновлены: {lastChecked}.
          </p>
          <p>
            <span class="tbd">[TBD: исторический контекст, год основания, кол-во студентов, рейтинг QS / THE, известные выпускники, исследовательский профиль — заполнит расширенный скрейпер.]</span>
          </p>
          {topFaculties.length > 0 && (
            <>
              <h3 class="description__pros-title">Основные направления</h3>
              <ul class="description__pros">
                {topFaculties.map((f) => (
                  <li>{f.name} <span class="muted-inline">· {programsCountLabel(f.programs.length)}</span></li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- 3b. Gallery — university photos (oxford-style 1.2fr/1fr mosaic) -->
    {u.gallery && u.gallery.items.length > 0 && (
      <section id="gallery" class="section gallery">
        <div class="container">
          <div class="section__head">
            <h2 class="gallery__title">Фото университета</h2>
            <p class="gallery__subtitle">Как выглядит кампус, в котором будут учиться наши студенты.</p>
          </div>
          <div class="gallery__grid">
            {u.gallery.items.slice(0, 3).map((item, i) => (
              <figure class={`gallery__tile gallery__tile--${i + 1}`}>
                <img src={item.img} alt={item.caption ?? ''} loading="lazy" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4. Programs + inline CTA -->
    <section id="programs" class="section section--soft programs">
      <div class="container">
        <div class="section__head">
          <h2>Программы обучения</h2>
          <p>{faculties.length} факультетов · {u.programs.length} программ</p>
        </div>

        <div class="programs__grid">
          {topFaculties.map((fac, idx) => {
            const panelId = `program-panel-${idx}`;
            return (
              <article class="card program-card">
                <div class="program-card__body">
                  <span class="card__sub">{fac.programs.length} {fac.programs.length === 1 ? 'программа' : 'программ'}</span>
                  <h3 class="card__title">{fac.name}</h3>
                  {fac.minTuition > 0 && (
                    <p class="card__text">
                      от <strong>{fac.minTuition.toLocaleString('ru-RU')}</strong>
                      {fac.maxTuition > fac.minTuition && <> · до {fac.maxTuition.toLocaleString('ru-RU')}</>}
                      {' '}{u.tuition.currency}/год
                    </p>
                  )}
                  <button
                    class="program-card__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="program-card__toggle-label">Подробнее</span>
                    <span class="program-card__toggle-icon" aria-hidden="true"></span>
                  </button>
                </div>
                <div class="program-card__details" id={panelId} role="region" aria-hidden="true">
                  <div class="program-card__details-inner">
                    {fac.programs.slice(0, 8).map((p) => (
                      <p class="card__text">
                        <strong>{LEVEL_LABELS[p.level] ?? p.level}:</strong> {p.title}
                        {p.tuition !== undefined && p.tuition > 0 && (
                          <> — <strong>{p.tuition.toLocaleString('ru-RU')}</strong> {u.tuition.currency}/год</>
                        )}
                      </p>
                    ))}
                    {fac.programs.length > 8 && (
                      <p class="card__text muted-inline">… и ещё {fac.programs.length - 8} программ</p>
                    )}
                    <a class="btn btn--primary" href="#cta">Узнать о поступлении</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="cta-inline">
          <h2 class="cta__title">{STUDYROOM_FORM.inlineTitle}</h2>
          <p class="cta__text">{STUDYROOM_FORM.inlineText}</p>
          <div class="cta__form-slot"></div>
        </div>
      </div>
    </section>

    <!-- 5. Dates -->
    <section id="dates" class="section dates">
      <div class="dates__bg" aria-hidden="true"></div>
      <div class="container">
        <h2 class="dates__title">Даты приёма заявок</h2>
        <div class="dates__timeline">
          <span class="dates__line" aria-hidden="true"></span>
          <ol class="dates__items">
            {STUDYROOM_DATES_TIMELINE.map((d) => (
              <li class="dates__item">
                <span class="dates__item-dot" aria-hidden="true"></span>
                <div class="dates__item-title">{d.title}</div>
                <p class="dates__item-text">{d.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <p class="dates__note">
          <span class="tbd">[TBD: точные дедлайны для {u.name} — сверить с {u.sourceUrl} перед запуском.]</span>
        </p>
        <div class="dates__cta-row">
          <a class="btn btn--primary" href="#cta">Запросить актуальные даты</a>
        </div>
      </div>
    </section>

    <!-- 6. Activities -->
    <section id="activities" class="section section--soft activities">
      <div class="container">
        <div class="section__head">
          <h2>Что мы делаем</h2>
        </div>
        <div class="activities__grid">
          {STUDYROOM_ACTIVITIES.map((a) => (
            <article class="card">
              <h3 class="card__title">{a.title}</h3>
              <p class="card__text">{a.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Requirements + Scholarships (2-column) -->
    <section id="requirements" class="section requirements">
      <div class="container">
        <div class="requirements__row">
          <div class="requirements__col">
            <h2 class="requirements__title">Требования к поступающим</h2>
            <ul class="requirements__list">
              {u.requirements.language?.ielts !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">IELTS:</strong>
                  <span class="requirements__text"> от {u.requirements.language.ielts}</span>
                </li>
              )}
              {u.requirements.language?.toefl !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">TOEFL iBT:</strong>
                  <span class="requirements__text"> от {u.requirements.language.toefl}</span>
                </li>
              )}
              {u.requirements.language?.duolingo !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">Duolingo:</strong>
                  <span class="requirements__text"> от {u.requirements.language.duolingo}</span>
                </li>
              )}
              {u.requirements.gpa !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">GPA:</strong>
                  <span class="requirements__text"> от {u.requirements.gpa} / 4.0</span>
                </li>
              )}
              {u.requirements.exams.length > 0 && (
                <li class="requirements__item">
                  <strong class="requirements__label">Экзамены:</strong>
                  <span class="requirements__text"> {u.requirements.exams.join(', ')}</span>
                </li>
              )}
              <li class="requirements__item requirements__item--note">
                <span class="requirements__text">
                  Точные требования зависят от программы и могут отличаться. Уточняйте на консультации.
                </span>
              </li>
            </ul>
          </div>
          <div class="requirements__col">
            <h2 class="scholarships__title">Стипендии и скидки</h2>
            {u.scholarships.length === 0 ? (
              <p class="scholarships__text">
                <span class="tbd">[TBD: список стипендий и скидок — заполнит расширенный скрейпер.]</span> На данный
                момент конкретные программы стипендий не указаны. Уточняйте актуальные опции на бесплатной консультации.
              </p>
            ) : (
              <ul class="requirements__list">
                {u.scholarships.map((s) => (
                  <li class="requirements__item">
                    <strong class="requirements__label">{s.name}</strong>
                    {s.amountUSD !== undefined && (
                      <span class="requirements__text"> — до ${s.amountUSD.toLocaleString('ru-RU')}</span>
                    )}
                    {s.deadline && <span class="requirements__text"> · до {s.deadline}</span>}
                    {s.url && (
                      <span class="requirements__text"> · <a href={s.url} target="_blank" rel="noopener">подробнее</a></span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Important -->
    <section id="important" class="section section--soft important">
      <div class="container">
        <div class="section__head">
          <h2 class="important__title">Важно знать перед поездкой</h2>
        </div>
        <div class="important__grid">
          {STUDYROOM_FAQ.map((item) => (
            <article class="card">
              <h3 class="card__title">{item.title}</h3>
              <p class="card__text">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. About StudyRoom -->
    <section id="about" class="section about">
      <div class="container">
        <div class="section__head">
          <h2 class="about__title">{STUDYROOM_ABOUT.title}</h2>
        </div>
        <div class="about__body description__body">
          {STUDYROOM_ABOUT.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- 12. Reviews -->
    <section id="reviews" class="section section--soft reviews">
      <div class="container">
        <div class="section__head">
          <h2 class="reviews__title">Отзывы наших студентов</h2>
        </div>
        <div class="reviews__grid">
          {STUDYROOM_REVIEWS.map((r) => (
            <article class="review">
              {r.thumbnail && <img src={r.thumbnail} alt={r.name} />}
              <div class="review__play" aria-hidden="true"></div>
              <div class="review__body">
                <div class="review__name">{r.name}</div>
                <div class="review__program">{r.program}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 12b. Location -->
    <section id="location" class="section location">
      <div class="container">
        <div class="section__head">
          <h2 class="location__title">Где находится {u.name}</h2>
          <p class="location__subtitle">{u.city}, {u.country}</p>
        </div>
        <div class="location__frame">
          <iframe
            class="location__map"
            title={`Расположение ${u.name} на карте`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            src={mapsEmbedUrl}
          ></iframe>
        </div>
        <p class="location__address">
          {u.name}, {u.city}, {u.country}
          {' — '}
          <a class="location__address-link" href={mapsOpenUrl} target="_blank" rel="noopener noreferrer">
            открыть в Google Maps
          </a>
        </p>
      </div>
    </section>

    <!-- 13. Final CTA -->
    <section id="cta" class="section">
      <div class="container">
        <div class="cta-final">
          <h2 class="cta__title">{STUDYROOM_FORM.finalTitle}</h2>
          <p class="cta__text">{STUDYROOM_FORM.finalText}</p>
          <div class="cta__form-slot"></div>
        </div>
      </div>
    </section>
  </main>

  <!-- 14. Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__row">
        <div>
          <div class="site-footer__copy"></div>
          <div class="site-footer__legal">{STUDYROOM_FOOTER.legal}</div>
        </div>
        <ul class="site-footer__links">
          {STUDYROOM_FOOTER.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="site-footer__legal" style="margin-top: 24px;">
        Year: <span id="footer-year"></span>
      </div>
    </div>
  </footer>

  <!-- 15. Chat widget -->
  <div class="chat" data-state="closed">
    <button class="chat__fab" type="button" aria-label="Открыть чат" aria-expanded="false" aria-controls="chat-panel">
      <svg class="chat__fab-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 4V6a2 2 0 0 1 2-2h-2z" fill="currentColor"/>
      </svg>
      <span class="chat__fab-badge" aria-hidden="true">1</span>
    </button>
    <aside id="chat-panel" class="chat__panel" role="dialog" aria-modal="false" aria-label="Чат с консультантом" aria-hidden="true">
      <header class="chat__header">
        <div class="chat__avatar"></div>
        <div class="chat__head-info">
          <div class="chat__head-name"></div>
          <div class="chat__head-status">
            <span class="chat__head-dot" aria-hidden="true"></span>
            <span class="chat__head-status-text">Онлайн</span>
          </div>
        </div>
        <button class="chat__close" type="button" aria-label="Закрыть чат">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </button>
      </header>
      <div class="chat__body">
        <ol class="chat__messages" aria-live="polite"></ol>
        <div class="chat__quick"></div>
      </div>
      <form class="chat__form" novalidate>
        <input class="chat__input" type="text" name="message" autocomplete="off" required>
        <button class="chat__send" type="submit" aria-label="Отправить">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
            <path d="M3 12l18-8-8 18-2-8-8-2z" fill="currentColor"/>
          </svg>
        </button>
      </form>
    </aside>
  </div>
</Base>

<!-- Hand chat + form config to client-side scripts via window globals.
     Astro's `define:vars` serializes the JSON into the inline script. -->
<script
  is:inline
  define:vars={{
    chatConfig: STUDYROOM_CHAT,
    formConfig: STUDYROOM_FORM,
    footerCopyright: STUDYROOM_FOOTER.copyright,
  }}
>
  window.CHAT = chatConfig;
  window.__SR_FORM__ = formConfig;
  window.__SR_FOOTER__ = footerCopyright;
</script>

<script>
  import '~/scripts/oxford-phone-mask';
  import '~/scripts/oxford-program-card';
  import '~/scripts/oxford-chat';
  import '~/scripts/oxford-reveal';

  // ---------- lead forms (inline + final) ----------
  type FormCfg = {
    submit: string;
    success: string;
    fields: { name: { label: string; placeholder: string }; phone: { label: string; placeholder: string } };
    errors: { name: string; phone: string };
  };

  const formCfg = (window as unknown as { __SR_FORM__?: FormCfg }).__SR_FORM__;
  const footerCopy = (window as unknown as { __SR_FOOTER__?: string }).__SR_FOOTER__ ?? '';

  function buildForm(slot: Element): void {
    if (!formCfg) return;
    const wrap = document.createElement('form');
    wrap.className = 'form';
    wrap.setAttribute('novalidate', '');

    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.name = 'name';
    nameInput.placeholder = formCfg.fields.name.placeholder;
    nameInput.setAttribute('aria-label', formCfg.fields.name.label);

    const phoneInput = document.createElement('input');
    phoneInput.type = 'tel';
    phoneInput.name = 'phone';
    phoneInput.placeholder = formCfg.fields.phone.placeholder;
    phoneInput.setAttribute('aria-label', formCfg.fields.phone.label);
    phoneInput.setAttribute('autocomplete', 'tel');

    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'btn btn--primary';
    submit.textContent = formCfg.submit;

    const errLine = document.createElement('div');
    errLine.className = 'form__error';
    errLine.setAttribute('role', 'alert');
    errLine.setAttribute('aria-live', 'polite');

    wrap.append(nameInput, phoneInput, submit, errLine);

    const w = window as unknown as {
      attachPhoneMask?: (el: HTMLInputElement) => void;
      isPhoneValid?: (v: string) => boolean;
    };
    if (typeof w.attachPhoneMask === 'function') w.attachPhoneMask(phoneInput);

    wrap.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const phoneOk =
        typeof w.isPhoneValid === 'function'
          ? w.isPhoneValid(phoneInput.value)
          : phoneInput.value.replace(/\D/g, '').length >= 11;

      let firstError = '';
      if (!name) {
        nameInput.setAttribute('aria-invalid', 'true');
        firstError = formCfg.errors.name;
      } else {
        nameInput.removeAttribute('aria-invalid');
      }
      if (!phoneOk) {
        phoneInput.setAttribute('aria-invalid', 'true');
        if (!firstError) firstError = formCfg.errors.phone;
      } else {
        phoneInput.removeAttribute('aria-invalid');
      }
      errLine.textContent = firstError;
      if (firstError) return;

      // TODO: wire to real CRM (Telegram bot, email, webhook).
      const success = document.createElement('div');
      success.className = 'form__success';
      success.textContent = formCfg.success;
      wrap.replaceChildren(success);
    });

    slot.appendChild(wrap);
  }

  document.querySelectorAll('.cta__form-slot').forEach(buildForm);

  // ---------- footer year + copyright ----------
  const year = new Date().getFullYear();
  const yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = String(year);
  document.querySelectorAll('.site-footer__copy').forEach((n) => {
    n.textContent = `© ${year} ${footerCopy}`;
  });
</script>

