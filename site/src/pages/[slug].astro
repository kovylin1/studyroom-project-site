---
// Per-university landing page (RU). Thin wrapper around LandingBody (Task 7 i18n).
// EN/KK live under /[lang]/[slug].astro (Task 8).
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import LandingBody from '~/components/LandingBody.astro';
import { CURRENCY_SYMBOL } from '~/content/studyroom/static';

export async function getStaticPaths() {
  const entries = await getCollection('universities');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { u: entry.data, uniCount: entries.length },
  }));
}

const { u, uniCount } = Astro.props;
const sym = CURRENCY_SYMBOL[u.tuition.currency] ?? u.tuition.currency;
const tuitionValues = Object.values(u.tuition.byProgram).filter((v) => v > 0);
const tuitionMin = tuitionValues.length ? Math.min(...tuitionValues) : 0;

const pageTitle = `${u.name} — поступление из Казахстана | StudyRoom`;
const pageDescription = `Поступление в ${u.name} (${u.city}, ${u.country}): ${u.programs.length} программ, стоимость от ${sym}${tuitionMin.toLocaleString('en')}, IELTS от ${u.requirements?.language?.ielts ?? 5.5}. Бесплатная консультация StudyRoom.`;
---
<Base title={pageTitle} description={pageDescription} hideHeader={true}>
  <LandingBody u={u} locale="ru" uniCount={uniCount} />
</Base>
