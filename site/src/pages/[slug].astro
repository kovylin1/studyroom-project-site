---
// Per-university landing page.
// Visual design ported from projects/studyroom-oxford-landing/ (the original
// hand-tuned Oxford Tilda-style page) and adapted for any of the 16 Kaplan
// partners by reading from the validated University record.
//
// Sections that need per-uni data the scraper hasn't filled yet (hero photos,
// gallery, accommodation, campuses, video reviews, exact location coords) are
// marked with `[TBD]` placeholders or hidden entirely. See BACKLOG Stage 11
// for the full list of fields the scraper extension needs to populate.

import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import '~/styles/oxford-landing.css';
import {
  STUDYROOM_BENEFITS,
  STUDYROOM_ACTIVITIES,
  STUDYROOM_FAQ,
  STUDYROOM_REVIEWS,
  STUDYROOM_ABOUT,
  STUDYROOM_DATES_TIMELINE,
  STUDYROOM_FORM,
  STUDYROOM_FOOTER,
  STUDYROOM_CHAT,
} from '~/content/studyroom/static';

export async function getStaticPaths() {
  const entries = await getCollection('universities');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'universities'>;
}

const { entry } = Astro.props;
const u = entry.data;

// ---------- derived view models ----------

interface FacultyGroup {
  name: string;
  programs: Array<{
    slug: string;
    title: string;
    level: string;
    durationYears: number;
    intakes: string[];
    tuition: number | undefined;
    programType: string | undefined;
    programUrl: string | undefined;
  }>;
  minTuition: number;
  maxTuition: number;
}

const LEVEL_LABELS: Record<string, string> = {
  foundation: 'Foundation',
  bachelor: 'Бакалавриат',
  master: 'Магистратура',
  phd: 'PhD',
};

// Pill label combines level + programType. The master+pathway combo is a
// 1-year prep course (Pre-Master's), not an actual master's degree — keep
// them visually distinct so the title list reads correctly. Shorter than
// "Pre-Master's / Магистратура" so the modal pill fits its 120px column.
function levelLabel(level: string, programType?: string): string {
  if (level === 'master' && programType === 'pathway') return "Pre-Master's";
  return LEVEL_LABELS[level] ?? level;
}

const LEVEL_ORDER: Record<string, number> = {
  foundation: 1,
  bachelor: 2,
  master: 3,
  phd: 4,
};

const programRows = u.programs.map((p) => ({
  slug: p.slug,
  title: p.title,
  level: p.level,
  faculty: p.faculty ?? 'Прочее',
  durationYears: p.durationYears,
  intakes: p.intakes ?? [],
  tuition: u.tuition.byProgram[p.slug],
  programType: p.programType,
  programUrl: p.programUrl,
}));

const facultyMap = new Map<string, FacultyGroup>();
for (const r of programRows) {
  const existing = facultyMap.get(r.faculty);
  if (existing) {
    existing.programs.push(r);
  } else {
    facultyMap.set(r.faculty, {
      name: r.faculty,
      programs: [r],
      minTuition: 0,
      maxTuition: 0,
    });
  }
}
for (const fac of facultyMap.values()) {
  fac.programs.sort((a, b) => {
    const lvl = (LEVEL_ORDER[a.level] ?? 99) - (LEVEL_ORDER[b.level] ?? 99);
    if (lvl !== 0) return lvl;
    return (a.tuition ?? 0) - (b.tuition ?? 0);
  });
  const tuitions = fac.programs
    .map((p) => p.tuition)
    .filter((t): t is number => typeof t === 'number' && t > 0);
  fac.minTuition = tuitions.length ? Math.min(...tuitions) : 0;
  fac.maxTuition = tuitions.length ? Math.max(...tuitions) : 0;
}

const faculties = Array.from(facultyMap.values()).sort(
  (a, b) => b.programs.length - a.programs.length || a.name.localeCompare(b.name, 'ru')
);
const topFaculties = faculties.slice(0, 6);

const tuitionValues = Object.values(u.tuition.byProgram).filter((v) => v > 0);
const tuitionMin = tuitionValues.length ? Math.min(...tuitionValues) : 0;
const tuitionMax = tuitionValues.length ? Math.max(...tuitionValues) : 0;
const tuitionRange =
  tuitionMin === 0
    ? '[TBD: уточняется]'
    : tuitionMin === tuitionMax
      ? `${tuitionMin.toLocaleString('ru-RU')} ${u.tuition.currency}`
      : `${tuitionMin.toLocaleString('ru-RU')}–${tuitionMax.toLocaleString('ru-RU')} ${u.tuition.currency}`;

const lastChecked = new Date(u.lastChecked).toLocaleDateString('ru-RU', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

function programsCountLabel(n: number): string {
  if (n % 10 === 1 && n % 100 !== 11) return n + ' программа';
  if ([2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100)) return n + ' программы';
  return n + ' программ';
}

// Map embed via OpenStreetMap. Google Maps' `maps.google.com/?q=…&output=embed`
// silently fails in many contexts (file://, no API key, occasional region blocks),
// so we use OSM which has no key requirement and works on any origin. Coords are
// hardcoded per slug — accurate to the main campus building. Future scraper
// extension can geocode from sourceUrl + city, then store on University.location.
const UNI_COORDS: Record<string, { lat: number; lng: number }> = {
  'asu-london': { lat: 51.5097, lng: -0.0871 },
  'birmingham': { lat: 52.4508, lng: -1.9305 },
  'bournemouth': { lat: 50.7426, lng: -1.8973 },
  'brighton': { lat: 50.8629, lng: -0.0879 },
  'bristol': { lat: 51.4585, lng: -2.6019 },
  'city-london': { lat: 51.5275, lng: -0.1019 },
  'cranfield': { lat: 52.0716, lng: -0.6259 },
  'essex': { lat: 51.8780, lng: 0.9442 },
  'glasgow': { lat: 55.8721, lng: -4.2880 },
  'liverpool': { lat: 53.4060, lng: -2.9657 },
  'nottingham': { lat: 52.9382, lng: -1.1972 },
  'nottingham-trent': { lat: 52.9530, lng: -1.1495 },
  'queen-mary-london': { lat: 51.5246, lng: -0.0405 },
  'uwe-bristol': { lat: 51.5009, lng: -2.5470 },
  'westminster': { lat: 51.5174, lng: -0.1444 },
  'york': { lat: 53.9460, lng: -1.0538 },
};

const coords = UNI_COORDS[u.slug];
// Small bbox around the marker (≈city-level zoom). OSM embed needs both.
const BBOX_PAD_LAT = 0.012;
const BBOX_PAD_LNG = 0.024;
const bbox = coords
  ? [
      (coords.lng - BBOX_PAD_LNG).toFixed(4),
      (coords.lat - BBOX_PAD_LAT).toFixed(4),
      (coords.lng + BBOX_PAD_LNG).toFixed(4),
      (coords.lat + BBOX_PAD_LAT).toFixed(4),
    ].join(',')
  : null;
const mapsEmbedUrl = coords
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${coords.lat},${coords.lng}`
  : null;
const mapsOpenUrl = coords
  ? `https://www.google.com/maps/?q=${coords.lat},${coords.lng}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${u.name}, ${u.city}, ${u.country}`)}`;

const heroSubtitle = `${u.city} · ${u.country}`;
const description = `${u.name} — поступление через StudyRoom. Программы, стоимость и дедлайны обновлены ${lastChecked}.`;

// Split a "$79 [TBD] $200"-style or "[TBD: £/нед]"-style price into the
// visible price text plus a TBD badge flag — mirrors oxford-landing's
// `withTBD()` helper. Used by accommodation cards below.
function priceParts(price: string | undefined): { text: string; tbd: boolean } {
  if (!price) return { text: '', tbd: false };
  const wholeTbd = price.match(/^\s*\[TBD(?::\s*(.*?))?\]\s*$/);
  if (wholeTbd) return { text: (wholeTbd[1] ?? '').trim(), tbd: true };
  const inline = price.match(/^(.*?)\s*\[TBD(?::\s*.*?)?\]\s*(.*)$/);
  if (inline) return { text: `${inline[1]} ${inline[2]}`.replace(/\s+/g, ' ').trim(), tbd: true };
  return { text: price, tbd: false };
}

// Photo allocation strategy (avoids repetition across visually-adjacent
// sections). With ~10 photos per uni:
//   Hero (top of page):                photos 1, 2
//   Gallery (right under hero):        photos 3, 4, 5  — see slice(HERO_SKIP)
//   Faculty / programs cards:          photos 6+      — see FACULTY_SKIP
//   Campus cards (cli.ts):             photos 6-9
//   Accommodation cards (cli.ts):      photos 10, 9, 8
// Faculty cards share the 6-10 pool with campus + accommodation, but those
// sections are separated by several content blocks so the repetition is
// far less noticeable than hero ↔ gallery side-by-side.
const galleryPhotos = u.gallery?.items?.map((it) => it.img) ?? [];
const heroBgPhoto = galleryPhotos[0];
const heroCoverPhoto = galleryPhotos[1] ?? galleryPhotos[0];
const HERO_SKIP = 2;
const FACULTY_SKIP = 5; // skip hero (1-2) + gallery tiles (3-5)
const facultyPool =
  galleryPhotos.length > FACULTY_SKIP ? galleryPhotos.slice(FACULTY_SKIP) :
  galleryPhotos.length > HERO_SKIP ? galleryPhotos.slice(HERO_SKIP) : galleryPhotos;
function facultyPhoto(i: number): string | undefined {
  if (facultyPool.length === 0) return undefined;
  return facultyPool[i % facultyPool.length];
}

// Per-uni faculty image overrides. Used when the generic gallery-pool fallback
// would show an off-topic photo for a thematic faculty card. Keyed by uni slug
// then by faculty name (must match the value written by the scraper into
// `programs[].faculty`). When no override is present, `facultyPhoto(idx)` is
// used instead.
const FACULTY_IMAGE_OVERRIDES: Record<string, Record<string, string>> = {
  victoria: {
    'Engineering and Computer Science': '/photos/victoria/faculties/engineering.jpg',
    'Science': '/photos/victoria/faculties/science.jpg',
    'Humanities': '/photos/victoria/faculties/humanities.jpg',
    'Social Sciences': '/photos/victoria/faculties/social-sciences.jpg',
    'Fine Arts': '/photos/victoria/faculties/fine-arts.jpg',
    'Business': '/photos/victoria/faculties/business.jpg',
    'Health Sciences': '/photos/victoria/faculties/health.jpg',
    'Education': '/photos/victoria/faculties/education.jpg',
  },
};
function facultyImage(facultyName: string, idx: number): string | undefined {
  return FACULTY_IMAGE_OVERRIDES[u.slug]?.[facultyName] ?? facultyPhoto(idx);
}
---

<Base title={`${u.name} — StudyRoom`} description={description}>
  <main>

    <!-- 1. Hero -->
    <section id="hero" class="section hero">
      <div
        class="hero__bg"
        aria-hidden="true"
        style={heroBgPhoto ? `background-image:url("${heroBgPhoto}")` : undefined}
      ></div>
      <div class="container hero__inner">
        <div>
          <p class="hero__subtitle">{heroSubtitle}</p>
          <h1 class="hero__title">{u.name}</h1>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#cta">Записаться на консультацию</a>
            <a class="btn btn--ghost" href="#programs">Программы обучения</a>
          </div>
        </div>
        {heroCoverPhoto ? (
          <img class="hero__cover" src={heroCoverPhoto} alt={`Кампус ${u.name}`} loading="eager" />
        ) : (
          <div class="hero__cover hero__cover--logo">
            <img src={`/logos/${u.slug}.png`} alt={u.name} />
          </div>
        )}
      </div>
    </section>

    <!-- 2. Benefits -->
    <section id="benefits" class="section section--soft benefits">
      <div class="container">
        <div class="benefits__grid">
          {STUDYROOM_BENEFITS.map((b) => (
            <div class="benefit">
              <span class="benefit__num">{b.num}</span>
              <h3 class="benefit__title">{b.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Description -->
    <section id="description" class="section description">
      <div class="container">
        <div class="section__head">
          <h2 class="description__title">Об университете</h2>
        </div>
        <div class="description__body">
          <p>
            <strong>{u.name}</strong> — университет в городе {u.city} ({u.country}). Партнёрский договор
            со StudyRoom через Kaplan Pathways.
          </p>
          <p>
            На лендинге доступно <strong>{u.programs.length}</strong> программ из <strong>{faculties.length}</strong>
            факультетов. Стоимость обучения: <strong>{tuitionRange}</strong> в год.
            Данные обновлены: {lastChecked}.
          </p>
          {(() => {
            // Prefer Russian translation when present (curated in
            // scraper/src/sources/description-translations.ts); fall back to
            // English scraped paragraphs; fall back to a TBD placeholder.
            const paras = u.description?.paragraphsRu?.length
              ? u.description.paragraphsRu
              : u.description?.paragraphs ?? [];
            const facts = u.description?.keyFactsRu?.length
              ? u.description.keyFactsRu
              : u.description?.keyFacts ?? [];
            return (
              <>
                {paras.length ? (
                  paras.map((para) => <p>{para}</p>)
                ) : (
                  <p>
                    <span class="tbd">[TBD: исторический контекст, год основания, кол-во студентов, рейтинг QS / THE, известные выпускники, исследовательский профиль — заполнит расширенный скрейпер.]</span>
                  </p>
                )}
                {facts.length ? (
                  <>
                    <h3 class="description__pros-title">Рейтинги и факты</h3>
                    <ul class="description__pros">
                      {facts.map((f) => <li>{f}</li>)}
                    </ul>
                  </>
                ) : null}
              </>
            );
          })()}
          {topFaculties.length > 0 && (
            <>
              <h3 class="description__pros-title">Основные направления</h3>
              <ul class="description__pros">
                {topFaculties.map((f) => (
                  <li>{f.name} <span class="muted-inline">· {programsCountLabel(f.programs.length)}</span></li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- 3b. Gallery — university photos (oxford-style 1.2fr/1fr mosaic) -->
    {u.gallery && u.gallery.items.length > 0 && (() => {
      // Skip the 2 hero photos so the gallery shows DIFFERENT tiles below the
      // hero. Falls back to "all photos" only when the uni has fewer than 3
      // gallery items (in which case duplication is unavoidable but rare).
      const galleryTiles = u.gallery.items.length > HERO_SKIP
        ? u.gallery.items.slice(HERO_SKIP, HERO_SKIP + 3)
        : u.gallery.items.slice(0, 3);
      if (galleryTiles.length === 0) return null;
      return (
        <section id="gallery" class="section gallery">
          <div class="container">
            <div class="section__head">
              <h2 class="gallery__title">Фото университета</h2>
              <p class="gallery__subtitle">Как выглядит кампус, в котором будут учиться наши студенты.</p>
            </div>
            <div class="gallery__grid">
              {galleryTiles.map((item, i) => (
                <figure class={`gallery__tile gallery__tile--${i + 1}`}>
                  <img src={item.img} alt={item.caption ?? ''} loading="lazy" />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      );
    })()}

    <!-- 4. Programs + inline CTA -->
    <section id="programs" class="section section--soft programs">
      <div class="container">
        <div class="section__head">
          <h2>Программы обучения</h2>
          <p>{faculties.length} факультетов · {u.programs.length} программ</p>
        </div>

        <div class="programs__grid">
          {topFaculties.map((fac, idx) => {
            const panelId = `program-panel-${idx}`;
            const facImg = facultyImage(fac.name, idx);
            return (
              <article class="card program-card">
                {facImg && (
                  <img
                    class="program-card__img"
                    src={facImg}
                    alt={`${u.name} — ${fac.name}`}
                    loading="lazy"
                  />
                )}
                <div class="program-card__body">
                  <span class="card__sub">{fac.programs.length} {fac.programs.length === 1 ? 'программа' : 'программ'}</span>
                  <h3 class="card__title">{fac.name}</h3>
                  {fac.minTuition > 0 && (
                    <p class="card__text">
                      от <strong>{fac.minTuition.toLocaleString('ru-RU')}</strong>
                      {fac.maxTuition > fac.minTuition && <> · до {fac.maxTuition.toLocaleString('ru-RU')}</>}
                      {' '}{u.tuition.currency}/год
                    </p>
                  )}
                  <button
                    class="program-card__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="program-card__toggle-label">Подробнее</span>
                    <span class="program-card__toggle-icon" aria-hidden="true"></span>
                  </button>
                </div>
                <div class="program-card__details" id={panelId} role="region" aria-hidden="true">
                  <div class="program-card__details-inner">
                    {fac.programs.slice(0, 8).map((p) => (
                      <p class="card__text">
                        <strong>{levelLabel(p.level, p.programType)}:</strong> {p.title}
                        {p.tuition !== undefined && p.tuition > 0 && (
                          <> — <strong>{p.tuition.toLocaleString('ru-RU')}</strong> {u.tuition.currency}/год</>
                        )}
                      </p>
                    ))}
                    {fac.programs.length > 8 && (
                      <button
                        class="programs-modal__open btn btn--ghost btn--sm"
                        type="button"
                        data-modal-target={`programs-modal-${idx}`}
                      >
                        Подробнее · ещё {fac.programs.length - 8} {fac.programs.length - 8 === 1 ? 'программа' : 'программ'}
                      </button>
                    )}
                    <a class="btn btn--primary" href="#cta">Узнать о поступлении</a>
                  </div>
                </div>
                {fac.programs.length > 8 && (
                  <dialog class="programs-modal" id={`programs-modal-${idx}`} aria-labelledby={`programs-modal-title-${idx}`}>
                    <div class="programs-modal__inner">
                      <header class="programs-modal__head">
                        <div>
                          <p class="programs-modal__eyebrow">{u.name}</p>
                          <h3 class="programs-modal__title" id={`programs-modal-title-${idx}`}>{fac.name}</h3>
                          <p class="programs-modal__sub">{fac.programs.length} {fac.programs.length === 1 ? 'программа' : 'программ'} · все направления факультета</p>
                        </div>
                        <button class="programs-modal__close" type="button" aria-label="Закрыть">
                          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" />
                          </svg>
                        </button>
                      </header>
                      <ul class="programs-modal__list">
                        {fac.programs.map((p) => (
                          <li class="programs-modal__row">
                            <span class={`programs-modal__level programs-modal__level--${p.level}`}>
                              {levelLabel(p.level, p.programType)}
                            </span>
                            <span class="programs-modal__title-cell">{p.title}</span>
                            {p.tuition !== undefined && p.tuition > 0 && (
                              <span class="programs-modal__price">
                                {p.tuition.toLocaleString('ru-RU')} {u.tuition.currency}/год
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                      <a class="btn btn--primary programs-modal__cta" href="#cta">Узнать о поступлении</a>
                    </div>
                  </dialog>
                )}
              </article>
            );
          })}
        </div>

        <div class="cta-inline">
          <h2 class="cta__title">{STUDYROOM_FORM.inlineTitle}</h2>
          <p class="cta__text">{STUDYROOM_FORM.inlineText}</p>
          <div class="cta__form-slot"></div>
        </div>
      </div>
    </section>

    <!-- 5. Dates -->
    <section id="dates" class="section dates">
      <div class="dates__bg" aria-hidden="true"></div>
      <div class="container">
        <h2 class="dates__title">Даты приёма заявок</h2>
        <div class="dates__timeline">
          <span class="dates__line" aria-hidden="true"></span>
          <ol class="dates__items">
            {STUDYROOM_DATES_TIMELINE.map((d) => (
              <li class="dates__item">
                <span class="dates__item-dot" aria-hidden="true"></span>
                <div class="dates__item-title">{d.title}</div>
                <p class="dates__item-text">{d.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <p class="dates__note">
          <span class="tbd">[TBD: точные дедлайны для {u.name} — сверить с {u.sourceUrl} перед запуском.]</span>
        </p>
        <div class="dates__cta-row">
          <a class="btn btn--primary" href="#cta">Запросить актуальные даты</a>
        </div>
      </div>
    </section>

    <!-- 6. Activities -->
    <section id="activities" class="section section--soft activities">
      <div class="container">
        <div class="section__head">
          <h2>Что мы делаем</h2>
        </div>
        <div class="activities__grid">
          {STUDYROOM_ACTIVITIES.map((a) => (
            <article class="card">
              <h3 class="card__title">{a.title}</h3>
              <p class="card__text">{a.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Requirements + Scholarships (2-column) -->
    <section id="requirements" class="section requirements">
      <div class="container">
        <div class="requirements__row">
          <div class="requirements__col">
            <h2 class="requirements__title">Требования к поступающим</h2>
            <ul class="requirements__list">
              {u.requirements.language?.ielts !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">IELTS:</strong>
                  <span class="requirements__text"> от {u.requirements.language.ielts}</span>
                </li>
              )}
              {u.requirements.language?.toefl !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">TOEFL iBT:</strong>
                  <span class="requirements__text"> от {u.requirements.language.toefl}</span>
                </li>
              )}
              {u.requirements.language?.duolingo !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">Duolingo:</strong>
                  <span class="requirements__text"> от {u.requirements.language.duolingo}</span>
                </li>
              )}
              {u.requirements.gpa !== undefined && (
                <li class="requirements__item">
                  <strong class="requirements__label">GPA:</strong>
                  <span class="requirements__text"> от {u.requirements.gpa} / 4.0</span>
                </li>
              )}
              {u.requirements.exams.length > 0 && (
                <li class="requirements__item">
                  <strong class="requirements__label">Экзамены:</strong>
                  <span class="requirements__text"> {u.requirements.exams.join(', ')}</span>
                </li>
              )}
              <li class="requirements__item requirements__item--note">
                <span class="requirements__text">
