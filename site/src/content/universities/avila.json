  "accommodation": [
    {
      "name": "Carondelet Hall",
      "price": "от $750/мес",
      "text": "Традиционное общежитие Avila для первокурсников и студентов младших курсов. Названо в честь Сестёр Святого Иосифа из Карондле — основательниц университета. Двух- и трёхместные комнаты, общие зоны, прачечная, Wi-Fi, столовая в шаговой доступности.",
      "img": "/photos/avila/accommodation-carondelet.jpg"
    },
    {
      "name": "Thompson Hall",
      "price": "от $800/мес",
      "text": "Современное общежитие для студентов старших курсов. Suite-style комнаты с общими санузлами, общие гостиные, учебные зоны и помещения для отдыха. Близко к учебным корпусам и спортивным объектам кампуса.",
      "img": "/photos/avila/accommodation-thompson.jpg"
    },
    {
      "name": "Buchanan Hall (бывший Ridgway Hall)",
      "price": "от $850/мес",
      "text": "Историческое общежитие, переименованное в 2024 году в честь выпускницы и мецената Jean Buchanan. Прошло масштабную реконструкцию с расширением жилого фонда более чем на 40 мест. Здесь же расположена Buchanan Initiative for Peace and Nonviolence. Традиционные комнаты, общие санузлы, meal plan включён.",
      "img": "/photos/avila/accommodation-ridgway.jpg"
    }
  ],
  "campuses": [
    {
      "title": "Main Campus — 11901 Wornall Road",
      "sub": "Канзас-Сити, Миссури",
      "text": "Главный кампус Avila University расположен на 50 акрах в южной части Канзас-Сити (Миссури), штат-квартал Brookside/Waldo. Историческое ядро — Blasco Hall, Marian Centre, O'Rielly Hall и Whitfield Center. Современная библиотека Hooley-Bundschu Library, спортивный комплекс Mabee Fieldhouse и часовня Sisters of St. Joseph.",
      "img": "/photos/avila/campus-main.jpg"
    },
    {
      "title": "Downtown Kansas City Extension",
      "sub": "Дополнительная локация",
      "text": "Avila поддерживает программы повышения квалификации и партнёрские образовательные инициативы в центре Канзас-Сити. Эта локация используется для корпоративных тренингов, MBA-сессий выходного дня и встреч с городскими работодателями. На фото — панорама делового центра Канзас-Сити.",
      "img": "/photos/avila/campus-downtown.jpg"
    },
    {
      "title": "Goppert Performing Arts Center",
      "sub": "Театр и музыка на кампусе",
      "text": "Центр исполнительских искусств Goppert на главном кампусе — основная сцена для театральных и музыкальных программ Avila. Включает главный театральный зал, студийную сцену, репетиционные пространства и учебные аудитории для актёрского мастерства.",
      "img": "/photos/avila/campus-goppert.jpg"
    },
    {
      "title": "Mabee Fieldhouse & Athletic Complex",
      "sub": "Спортивная инфраструктура",
      "text": "Спортивный комплекс Avila Eagles — игровые залы для баскетбола и волейбола, тренажёрный зал, фитнес-пространства. Avila выступает в NAIA в составе American Midwest Conference (AMC). Бейсбольный и софтбольный стадионы, поле для футбола (soccer) на территории кампуса.",
      "img": "/photos/avila/campus-mabee.jpg"
