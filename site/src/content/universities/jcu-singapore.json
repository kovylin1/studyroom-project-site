  "campuses": [
    {
      "title": "Sims Drive Campus",
      "sub": "149 Sims Drive, Singapore",
      "text": "Единственный кампус JCU Singapore в районе Kallang/Geylang — на территории бывшей Manjusri Secondary School. Учебные корпуса, библиотека, psychology clinic, спортивные залы."
    }
