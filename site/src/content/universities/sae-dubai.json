  "campuses": [
    {
      "title": "SAE Dubai — Knowledge Park Campus",
      "sub": "Dubai Knowledge Park, Dubai, UAE",
      "text": "Кампус SAE Dubai в Dubai Knowledge Park — профессиональные audio-студии (SSL, Audient), film/animation/games-лаборатории, design-студии, лекционные залы. Project-based learning без экзаменов."
    }
