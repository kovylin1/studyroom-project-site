# Dependencies / build output
**/node_modules/
**/dist/
**/.astro/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs / scraper artefacts
*.log
**/logs/
scraper/run-*.json

# IDE / OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test / coverage
coverage/

# Local-only memory snapshots (session-specific, not part of the repo)
memory/

# Wrangler local cache (regenerated on every deploy)
.wrangler/

# Local backup snapshots (timestamped copies created before risky ops)
.backup/

# Visual-check screenshot output (regenerated on every QA pass, 10+ MB)
scraper/visual-check-out/

sources/edvoy-discovery/
sources/qs-discovery/
scraper/.tmp-*.json
sources/studygroup-discovery/

# Build artefact: regenerated by CI scrapers, never hand-edited
site/public/api/status.json

# ТІЛ translation secret (never commit)
scraper/.env.kk
.env.kk
backups/
# catalog-work заведён в git по решению владельца 2026-07-24: это рабочая копия
# каталога КОМПАСа (сессии 4.5+), и вся правка карточек живёт только в ней до
# подмены живого каталога в сессии 5. Без версионности эта работа терялась при
# любой переустановке машины.
sources/kompas/*.log

# Разведочные дампы порталов под логином: снимки интерфейса содержат логин
# владельца в открытом виде, а репозиторий публичный. Держим только локально.
# Сами собранные данные (extracts/, records/) логина не содержат — они в git.
sources/kompas/portal-probe/
sources/kompas/portal-probe.log
sources/kompas/qs-recon/

# Кандидаты ОРЛА на замену фото: промежуточный результат поиска, ~1.9 МБ на файл
# (1125 штук = 2.1 ГБ). В git едут только ПРИМЕНЁННЫЕ фото — после разбора
# кандидатов orel-apply кладёт победителей в каталог обычными именами, остальных
# убирает prune-orphan-photos. Сам список кандидатов (sources/photo-candidates.json)
# в git есть, картинки к нему — локальные. Решение владельца 2026-08-02.
site/public/photos/*/hunt-*.jpg

# Страница просмотра кандидатов ОРЛА: пересобирается `node scraper/orel-preview.mjs`
# и ссылается на локальные hunt-*.jpg, то есть в публичном деплое была бы страницей
# из битых картинок. (bobr-preview.html в git есть — его кандидаты уже применены.)
site/public/orel-preview.html

# Стейл-снимок каталога перед правкой факультетов (июнь 2026). На него никто не
# ссылается; лежит локально до решения, нужен ли он вообще.
sources/_faculty_backup_*/
